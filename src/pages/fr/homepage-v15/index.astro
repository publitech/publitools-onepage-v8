---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import HomepageV15 from '../../../components/homepage-v15/HomepageV15.astro';

const homepageEntry = await getEntry('homepage', 'fr-v15');
if (!homepageEntry) throw new Error('Homepage FR V15 content entry not found: src/content/homepage/fr-v15.json');
const content = homepageEntry.data as any;
---

<Layout title={content.seo.title} description={content.seo.description} canonical={content.seo.canonical}>
  <SiteHeader />
  <HomepageV15 content={content} />
</Layout>
