---
import Layout from '../../../layouts/Layout.astro';
import { buildBilingualAlternates } from '../../../lib/seo';
const title = 'À propos — PubliTools';
const description = 'Découvrez la mission de PubliTools: aider les entreprises du BTP à mieux gérer leur marketing terrain avec l’IA.';
---
<Layout title={title} description={description} canonical="https://publitools.ai/fr/a-propos" alternates={buildBilingualAlternates('/fr/a-propos/', '/en/about/')}>
  <main class="container section-pad">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f4862d]">Entreprise</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.03em] text-[#262832]">À propos de PubliTools</h1>
    <p class="mt-6 max-w-3xl text-lg text-[#5b6170]">PubliTools aide les entreprises du bâtiment à gagner du temps sur leur marketing. Le but: montrer leurs chantiers, rassurer leurs prospects et faire venir plus de devis, sans complexifier leur quotidien.</p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Notre mission</h2><p class="mt-3 text-[#5b6170]">Rendre le marketing simple, utile et concret pour les artisans et entreprises de construction.</p></article>
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Notre vision</h2><p class="mt-3 text-[#5b6170]">Construire un vrai AI CMO spécialisé BTP, pensé pour le terrain et pas pour les marketeurs.</p></article>
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Notre approche</h2><p class="mt-3 text-[#5b6170]">Peu de blabla, peu de clics, beaucoup d’impact. Chaque fonction doit faire gagner du temps et aider à vendre.</p></article>
    </div>
  </main>
</Layout>
