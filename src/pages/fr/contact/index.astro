---
import Layout from '../../../layouts/Layout.astro';
const title = 'Contact — PubliTools';
const description = 'Contactez PubliTools ou demandez une démo.';
---
<Layout title={title} description={description} canonical="https://publitools.ai/fr/contact">
  <main class="container section-pad">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f4862d]">Contact</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.03em] text-[#262832]">Contactez PubliTools</h1>
    <p class="mt-6 max-w-3xl text-lg text-[#5b6170]">Pour une question, une demande de démo ou un échange sur votre activité, vous pouvez passer par notre agenda ou votre espace d’inscription.</p>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Demander une démo</h2><p class="mt-3 text-[#5b6170]">Voyez comment PubliTools peut s’intégrer dans votre quotidien chantier.</p><a class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-[#f4862d] px-5 py-3 text-white no-underline" href="https://calendar.app.google/UXowPrhmMETsbE5B6">Prendre rendez-vous</a></article>
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Essayer l’outil</h2><p class="mt-3 text-[#5b6170]">Créez votre compte et découvrez l’outil en conditions réelles.</p><a class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg border border-[#262832] px-5 py-3 text-[#262832] no-underline" href="https://app.publichantier.fr/?signup=yes">Essayer PubliTools 14 jours</a></article>
    </div>
  </main>
</Layout>
