---
import Layout from '../../../layouts/Layout.astro';
import { copyHomepageVariants, copyVariantOrder } from '../../../content/homepage-copy-variants';

const variants = copyVariantOrder.map((slug) => copyHomepageVariants[slug]);
---

<Layout title="3 variantes homepage copywriting | PubliTools" description="Trois structures de page d’accueil PubliTools France, orientées copywriting avant design." canonical="https://publitools.ai/fr/homepage-copy-variants/">
  <main class="index-page">
    <section class="intro">
      <p class="eyebrow">PubliTools — exploration copywriting</p>
      <h1>3 directions de homepage à comparer</h1>
      <p>Design volontairement léger. Le but ici est de juger la structure, le H1, la subheadline, l’ordre des arguments et la clarté pour un artisan du bâtiment.</p>
    </section>
    <section class="cards">
      {variants.map((variant) => (
        <a class="card" href={`/fr/homepage-copy-variants/${variant.slug}/index.html`}>
          <p>{variant.label}</p>
          <h2>{variant.h1}</h2>
          <span>{variant.angle}</span>
        </a>
      ))}
    </section>
  </main>
</Layout>

<style>
  :global(body) { background: #f6f7f8; color: #101820; }
  .index-page { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 72px 0; }
  .intro { border-radius: 32px; background: #101820; color: white; padding: clamp(32px, 6vw, 64px); }
  .eyebrow { margin: 0 0 12px; color: #ffb066; font-size: 12px; font-weight: 950; letter-spacing: .16em; text-transform: uppercase; }
  h1 { max-width: 760px; margin: 0; font-size: clamp(44px, 7vw, 82px); line-height: .95; letter-spacing: -.06em; }
  .intro p:last-child { max-width: 740px; margin: 22px 0 0; color: rgba(255,255,255,.76); font-size: 20px; line-height: 1.55; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 24px; }
  .card { min-height: 300px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid #e5e7eb; border-radius: 28px; background: white; padding: 26px; text-decoration: none; box-shadow: 0 20px 50px rgba(16,24,32,.06); }
  .card p { margin: 0; color: #ff7a1a; font-size: 12px; font-weight: 950; letter-spacing: .14em; text-transform: uppercase; }
  .card h2 { margin: 18px 0; color: #101820; font-size: 34px; line-height: 1; letter-spacing: -.045em; }
  .card span { color: #64748b; line-height: 1.55; }
  @media (max-width: 860px) { .cards { grid-template-columns: 1fr; } }
</style>
