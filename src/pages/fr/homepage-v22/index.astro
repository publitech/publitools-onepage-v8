---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import HomepageV22 from '../../../components/homepage-v22/HomepageV22.astro';

const homepageEntry = await getEntry('homepage', 'fr-v22');
if (!homepageEntry) throw new Error('Homepage FR V22 content entry not found: src/content/homepage/fr-v22.json');
const content = homepageEntry.data as any;
---

<Layout title={content.seo.title} description={content.seo.description} canonical="https://publitools.ai/fr/homepage-v22/">
  <SiteHeader />
  <HomepageV22 content={content} />
</Layout>
