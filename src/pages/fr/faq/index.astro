---
import V31PageShell from '../../../components/site-v31/V31PageShell.astro';
import V31HeroInternal from '../../../components/site-v31/V31HeroInternal.astro';
import V31Section from '../../../components/site-v31/V31Section.astro';
import V31CardGrid from '../../../components/site-v31/V31CardGrid.astro';
import V31FaqAccordion from '../../../components/site-v31/V31FaqAccordion.astro';
import V31FinalCta from '../../../components/v31/V31FinalCta.astro';

const title = 'FAQ PubliTools — fonctionnement, réseaux, avis, Google Business et tarifs';
const description = 'Questions fréquentes sur PubliTools : fonctionnement, réseaux sociaux, avis Google, IA, tarifs, essai 14 jours et limites produit.';
const signupHref = 'https://app.publichantier.fr/?signup=yes';

const groups = [
  {
    title: 'Fonctionnement général',
    items: [
      { question: 'PubliTools sert à quoi ?', answer: 'PubliTools aide les artisans et entreprises du bâtiment à faire leur publicité sur internet : réseaux sociaux, photos chantier, textes de publication, designs, avis clients et Google Business.' },
      { question: 'Comment fonctionne une publication ?', answer: 'Vous ajoutez une photo, une vidéo, un vocal ou un texte. PubliTools prépare la publication : texte, retouche, design si utile, adaptation aux réseaux. Vous relisez, vous modifiez si besoin, puis vous publiez ou programmez selon votre plan.' },
      { question: 'Est-ce que je dois savoir faire du marketing ?', answer: 'Non. PubliTools part de vos vrais contenus : photos chantier, explication orale, avis client, fiche Google Business. L’outil prépare la communication à partir de ça.' },
      { question: 'Est-ce que PubliTools remplace une agence ?', answer: 'PubliTools automatise une grande partie du travail de communication courant : publications, textes, retouches, designs, avis et Google Business. Il ne doit pas être présenté comme un remplacement total d’agence dans tous les cas.' },
      { question: 'Est-ce une application mobile ?', answer: 'PubliTools fonctionne en web app responsive, pensée pour une utilisation mobile. Une application mobile native est une roadmap, pas une promesse actuelle.' },
    ],
  },
  {
    title: 'Réseaux sociaux',
    items: [
      { question: 'Sur quels réseaux puis-je publier ?', answer: 'Les réseaux confirmés sont Facebook, Instagram, LinkedIn, Google Business, TikTok et YouTube.' },
      { question: 'Est-ce que d’autres réseaux sont disponibles ?', answer: 'Non. Les pages publiques doivent rester sur les 6 réseaux confirmés : Facebook, Instagram, LinkedIn, Google Business, TikTok et YouTube.' },
      { question: 'Puis-je publier sur tous les réseaux en même temps ?', answer: 'Cela dépend du plan. Starter limite à 3 réseaux par publication. Pro permet une sélection illimitée selon les réseaux connectés et les contraintes des plateformes.' },
      { question: 'PubliTools publie-t-il sans que je valide ?', answer: 'Non. PubliTools prépare le contenu. Vous pouvez le relire, le modifier et déclencher la publication ou la programmation.' },
      { question: 'Puis-je programmer mes publications ?', answer: 'Oui, avec le plan Pro.' },
      { question: 'Les vidéos sont-elles acceptées ?', answer: 'Oui, PubliTools peut accepter des vidéos et préparer leur publication. La retouche vidéo avancée et le montage automatique avancé ne doivent pas être promis.' },
    ],
  },
  {
    title: 'IA et validation',
    items: [
      { question: 'Puis-je créer une publication avec 1 photo et 1 vocal ?', answer: 'Oui. 1 photo chantier + 1 vocal peuvent suffire à préparer une publication prête à valider.' },
      { question: 'À quoi sert le vocal ?', answer: 'Le vocal sert à expliquer le chantier. PubliTools le transcrit, le réécrit et l’utilise pour préparer un texte clair.' },
      { question: 'Puis-je écrire au lieu de parler ?', answer: 'Oui. Vous pouvez ajouter un texte libre au lieu d’un vocal.' },
      { question: 'Que fait la retouche photo ?', answer: 'Elle peut améliorer la luminosité, le cadrage, le contraste et la lisibilité selon les capacités disponibles.' },
      { question: 'PubliTools peut-il supprimer des objets sur une photo ?', answer: 'Non. La suppression d’objets n’est pas une capacité actuelle validée.' },
      { question: 'PubliTools publie-t-il sans validation ?', answer: 'Non. PubliTools prépare le contenu. Vous pouvez relire, modifier, puis déclencher la publication ou la programmation.' },
      { question: 'Est-ce que l’IA invente des chantiers ?', answer: 'Non. PubliTools part de vos contenus réels. Il ne doit pas inventer un chantier, un avis ou un résultat.' },
    ],
  },
  {
    title: 'Avis clients',
    items: [
      { question: 'Comment PubliTools aide à obtenir des avis ?', answer: 'PubliTools prépare un SMS avec votre lien Google Business. L’app SMS du téléphone s’ouvre, puis vous envoyez le message au client.' },
      { question: 'PubliTools envoie-t-il les SMS automatiquement ?', answer: 'Non. PubliTools ouvre l’app SMS avec un message prérédigé. L’utilisateur envoie lui-même.' },
      { question: 'Les demandes d’avis SMS sont-elles limitées ?', answer: 'Non. Elles sont illimitées sur Starter et Pro.' },
      { question: 'PubliTools garantit-il la note des avis ?', answer: 'Non. PubliTools simplifie la demande d’avis, mais ne garantit ni le nombre d’avis, ni la note.' },
      { question: 'Puis-je transformer un avis en publication ?', answer: 'Oui avec Pro. La transformation d’un avis Google en design ou publication prête à publier est incluse dans Pro.' },
      { question: 'PubliTools répond-il aux avis à votre place ?', answer: 'Non. Cette gestion n’est pas une capacité actuelle à promettre.' }
    ],
  },
  {
    title: 'Google Business',
    items: [
      { question: 'Que fait PubliTools avec Google Business ?', answer: 'PubliTools peut publier des posts, ajouter des photos, générer des demandes d’avis par SMS et réutiliser des avis Google en contenu.' },
      { question: 'PubliTools gère-t-il toute ma fiche Google Business ?', answer: 'Non. PubliTools ne remplace pas aujourd’hui un outil complet de gestion Google Business.' },
      { question: 'PubliTools garantit-il une meilleure position Google ?', answer: 'Non. PubliTools ne garantit aucun classement Google. Il aide à rendre votre activité, vos photos et vos avis mieux mis en valeur.' },
      { question: 'Puis-je créer des posts Google Business avec mes photos chantier ?', answer: 'Oui. PubliTools peut préparer des posts Google Business à partir de vos contenus chantier.' },
      { question: 'Puis-je demander des avis Google depuis PubliTools ?', answer: 'Oui. PubliTools prépare un SMS avec le lien Google Business.' },
    ],
  },
  {
    title: 'Tarifs et essai',
    items: [
      { question: 'Combien coûte PubliTools ?', answer: 'Starter coûte 19,90 € HT/mois. Pro coûte 39,90 € HT/mois.' },
      { question: 'Combien dure l’essai ?', answer: '14 jours.' },
      { question: 'Que contient l’essai ?', answer: 'L’essai donne accès au plan Pro complet pendant 14 jours.' },
      { question: 'Que se passe-t-il après l’essai ?', answer: 'À la fin des 14 jours, l’abonnement bascule sur le plan choisi au moment du paywall : Starter ou Pro.' },
      { question: 'Starter inclut combien de publications ?', answer: 'Starter inclut 8 publications par mois.' },
      { question: 'Pro inclut combien de publications ?', answer: 'Pro inclut des publications illimitées.' },
      { question: 'Les prix sont-ils TTC ?', answer: 'Non. Les prix affichés sont HT.' },
    ],
  },
  {
    title: 'Résultats et limites',
    items: [
      { question: 'PubliTools garantit-il des devis ?', answer: 'Non. PubliTools ne garantit pas de devis. Il aide à publier plus régulièrement, à montrer vos chantiers, à demander des avis et à tenir une présence en ligne plus sérieuse.' },
      { question: 'PubliTools peut-il aider à recevoir plus de demandes ?', answer: 'PubliTools peut aider indirectement : présence régulière, chantiers visibles, fiche Google Business alimentée, avis plus faciles à demander, preuves sociales plus claires. Ces éléments peuvent rassurer un prospect, mais aucun résultat individuel n’est garanti.' },
      { question: 'Quels résultats ont été observés ?', answer: 'Sur plus de 50 artisans après 3 mois d’utilisation, PubliTools a observé jusqu’à +40 % de demandes de devis, jusqu’à +600 % de vues sur les posts chantier, +12 places gagnées en moyenne sur Google et jusqu’à +35 % d’avis Google collectés. Les résultats varient selon l’activité, la zone, la régularité et la présence existante.' },
      { question: 'Est-ce que PubliTools remplace mon site internet ?', answer: 'Non. PubliTools ne crée pas de site internet aujourd’hui. Il aide à alimenter vos réseaux sociaux, avis clients et Google Business.' },
      { question: 'Est-ce que PubliTools fait mes devis, factures ou planning chantier ?', answer: 'Non. PubliTools n’est pas un CRM chantier et ne gère pas les devis, factures ou plannings.' },
    ],
  },
];

const categoryCards = groups.map((group) => ({
  title: group.title,
  text: `${group.items.length} réponses directes sur ce sujet.`,
  href: `#${group.title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-')}`,
  cta: 'Aller à la catégorie',
}));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: groups.flatMap((group) => group.items).map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<V31PageShell title={title} description={description} canonical="https://publitools.ai/fr/faq/" schema={schema}>
  <V31HeroInternal
    eyebrow="FAQ PubliTools"
    title="Questions fréquentes sur PubliTools"
    lead="Fonctionnement, réseaux sociaux, avis Google, tarifs, IA, résultats : les réponses utiles avant de tester PubliTools avec vos propres chantiers."
    ctas={[{ label: 'Essayer PubliTools 14 jours', href: signupHref }, { label: 'Voir les tarifs', href: '/fr/tarif/', variant: 'secondary' }]}
    visualSrc="/assets/site-v31/ui-screens/btp-renov-ui-sms-review-request.webp"
    visualAlt="Écran PubliTools BTP Renov de demande d’avis par SMS"
    visualLabel="Demande d’avis SMS préparée"
    stats={[{ value: '6', label: 'réseaux confirmés' }, { value: '14 j', label: 'd’essai Pro complet' }, { value: 'HT', label: 'prix affichés' }]}
  />

  <V31Section
    tone="soft"
    eyebrow="Navigation"
    title="Allez directement à l’objection qui vous bloque"
    lead="Chaque réponse reste courte, factuelle et centrée sur ce que PubliTools fait réellement aujourd’hui."
  >
    <V31CardGrid cards={categoryCards} columns={4} />
  </V31Section>

  <V31Section eyebrow="Réponses" title="Tout ce qu’il faut vérifier avant de tester PubliTools">
    <V31FaqAccordion groups={groups} />
  </V31Section>

  <V31FinalCta
    eyebrow="Essai 14 jours"
    title="Le mieux, c’est de tester avec vos propres chantiers"
    lead="Vous verrez vite si PubliTools colle à votre rythme, vos photos, vos réseaux et vos avis."
    ctas={[{ label: 'Essayer PubliTools 14 jours', href: signupHref }, { label: 'Comparer les plans', href: '/fr/tarif/', variant: 'secondary' }]}
  />
</V31PageShell>
