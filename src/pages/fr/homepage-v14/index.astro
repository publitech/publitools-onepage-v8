---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import HomepageV14 from '../../../components/homepage-v14/HomepageV14.astro';

const homepageEntry = await getEntry('homepage', 'fr-v14');
if (!homepageEntry) throw new Error('Homepage FR V14 content entry not found: src/content/homepage/fr-v14.json');
const content = homepageEntry.data as any;
---

<Layout title={content.seo.title} description={content.seo.description} canonical={content.seo.canonical}>
  <SiteHeader />
  <HomepageV14 content={content} />
</Layout>
