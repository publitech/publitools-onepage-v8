---
import Layout from '../../../layouts/Layout.astro';
import PreviewBadge from '../../../components/homepage-variants/PreviewBadge.astro';
import { homepageVariants } from '../../../content/homepage-variants';
import type { VariantSlug } from '../../../content/homepage-variants';

const title = 'Homepages PubliTools — index comparatif interne';
const description = 'Index comparatif noindex,nofollow des cinq variantes homepage PubliTools.';

type QaStatus = {
  build: 'OK' | 'À vérifier';
  responsive: 'OK' | 'À vérifier';
  claims: 'OK' | 'À surveiller';
  perf: 'OK' | 'À mesurer';
};

const comparisonMeta: Record<VariantSlug, { angle: string; assetStage: 'final' | 'brouillon' | 'manquant'; qa: QaStatus; riskNote: string }> = {
  'variant-a': {
    angle: 'Catégorie : IA pour faire sa publicité Internet dans le bâtiment.',
    assetStage: 'brouillon',
    qa: { build: 'OK', responsive: 'À vérifier', claims: 'OK', perf: 'À mesurer' },
    riskNote: 'Ne pas laisser la démo photo/vocal réduire la catégorie vendue.',
  },
  'variant-b': {
    angle: 'Preuves terrain : transformer chantiers, avis et avant/après réels en publications.',
    assetStage: 'brouillon',
    qa: { build: 'OK', responsive: 'À vérifier', claims: 'OK', perf: 'À mesurer' },
    riskNote: 'Éviter de promettre qu’une photo brute devient automatiquement une preuve parfaite.',
  },
  'variant-c': {
    angle: 'Régularité : rester visible sans bloquer les soirées du dirigeant.',
    assetStage: 'brouillon',
    qa: { build: 'OK', responsive: 'À vérifier', claims: 'À surveiller', perf: 'À mesurer' },
    riskNote: 'Maintenir le garde-fou : pas de zéro effort, pas de calendrier autonome, claim temps non généralisé.',
  },
  'variant-d': {
    angle: 'Réputation locale : prolonger le bouche-à-oreille avec des preuves vérifiables.',
    assetStage: 'brouillon',
    qa: { build: 'OK', responsive: 'À vérifier', claims: 'OK', perf: 'À mesurer' },
    riskNote: 'Ne pas glisser vers promesse de devis, d’avis 5 étoiles ou de meilleur classement Google.',
  },
  'variant-e': {
    angle: 'Image maîtrisée : voie simple entre bricolage, agence et absence de communication.',
    assetStage: 'brouillon',
    qa: { build: 'OK', responsive: 'À vérifier', claims: 'OK', perf: 'À mesurer' },
    riskNote: 'Ne pas vendre une charte graphique ou une agence automatique ; logo/couleurs seulement si fournis.',
  },
};

const statusTone = {
  final: 'border-emerald-200 bg-emerald-50 text-emerald-800',
  brouillon: 'border-amber-200 bg-amber-50 text-amber-800',
  manquant: 'border-red-200 bg-red-50 text-red-800',
};

const qaTone = (value: string) => value === 'OK'
  ? 'border-emerald-200 bg-emerald-50 text-emerald-800'
  : 'border-slate-200 bg-slate-50 text-slate-700';
---

<Layout title={title} description={description} canonical="https://publitools.ai/fr/homepage-variants/">
  <main class="bg-[#f4f6f8] text-[#101820]">
    <section class="relative overflow-hidden bg-[#0b1f3a] py-16 text-white md:py-24">
      <div class="absolute inset-0 opacity-25" aria-hidden="true">
        <div class="absolute -right-24 top-12 h-72 w-72 rounded-full bg-[#ff7a1a] blur-[120px]"></div>
        <div class="absolute bottom-0 left-1/4 h-56 w-56 rounded-full bg-[#1f6feb] blur-[110px]"></div>
      </div>
      <div class="container relative space-y-7">
        <PreviewBadge label="Index comparatif" />
        <div class="max-w-4xl space-y-5">
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-[#ffb066]">Review interne — Wave 3</p>
          <h1 class="text-4xl font-black tracking-[-0.05em] md:text-6xl">Comparer les 5 hypothèses homepage PubliTools</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/75">
            Page noindex,nofollow pour arbitrage Le Sage : chaque variante reste une hypothèse de conversion distincte, avec assets de preview, QA visible et risques explicités avant validation finale.
          </p>
        </div>
        <div class="grid gap-3 text-sm text-white/75 sm:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-white/10 p-4"><strong class="block text-white">5 routes preview</strong>/fr/homepage-variants/variant-a à variant-e</div>
          <div class="rounded-2xl border border-white/10 bg-white/10 p-4"><strong class="block text-white">Pricing masqué</strong>Comparaison d’angles homepage uniquement</div>
          <div class="rounded-2xl border border-white/10 bg-white/10 p-4"><strong class="block text-white">Robots</strong>Meta noindex,nofollow via Layout</div>
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container space-y-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-sm font-black uppercase tracking-[0.18em] text-[#1f6feb]">Tableau comparatif</p>
            <h2 class="mt-2 text-3xl font-black tracking-[-0.04em] text-[#0b1f3a] md:text-4xl">Nom, intention, angle, QA et risque</h2>
          </div>
          <p class="max-w-xl text-sm leading-6 text-[#5b6170]">
            Statuts honnêtes pour preview : le build est vérifié sur la branche collective ; responsive/performance restent à confirmer en QA finale multi-breakpoints.
          </p>
        </div>

        <div class="hidden overflow-hidden rounded-[2rem] border border-[#e1e5ea] bg-white shadow-soft md:block">
          <div class="overflow-x-auto">
            <table class="min-w-[1180px] border-collapse text-left text-sm">
              <caption class="sr-only">Comparatif interne des cinq variantes homepage PubliTools</caption>
              <thead class="bg-[#0b1f3a] text-white">
                <tr>
                  <th class="px-5 py-4 font-black">Nom</th>
                  <th class="px-5 py-4 font-black">Intention stratégique</th>
                  <th class="px-5 py-4 font-black">Angle principal</th>
                  <th class="px-5 py-4 font-black">Assets</th>
                  <th class="px-5 py-4 font-black">QA</th>
                  <th class="px-5 py-4 font-black">Notes risque</th>
                  <th class="px-5 py-4 font-black">Preview</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#edf0f3]">
                {homepageVariants.map((variant) => {
                  const meta = comparisonMeta[variant.slug];
                  return (
                    <tr class="align-top hover:bg-[#f8fafc]">
                      <th scope="row" class="w-[190px] px-5 py-5">
                        <span class="block text-base font-black tracking-[-0.02em] text-[#0b1f3a]">{variant.label}</span>
                        <span class="mt-2 inline-flex rounded-full border border-[#dbe3ed] bg-[#f4f6f8] px-3 py-1 text-xs font-black uppercase tracking-[0.12em] text-[#5b6170]">{variant.slug}</span>
                      </th>
                      <td class="w-[250px] px-5 py-5 leading-6 text-[#3c4554]">{variant.strategicIntent}</td>
                      <td class="w-[220px] px-5 py-5 leading-6 text-[#3c4554]">{meta.angle}</td>
                      <td class="w-[190px] px-5 py-5">
                        <span class={`inline-flex rounded-full border px-3 py-1 text-xs font-black uppercase tracking-[0.12em] ${statusTone[meta.assetStage]}`}>{meta.assetStage}</span>
                        <p class="mt-3 leading-6 text-[#5b6170]">{variant.assetStatus}</p>
                      </td>
                      <td class="w-[210px] px-5 py-5">
                        <div class="grid gap-2">
                          {Object.entries(meta.qa).map(([label, value]) => (
                            <span class={`inline-flex justify-between gap-3 rounded-full border px-3 py-1 text-xs font-bold ${qaTone(value)}`}>
                              <span class="capitalize">{label}</span>
                              <span>{value}</span>
                            </span>
                          ))}
                        </div>
                      </td>
                      <td class="w-[240px] px-5 py-5 leading-6 text-[#5b6170]">{meta.riskNote}</td>
                      <td class="w-[150px] px-5 py-5">
                        <a class="inline-flex rounded-full bg-[#ff7a1a] px-4 py-3 text-sm font-extrabold text-white transition hover:bg-[#e7650a] focus:outline-none focus:ring-4 focus:ring-[#ff7a1a]/25" href={variant.route}>
                          Ouvrir
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          {homepageVariants.map((variant) => {
            const meta = comparisonMeta[variant.slug];
            return (
              <article class="rounded-[1.5rem] border border-[#e1e5ea] bg-white p-5 shadow-soft md:hidden">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-[#0b1f3a] px-3 py-1 text-xs font-black uppercase tracking-[0.14em] text-white">{variant.slug}</span>
                  <span class={`rounded-full border px-3 py-1 text-xs font-black uppercase tracking-[0.12em] ${statusTone[meta.assetStage]}`}>{meta.assetStage}</span>
                </div>
                <h3 class="mt-4 text-xl font-black tracking-[-0.03em] text-[#0b1f3a]">{variant.label}</h3>
                <p class="mt-3 text-sm leading-6 text-[#5b6170]">{variant.strategicIntent}</p>
                <p class="mt-3 text-sm font-bold text-[#101820]">Angle : {meta.angle}</p>
                <p class="mt-3 text-sm leading-6 text-[#5b6170]">Risque : {meta.riskNote}</p>
                <a class="mt-5 inline-flex rounded-full bg-[#ff7a1a] px-4 py-3 text-sm font-extrabold text-white" href={variant.route}>Ouvrir la preview</a>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</Layout>
