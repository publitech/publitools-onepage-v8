---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import HomepageV17 from '../../../components/homepage-v17/HomepageV17.astro';

const homepageEntry = await getEntry('homepage', 'fr-v17');
if (!homepageEntry) throw new Error('Homepage FR V17 content entry not found: src/content/homepage/fr-v17.json');
const content = homepageEntry.data as any;
---

<Layout title={content.seo.title} description={content.seo.description} canonical={content.seo.canonical}>
  <SiteHeader />
  <HomepageV17 content={content} />
</Layout>
