---
// Page racine : redirection client instantanée basée sur la langue du navigateur.
// Sur Cloudflare Pages, la géolocalisation edge nécessiterait un Worker.
// Ce script est exécuté immédiatement, avant le rendu visuel, pour éviter le flash blanc.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>PubliTools</title>
    <link rel="canonical" href="https://publitools.ai/en/" />
    <style>
      html, body {
        margin: 0;
        height: 100%;
        background: #ffffff;
        /* Empêche tout flash visuel pendant la redirection */
        visibility: hidden;
      }
    </style>
    <script is:inline>
      (function () {
        var lang = (navigator.language || 'en').slice(0, 2).toLowerCase();
        var supported = ['fr', 'es', 'de'];
        var target = supported.indexOf(lang) !== -1 ? '/' + lang + '/' : '/en/';
        // Utilisation de replace pour ne pas polluer l'historique
        location.replace(target);
      })();
    </script>
  </head>
  <body></body>
</html>