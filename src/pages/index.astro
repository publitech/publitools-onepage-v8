---
// Page racine : redirection client instantanée basée sur la langue du navigateur.
// Sur Cloudflare Pages, la géolocalisation edge nécessiterait un Worker.
// Ce script est exécuté immédiatement, avant le rendu visuel, pour éviter le flash blanc.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <title>PubliTools</title>
        <link rel="canonical" href="https://publitools.ai/en/" />
        <!-- Favicons : identiques à Layout.astro (même version ?v=). Indispensable ici,
             sinon le navigateur retombe sur /favicon.ico (ancien favicon Astro en cache)
             le temps que la redirection vers /fr/ ou /en/ s'exécute. -->
        <link rel="icon" type="image/svg+xml" href="/logo-icon.svg?v=2" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-512.png?v=2" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-512.png?v=2" />
        <link rel="shortcut icon" href="/favicon.ico?v=2" />
        <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png?v=2" />
    
        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NQ4FGHCN');</script>
        <!-- End Google Tag Manager -->
    
        <!-- Meta Pixel Code -->
        <script>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '2074738250080029');
        fbq('track', 'PageView');
        </script>
        <noscript><img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=2074738250080029&ev=PageView&noscript=1"
        /></noscript>
        <!-- End Meta Pixel Code -->
    
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-GS0D3ZXSXM"></script>
        <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-GS0D3ZXSXM');
        </script>
        <style>
      html, body {
        margin: 0;
        height: 100%;
        background: #ffffff;
        /* Empêche tout flash visuel pendant la redirection */
        visibility: hidden;
      }
    </style>
    <script is:inline>
      (function () {
        var lang = (navigator.language || 'en').slice(0, 2).toLowerCase();
        var supported = ['fr', 'es', 'de'];
        var target = supported.indexOf(lang) !== -1 ? '/' + lang + '/' : '/en/';
        // Utilisation de replace pour ne pas polluer l'historique
        location.replace(target);
      })();
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NQ4FGHCN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
  </body>
</html>