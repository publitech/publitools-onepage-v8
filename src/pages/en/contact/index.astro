---
import Layout from '../../../layouts/Layout.astro';
const title = 'Contact — PubliTools';
const description = 'Contact PubliTools or book a demo.';
---
<Layout title={title} description={description} canonical="https://publitools.ai/en/contact" locale="en" pathname="/en/contact/">
  <main class="container section-pad">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f4862d]">Contact</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.03em] text-[#262832]">Contact PubliTools</h1>
    <p class="mt-6 max-w-3xl text-lg text-[#5b6170]">For any question, demo request or discussion about your business, you can use our calendar or sign up directly.</p>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Book a demo</h2><p class="mt-3 text-[#5b6170]">See how PubliTools can fit into your day-to-day jobsite routine.</p><a class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-[#f4862d] px-5 py-3 text-white no-underline" href="https://calendar.app.google/UXowPrhmMETsbE5B6">Book a meeting</a></article>
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Try the tool</h2><p class="mt-3 text-[#5b6170]">Create your account and see the tool in real conditions.</p><a class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg border border-[#262832] px-5 py-3 text-[#262832] no-underline" href="https://app.publitools.ai/en/signup">Try PubliTools free for 14 days</a></article>
    </div>
  </main>
</Layout>