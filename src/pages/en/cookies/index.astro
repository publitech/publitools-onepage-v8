---
import Layout from '../../../layouts/Layout.astro';
import { buildBilingualAlternates } from '../../../lib/seo';
const title = 'Cookies — Publitools';
const description = 'Cookies policy for the Publitools website.';
---
<Layout title={title} description={description} canonical="https://publitools.ai/en/cookies" locale="en" pathname="/en/cookies/" alternates={buildBilingualAlternates('/fr/cookies/', '/en/cookies/')}>
  <main class="container section-pad">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f4862d]">Cookies</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.03em] text-[#262832]">Cookies policy</h1>
    <div class="mt-10 grid gap-6 text-[#5b6170]">
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">1. Definition</h2><p class="mt-4">A cookie is a tracker or file that may be stored on the user's device when browsing the site, in order to provide certain technical features, measure audience or improve the user experience.</p></section>
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">2. Use</h2><p class="mt-4">Publitools may use cookies strictly necessary for the operation of the site, as well as other trackers subject to applicable rules and user choices when required.</p></section>
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">3. Settings</h2><p class="mt-4">The user can configure or limit the use of cookies through their browser settings or through management mechanisms that may be integrated into the site.</p></section>
    </div>
  </main>
</Layout>