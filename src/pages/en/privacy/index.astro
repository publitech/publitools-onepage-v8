---
import Layout from '../../../layouts/Layout.astro';
import { buildBilingualAlternates } from '../../../lib/seo';
const title = 'Privacy — Publitools';
const description = 'Privacy policy for Publitools and PubliTech OÜ.';
---
<Layout title={title} description={description} canonical="https://publitools.ai/en/privacy" locale="en" pathname="/en/privacy/" alternates={buildBilingualAlternates('/fr/confidentialite/', '/en/privacy/')}>
  <main class="container section-pad">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f4862d]">Data protection</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.03em] text-[#262832]">Privacy policy</h1>
    <div class="mt-10 grid gap-6 text-[#5b6170]">
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">1. Data controller</h2><p class="mt-4">Data collected through the Publitools site and service is processed by <strong class="text-[#262832]">PubliTech OÜ</strong>, VAT <strong class="text-[#262832]">EE102901191</strong>, registry code <strong class="text-[#262832]">17324362</strong>, headquartered at <strong class="text-[#262832]">Harju maakond, Tallinn, Kesklinna linnaosa, Tornimäe tn 5, 10145</strong>.</p></section>
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">2. Data concerned</h2><p class="mt-4">Identification, contact, browsing, login, service usage data and information necessary to operate the features and provide customer support may be collected.</p></section>
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">3. Purposes</h2><p class="mt-4">Data may be used to manage accounts, provide services, deliver features, respond to contact requests, improve the product, prevent abusive use and maintain the business relationship.</p></section>
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">4. Legal basis</h2><p class="mt-4">Processing is performed under the applicable legal bases, including performance of the contract, the publisher's legitimate interest, compliance with legal obligations or consent where required.</p></section>
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">5. Retention</h2><p class="mt-4">Data is retained for a period proportionate to the purposes pursued, contractual obligations, security requirements and applicable legal obligations.</p></section>
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">6. Recipients</h2><p class="mt-4">Data may be accessible to internal teams, technical providers and, where applicable, partners strictly required for the operation of the service, limited to what is needed for their mission.</p></section>
      <section class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">7. User rights</h2><p class="mt-4">Users may request information about their data, its rectification, deletion, restriction or exercise of any other right provided by applicable regulations, under the conditions set out therein.</p></section>
    </div>
  </main>
</Layout>