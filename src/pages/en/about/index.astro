---
import Layout from '../../../layouts/Layout.astro';
import { buildBilingualAlternates } from '../../../lib/seo';
const title = 'About — PubliTools';
const description = 'Discover PubliTools\' mission: helping construction businesses manage their field marketing with AI.';
---
<Layout title={title} description={description} canonical="https://publitools.ai/en/about" locale="en" pathname="/en/about/" alternates={buildBilingualAlternates('/fr/a-propos/', '/en/about/')}>
  <main class="container section-pad">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f4862d]">Company</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.03em] text-[#262832]">About PubliTools</h1>
    <p class="mt-6 max-w-3xl text-lg text-[#5b6170]">PubliTools helps construction businesses save time on their marketing. The goal: showcase their jobs, reassure prospects and bring in more quote requests, without complicating their day-to-day.</p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Our mission</h2><p class="mt-3 text-[#5b6170]">Make marketing simple, useful and concrete for contractors and construction companies.</p></article>
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Our vision</h2><p class="mt-3 text-[#5b6170]">Build a real AI CMO specialised in construction, designed for the field, not for marketers.</p></article>
      <article class="rounded-[16px] border border-[#e8e9ea] bg-white p-6 shadow-soft"><h2 class="text-2xl font-semibold text-[#262832]">Our approach</h2><p class="mt-3 text-[#5b6170]">Little talk, little clicks, big impact. Every feature should save time and help sell.</p></article>
    </div>
  </main>
</Layout>