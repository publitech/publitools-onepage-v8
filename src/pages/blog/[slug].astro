---
import { publishedPosts, postUrl } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = (await publishedPosts()).filter(post => post.data.locale === 'fr');
  return posts.map(post => ({ params: { slug: post.id }, props: { destination: postUrl(post) } }));
}

const { destination } = Astro.props;
return Astro.redirect(destination);
