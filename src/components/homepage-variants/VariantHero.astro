---
import PreviewBadge from './PreviewBadge.astro';
import type { VariantHero as VariantHeroData } from '../../content/homepage-variants';

interface Props {
  hero: VariantHeroData;
  label: string;
}

const { hero, label } = Astro.props;
const visual = hero.visual;
---

<section class="variant-hero relative overflow-hidden bg-[#0b1f3a] text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,122,26,0.24),transparent_36%),linear-gradient(135deg,#0b1f3a_0%,#101820_70%)]" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#101820]/40 to-transparent" aria-hidden="true"></div>
  <div class="container relative grid gap-10 py-14 md:py-20 lg:grid-cols-[0.86fr_1.14fr] lg:items-center lg:py-24">
    <div class="space-y-7">
      <PreviewBadge label={label} />
      <div class="space-y-5">
        <p class="text-sm font-bold uppercase tracking-[0.24em] text-[#ffb066]">{hero.eyebrow}</p>
        <h1 class="max-w-4xl text-4xl font-black leading-[0.98] tracking-[-0.055em] md:text-6xl">{hero.title}</h1>
        <p class="max-w-2xl text-lg leading-8 text-white/78">{hero.lead}</p>
        {hero.reassurance && (
          <p class="inline-flex rounded-full border border-white/14 bg-white/9 px-4 py-2 text-sm font-extrabold text-white/88">
            {hero.reassurance}
          </p>
        )}
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a class="inline-flex items-center justify-center rounded-full bg-[#ff7a1a] px-6 py-4 text-sm font-extrabold text-white shadow-[0_18px_40px_rgba(255,122,26,0.24)] transition hover:-translate-y-0.5 hover:bg-[#f06f12]" href={hero.primaryCta.href}>
          {hero.primaryCta.label}
        </a>
        {hero.secondaryCta && (
          <a class="inline-flex items-center justify-center rounded-full border border-white/20 px-6 py-4 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:border-white/45" href={hero.secondaryCta.href}>
            {hero.secondaryCta.label}
          </a>
        )}
      </div>
    </div>

    {visual ? (
      <div class="hero-demo rounded-[2rem] border border-white/12 bg-white/8 p-3 shadow-[0_30px_90px_rgba(0,0,0,0.28)] backdrop-blur md:p-5" aria-label={hero.visualNote}>
        <div class="grid gap-4 rounded-[1.55rem] bg-[#f4f6f8] p-4 text-[#101820] lg:grid-cols-[0.9fr_1.05fr_0.82fr] lg:p-5">
          <div class="photo-chantier overflow-hidden rounded-[1.15rem] bg-white shadow-soft">
            <picture>
              <source srcset={visual.chantier.webpSrc} type="image/webp" />
              <img src={visual.chantier.src} alt={visual.chantier.alt} class="h-56 w-full object-cover lg:h-full" loading="eager" decoding="async" />
            </picture>
            <div class="vocal-wave m-3 rounded-2xl border border-[#ff7a1a]/30 bg-white p-3 shadow-soft">
              <div class="mb-2 flex items-center gap-1" aria-hidden="true">
                <span class="h-3 w-1 rounded-full bg-[#ff7a1a]"></span>
                <span class="h-6 w-1 rounded-full bg-[#ff7a1a]"></span>
                <span class="h-4 w-1 rounded-full bg-[#ff7a1a]"></span>
                <span class="h-7 w-1 rounded-full bg-[#ff7a1a]"></span>
                <span class="h-3 w-1 rounded-full bg-[#ff7a1a]"></span>
              </div>
              <p class="text-xs font-bold leading-5 text-[#0b1f3a]">{visual.voiceNote}</p>
            </div>
          </div>

          <div class="fond-carte rounded-[1.15rem] border border-[#dfe3e8] bg-white p-4 shadow-soft">
            <div class="mb-4 flex items-center justify-between gap-3">
              <p class="brand-label text-[0.66rem] font-black uppercase tracking-[0.16em] text-[#1f6feb]">{visual.brandLabel}</p>
              {visual.checkIcon && (
                <picture class="logo-entreprise block h-9 w-9 overflow-hidden rounded-full bg-[#f4f6f8]">
                  <source srcset={visual.checkIcon.webpSrc} type="image/webp" />
                  <img src={visual.checkIcon.src} alt={visual.checkIcon.alt} class="h-full w-full object-cover" loading="eager" decoding="async" />
                </picture>
              )}
            </div>
            <div class="couleurs-brand overflow-hidden rounded-2xl border border-[#e8e9ea] bg-[#f4f6f8] p-3">
              <picture>
                <source srcset={visual.mockup.webpSrc} type="image/webp" />
                <img src={visual.mockup.src} alt={visual.mockup.alt} class="mx-auto max-h-64 rounded-xl object-contain" loading="eager" decoding="async" />
              </picture>
            </div>
            <div class="texte-publication mt-4 space-y-2">
              <p class="text-sm font-black text-[#0b1f3a]">{visual.draftTitle}</p>
              {visual.draftLines.map((line) => (
                <p class="rounded-xl bg-[#f4f6f8] px-3 py-2 text-xs font-semibold leading-5 text-[#4b5563]">{line}</p>
              ))}
            </div>
            <div class="chips-reseaux mt-4 flex flex-wrap gap-2">
              {visual.networkChips.map((chip) => (
                <span class="chip rounded-full border border-[#dfe3e8] bg-white px-3 py-1 text-[0.68rem] font-black text-[#0b1f3a]">{chip}</span>
              ))}
            </div>
            <button class="bouton-validation mt-4 w-full rounded-2xl bg-[#ff7a1a] px-4 py-3 text-sm font-black text-white shadow-[0_14px_30px_rgba(255,122,26,0.24)]" type="button">
              Relire et valider
            </button>
          </div>

          <div class="surfaces-canal relative rounded-[1.15rem] border border-[#dfe3e8] bg-[#101820] p-4 text-white shadow-soft">
            <svg class="ligne-orange pointer-events-none absolute left-[-1.5rem] top-8 hidden h-20 w-28 lg:block" viewBox="0 0 160 90" aria-hidden="true">
              <path d="M 8 45 Q 78 8 152 45" stroke="#FF7A1A" stroke-width="4" fill="none" stroke-linecap="round" stroke-dasharray="170" stroke-dashoffset="170" />
            </svg>
            <p class="text-[0.66rem] font-black uppercase tracking-[0.16em] text-[#ffb066]">Après validation</p>
            <div class="mt-4 grid gap-3">
              {visual.surfaces.map((surface) => (
                <article class="surface rounded-2xl border border-white/10 bg-white/9 p-3">
                  <p class="text-sm font-black">{surface.label}</p>
                  <p class="mt-1 text-xs leading-5 text-white/68">{surface.detail}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="rounded-[2rem] border border-white/12 bg-white/8 p-5 shadow-[0_30px_90px_rgba(0,0,0,0.22)] backdrop-blur">
        <div class="rounded-[1.45rem] bg-[#f4f6f8] p-5 text-[#101820]">
          <p class="text-xs font-black uppercase tracking-[0.2em] text-[#1f6feb]">Emplacement visuel Léa</p>
          <div class="mt-5 grid gap-3">
            <div class="h-36 rounded-2xl bg-gradient-to-br from-[#0b1f3a] via-[#182f50] to-[#ff7a1a]"></div>
            <div class="grid grid-cols-3 gap-3">
              <div class="h-20 rounded-xl bg-white shadow-soft"></div>
              <div class="h-20 rounded-xl bg-white shadow-soft"></div>
              <div class="h-20 rounded-xl bg-white shadow-soft"></div>
            </div>
          </div>
          <p class="mt-5 text-sm leading-6 text-[#4b5563]">{hero.visualNote}</p>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.hero-demo').forEach((demo) => {
    if (reduceMotion) return;
    const path = demo.querySelector('.ligne-orange path');
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.8, defaults: { ease: 'power2.out' } });
    tl.from(demo.querySelector('.photo-chantier'), { x: -36, opacity: 0, duration: 0.45 }, 0)
      .from(demo.querySelector('.vocal-wave'), { y: 12, opacity: 0, duration: 0.35 }, 0.25)
      .from(demo.querySelectorAll('.texte-publication p'), { opacity: 0, y: 10, stagger: 0.22, duration: 0.32 }, 1.25)
      .from(demo.querySelector('.fond-carte'), { opacity: 0.4, scale: 0.97, duration: 0.55 }, 1.35)
      .from(demo.querySelector('.logo-entreprise'), { scale: 0.7, opacity: 0, duration: 0.35 }, 2.7)
      .from(demo.querySelector('.couleurs-brand'), { clipPath: 'inset(100% 0 0 0)', duration: 0.6 }, 3)
      .to(demo.querySelector('.bouton-validation'), { scale: 1.03, duration: 0.38, repeat: 1, yoyo: true }, 4.2)
      .from(demo.querySelectorAll('.chips-reseaux .chip'), { opacity: 0, y: 10, stagger: 0.1, duration: 0.28 }, 4.65);
    if (path) {
      tl.to(path, { strokeDashoffset: 0, duration: 0.8, ease: 'power1.inOut' }, 5.5);
    }
    tl.from(demo.querySelectorAll('.surfaces-canal .surface'), { opacity: 0.35, scale: 0.96, stagger: 0.15, duration: 0.35 }, 5.9)
      .to(demo, { opacity: 0.98, duration: 0.1 }, 7.1)
      .set(path, { strokeDashoffset: 170 }, 7.8)
      .set(demo.querySelectorAll('.surfaces-canal .surface'), { clearProps: 'all' }, 7.8);
  });
</script>

<style>
  .hero-demo :global(img) {
    transform: translateZ(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .ligne-orange path {
      stroke-dashoffset: 0;
    }
  }
</style>
