---
import type { VariantSection } from '../../content/homepage-variants';
interface Props { section: VariantSection; }
const { section } = Astro.props;
---
<section id={section.id} class="variant-reveal section-pad bg-[#f4f6f8]">
  <div class="container grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
    <h2 class="text-3xl font-black tracking-[-0.04em] text-[#0b1f3a] md:text-5xl">{section.title}</h2>
    <div class="space-y-3">
      {section.faqs?.map((faq) => (
        <details class="variant-card rounded-2xl border border-[#dfe3e8] bg-white p-5">
          <summary class="cursor-pointer text-lg font-extrabold text-[#101820]">{faq.question}</summary>
          <p class="mt-3 leading-7 text-[#5b6170]">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
