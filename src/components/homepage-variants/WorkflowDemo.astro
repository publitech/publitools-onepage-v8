---
import type { VariantSection } from '../../content/homepage-variants';
interface Props { section: VariantSection; }
const { section } = Astro.props;
---
<section id={section.id} class="variant-reveal section-pad bg-[#f4f6f8]">
  <div class="container grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <div class="space-y-3">
      {section.eyebrow && <p class="text-sm font-black uppercase tracking-[0.22em] text-[#ff7a1a]">{section.eyebrow}</p>}
      <h2 class="text-3xl font-black tracking-[-0.04em] text-[#0b1f3a] md:text-5xl">{section.title}</h2>
      {section.body && <p class="text-lg leading-8 text-[#5b6170]">{section.body}</p>}
    </div>
    <ol class="grid gap-4">
      {section.items?.map((item, index) => (
        <li class="variant-card flex gap-4 rounded-3xl border border-[#dfe3e8] bg-white p-5 shadow-soft transition duration-300 hover:-translate-y-1">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#0b1f3a] text-sm font-black text-white">{index + 1}</span>
          <div>
            <h3 class="font-extrabold text-[#101820]">{item.title}</h3>
            <p class="mt-1 leading-7 text-[#5b6170]">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
