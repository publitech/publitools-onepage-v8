---
import type { VariantSection } from '../../content/homepage-variants';
interface Props { section: VariantSection; }
const { section } = Astro.props;
---
<section id={section.id} class="variant-reveal bg-[#0b1f3a] py-16 text-white md:py-20">
  <div class="container rounded-[2rem] border border-white/10 bg-white/8 p-8 text-center md:p-12">
    <h2 class="mx-auto max-w-3xl text-3xl font-black tracking-[-0.04em] md:text-5xl">{section.title}</h2>
    {section.body && <p class="mx-auto mt-4 max-w-2xl leading-8 text-white/72">{section.body}</p>}
    {section.cta && <a class="mt-8 inline-flex items-center justify-center rounded-full bg-[#ff7a1a] px-6 py-4 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-[#f06f12]" href={section.cta.href}>{section.cta.label}</a>}
  </div>
</section>
