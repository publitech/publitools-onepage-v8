---
import type { VariantSection } from '../../content/homepage-variants';
interface Props { section: VariantSection; }
const { section } = Astro.props;
---
<section id={section.id} class="variant-reveal section-pad bg-white">
  <div class="container space-y-8">
    <div class="max-w-3xl space-y-3">
      {section.eyebrow && <p class="text-sm font-black uppercase tracking-[0.22em] text-[#ff7a1a]">{section.eyebrow}</p>}
      <h2 class="text-3xl font-black tracking-[-0.04em] text-[#0b1f3a] md:text-5xl">{section.title}</h2>
      {section.body && <p class="text-lg leading-8 text-[#5b6170]">{section.body}</p>}
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {section.items?.map((item) => (
        <article class="variant-card rounded-[2rem] border border-[#e8e9ea] p-7 transition duration-300 hover:-translate-y-1 hover:shadow-soft">
          <h3 class="text-2xl font-black text-[#101820]">{item.title}</h3>
          <p class="mt-3 leading-8 text-[#5b6170]">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
