---
import type { VariantSection } from '../../content/homepage-variants';
interface Props { section: VariantSection; }
const { section } = Astro.props;
---
<section id={section.id} class="variant-reveal section-pad bg-[#101820] text-white">
  <div class="container space-y-8">
    <div class="max-w-3xl space-y-3">
      {section.eyebrow && <p class="text-sm font-black uppercase tracking-[0.22em] text-[#ffb066]">{section.eyebrow}</p>}
      <h2 class="text-3xl font-black tracking-[-0.04em] md:text-5xl">{section.title}</h2>
      {section.body && <p class="text-lg leading-8 text-white/72">{section.body}</p>}
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {section.items?.map((item) => (
        <article class="variant-card overflow-hidden rounded-3xl border border-white/10 bg-white/8 transition duration-300 hover:-translate-y-1 hover:bg-white/12">
          {item.image && (
            <picture>
              <source srcset={item.image.webpSrc} type="image/webp" />
              <img src={item.image.src} alt={item.image.alt} class="h-44 w-full object-cover" loading="lazy" decoding="async" />
            </picture>
          )}
          <div class="p-6">
            <h3 class="text-xl font-extrabold">{item.title}</h3>
            <p class="mt-3 leading-7 text-white/72">{item.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
