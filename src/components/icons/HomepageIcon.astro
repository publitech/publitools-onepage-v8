---
import { defaultHomepageIcon, homepageIconIdSet, type HomepageIconId } from '../../content/homepage/iconManifest';

type HomepageIconTone = 'orange' | 'navy' | 'black' | 'grey' | 'blue' | 'yellow' | 'white';
type HomepageIconSize = 16 | 24 | 32 | 40 | 48 | 60;

type Props = {
  icon?: HomepageIconId | string;
  size?: HomepageIconSize;
  tone?: HomepageIconTone;
  class?: string;
};

const {
  icon = defaultHomepageIcon,
  size = 32,
  tone = 'navy',
  class: className = '',
} = Astro.props as Props;

const rawIcons = import.meta.glob('../../icons/homepage/v1/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const requestedIcon = homepageIconIdSet.has(icon) ? icon : defaultHomepageIcon;
const svg = rawIcons[`../../icons/homepage/v1/${requestedIcon}.svg`] ?? rawIcons[`../../icons/homepage/v1/${defaultHomepageIcon}.svg`];
---

<span
  class:list={['homepage-icon', `homepage-icon--${tone}`, className]}
  style={`--homepage-icon-size: ${size}px`}
  aria-hidden="true"
  set:html={svg}
/>

<style>
  .homepage-icon {
    display: inline-flex;
    width: var(--homepage-icon-size);
    height: var(--homepage-icon-size);
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .homepage-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .homepage-icon--orange { color: #FF7A1A; }
  .homepage-icon--navy { color: #0B1F3A; }
  .homepage-icon--black { color: #101820; }
  .homepage-icon--grey { color: #6B7280; }
  .homepage-icon--blue { color: #1F6FEB; }
  .homepage-icon--yellow { color: #FFC107; }
  .homepage-icon--white { color: #FFFFFF; }
</style>
