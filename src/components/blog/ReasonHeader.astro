---
interface Props { number: number; title: string }
const { number, title } = Astro.props;
---
<header class="mb-7 mt-16 border-t border-[var(--op-line)] pt-10">
  <span class="inline-block rounded-full bg-[var(--op-yellow)] px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-[var(--op-ink)]">Raison n°{number}</span>
  <h2 id={`raison-${number}`} class="mt-4 scroll-mt-8 text-[26px] font-extrabold leading-tight text-[var(--op-ink)] sm:text-3xl">{title}</h2>
</header>
