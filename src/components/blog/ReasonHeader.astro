---
interface Props { number: number; title: string }
const { number, title } = Astro.props;
---
<header class="mb-7 mt-16 border-t border-[var(--op-line)] pt-10">
  <h2 id={`raison-${number}`} class="flex scroll-mt-8 items-start gap-3 text-2xl font-bold leading-tight text-[var(--op-ink)] sm:gap-4 sm:text-[26px]">
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#0b1f3a] text-xl font-bold text-white">{number}</span>
    <span class="min-w-0 pt-0.5">{title}</span>
  </h2>
</header>
