---
interface Props { kind: string }
const { kind } = Astro.props;
const paths: Record<string, string> = {
  '📸': 'M14 4h-4L8 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-4Z M16 13a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
  '🎙️': 'M9 5a3 3 0 0 1 6 0v7a3 3 0 0 1-6 0Z M5 10v2a7 7 0 0 0 14 0v-2 M12 19v3 M8 22h8',
  '✨': 'm12 3 3 6 6 3-6 3-3 6-3-6-6-3 6-3Z',
  check: 'm5 12 4 4L19 6',
  cross: 'm6 6 12 12M6 18 18 6',
};
---
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class:list={['shrink-0', kind === 'check' && 'text-emerald-700', kind === 'cross' && 'text-red-700']}><path d={paths[kind] ?? 'M5 12h14m-5-5 5 5-5 5'} /></svg>
