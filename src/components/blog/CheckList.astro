---
import BoldText from './BoldText.astro';
import EditorialIcon from './EditorialIcon.astro';
interface Props { variant: 'check' | 'cross'; items: string[] }
const { variant, items } = Astro.props;
---
<ul class="mb-10 mt-8 list-none space-y-5 p-0 leading-[1.75]">
  {items.map(item => <li class="flex items-start gap-3"><span class="mt-1.5 shrink-0 text-slate-500"><EditorialIcon kind={variant} /></span><span class="min-w-0"><BoldText text={item} /></span></li>)}
</ul>
