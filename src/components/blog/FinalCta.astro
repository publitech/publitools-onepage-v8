---
import CtaButton from './CtaButton.astro';
interface Props { title: string; text: string; label: string; sublabel: string; href: string }
const { title, text, label, sublabel, href } = Astro.props;
---
<section class="my-10 rounded-2xl bg-[var(--op-ink)] px-5 py-8 sm:p-9">
  <h2 class="text-2xl font-extrabold leading-tight text-white sm:text-3xl">{title}</h2>
  <div class="mt-5 text-lg leading-relaxed text-slate-300">{text}</div>
  <CtaButton label={label} sublabel={sublabel} href={href} dark />
</section>
