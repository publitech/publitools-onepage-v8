---
import CtaButton from './CtaButton.astro';
import EditorialIcon from './EditorialIcon.astro';
interface Props {
  brand: string;
  title: string;
  text: string;
  trial: string;
  price: string;
  priceNote: string;
  benefitsTitle: string;
  benefits: string[];
  terms: string[];
  closing: string;
  label: string;
  sublabel: string;
  href: string;
}
const { brand, title, text, trial, price, priceNote, benefitsTitle, benefits, terms, closing, label, sublabel, href } = Astro.props;
---
<section class="my-10 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5">
  <div class="bg-[#0b1f3a] px-5 py-8 text-white sm:p-8">
    <div class="text-sm font-bold uppercase tracking-widest text-slate-300">{brand}</div>
    <h3 class="mb-0! mt-4! text-2xl! font-extrabold! leading-tight! text-white! sm:text-3xl!">{title}</h3>
    <div class="mt-4 text-base leading-relaxed text-slate-300">{text}</div>
    <div class="mt-7 border-t border-white/15 pt-6">
      <div class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{trial}</div>
      <div class="mt-4 text-base text-slate-300">{priceNote}</div>
      <div class="mt-1 text-2xl font-bold leading-snug text-white">{price}</div>
    </div>
  </div>
  <div class="px-5 py-7 sm:p-8">
    <h4 class="m-0! text-lg! font-bold! text-[#0b1f3a]">{benefitsTitle}</h4>
    <ul class="mb-0! mt-5! grid list-none! gap-4 p-0! sm:grid-cols-2">
      {benefits.map(benefit => <li class="m-0! flex items-start gap-3 text-base leading-relaxed text-slate-700"><span class="mt-0.5 shrink-0"><EditorialIcon kind="check" /></span><span>{benefit}</span></li>)}
    </ul>
    <div class="mt-7 rounded-xl border border-slate-200 bg-slate-50 p-4">
      <ul class="m-0! list-none! space-y-3 p-0!">
        {terms.map(term => <li class="m-0! text-sm leading-relaxed text-slate-600">{term}</li>)}
      </ul>
    </div>
    <div class="mt-6 text-base font-medium leading-relaxed text-[#0b1f3a]">{closing}</div>
    <div class="[&>div]:mb-0 [&>div]:mt-6">
      <CtaButton label={label} sublabel={sublabel} href={href} />
    </div>
  </div>
</section>
