---
import BoldText from './BoldText.astro';
interface Props { items: string[] }
const { items } = Astro.props;
---
<ol class="my-7 list-none space-y-3 p-0">{items.map((item, index) => <li class="flex items-start gap-4 rounded-xl bg-[var(--op-gray)] p-5"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--op-yellow)] text-base font-extrabold" aria-hidden="true">{index + 1}</span><span class="min-w-0"><BoldText text={item} /></span></li>)}</ol>
