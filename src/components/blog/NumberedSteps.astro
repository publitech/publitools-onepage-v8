---
import BoldText from './BoldText.astro';
interface Props { items: string[] }
const { items } = Astro.props;
---
<ol class="my-7 list-none space-y-3 p-0">{items.map((item, index) => <li class="flex items-start gap-4 rounded-xl bg-slate-50 p-5"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-sm font-bold text-slate-600" aria-hidden="true">{index + 1}</span><span class="min-w-0"><BoldText text={item} /></span></li>)}</ol>
