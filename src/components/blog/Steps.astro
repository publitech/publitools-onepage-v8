---
interface Props { items: { icon: string; title: string; text: string }[] }
const { items } = Astro.props;
---
<ol class="my-7 list-none space-y-3 p-0">
  {items.map(item => <li class="flex min-w-0 gap-4 rounded-xl bg-[var(--op-gray)] p-5"><span class="shrink-0 text-3xl" aria-hidden="true">{item.icon}</span><div class="min-w-0"><strong class="block text-[var(--op-ink)]">{item.title}</strong><span class="text-[var(--op-muted)]">{item.text}</span></div></li>)}
</ol>
