---
import Layout from '../../layouts/Layout.astro';
import { blogCopy, blogLocales } from '../../lib/blog';
import type { Locale } from '../../i18n';
import '../../styles/onepage/base.css';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown>[];
  alternates?: { hreflang: string; href: string }[];
  article?: boolean;
  showPromotion?: boolean;
}
const { locale, title, description, image, schema = [], alternates = [], article = false, showPromotion = true } = Astro.props;
const t = blogCopy[locale];
---
<Layout title={title} description={description} locale={locale} image={image} schema={schema} alternates={alternates} footer={false} ogType={article ? 'article' : 'website'}>
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-5 px-5 py-5">
      <a href={`/${locale}/`} aria-label="PubliTools"><img src="/brand/publitools-logo-official.svg" alt="PubliTools" width="190" height="38" /></a>
      <nav class="flex items-center gap-5 text-sm font-bold" aria-label={t.label}>
        <a href={`/${locale}/`}>{t.home}</a><a href={`/${locale}/blog/`} class="text-[#a74708]">Blog</a>
        <a href={`/${locale}/#tarifs`} class="hidden rounded-lg bg-[#fac43e] px-4 py-3 sm:inline-flex">{t.back} ↗</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  {showPromotion && <section class="bg-[#00518f] px-5 py-16 text-white">
    <div class="mx-auto max-w-6xl items-center justify-between gap-8 md:flex">
      <div class="max-w-2xl"><h2 class="text-2xl font-extrabold md:text-3xl">{t.cta}</h2><p class="mt-4 text-white/85">{t.ctaText}</p></div>
      <a href={`/${locale}/`} class="mt-6 inline-flex shrink-0 rounded-lg bg-[#fac43e] px-6 py-4 font-bold text-[#262832] md:mt-0">{t.button} ↗</a>
    </div>
  </section>}
  <footer class="bg-[#f6f2ea] px-5 py-9">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6">
      <p class="text-sm font-bold">© {new Date().getFullYear()} PubliTools · CUT. BUILD. POST.</p>
      <nav class="flex gap-4 text-sm" aria-label="Blog · Languages">
        {blogLocales.map(code => {
          const translation = alternates.find(entry => entry.hreflang === code);
          return <a href={translation?.href ?? `/${code}/blog/`} hreflang={code} aria-current={code === locale ? 'page' : undefined} class:list={['rounded px-2 py-2', code === locale && 'bg-white font-bold']}>{code.toUpperCase()}</a>;
        })}
      </nav>
    </div>
  </footer>
</Layout>
