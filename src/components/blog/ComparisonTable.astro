---
import EditorialIcon from './EditorialIcon.astro';
interface Props { headers: string[]; rows: string[][]; footer?: string[]; highlightColumn: number }
const { headers, rows, footer = [], highlightColumn } = Astro.props;
---
<div class="my-8 w-full min-w-0 max-w-full overflow-x-auto rounded-xl border border-[var(--op-line)] focus-visible:outline-2 focus-visible:outline-[var(--op-blue)]" role="region" aria-label="Tableau comparatif" tabindex="0">
  <table class="w-full min-w-[520px] border-collapse text-left text-base leading-relaxed">
    <thead class="border-b border-slate-200 bg-slate-100 text-slate-700"><tr>{headers.map(header => <th scope="col" class="px-4 py-4 font-bold">{header}</th>)}</tr></thead>
    <tbody>{rows.map(row => <tr class="border-b border-[var(--op-line)]">{row.map((cell, index) => index === 0 ? <th scope="row" class="px-4 py-4 font-medium">{cell}</th> : <td class:list={['px-4 py-4', index === highlightColumn && 'bg-slate-50 font-semibold']}><span class="flex items-start gap-2">{ /^[✅❌]/u.test(cell) && <span class="mt-0.5 text-slate-500"><EditorialIcon kind={cell.startsWith('✅') ? 'check' : 'cross'} /></span>}<span>{cell.replace(/^[✅❌]\s*/u, '')}</span></span></td>)}</tr>)}</tbody>
    {footer.length > 0 && <tfoot><tr class="font-bold">{footer.map((cell, index) => index === 0 ? <th scope="row" class="px-4 py-5">{cell}</th> : <td class:list={['px-4 py-5 text-slate-700', index === highlightColumn && 'bg-slate-50']}>{cell}</td>)}</tr></tfoot>}
  </table>
</div>
