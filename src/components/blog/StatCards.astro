---
interface Props { items: { value: string; label: string }[]; source: string }
const { items, source } = Astro.props;
---
<figure class="my-8">
  <div class="grid min-w-0 grid-cols-2 gap-3">{items.map(item => <div class="min-w-0 rounded-xl bg-[var(--op-ink)] px-3 py-7 text-center"><div class="text-4xl font-black leading-tight text-[var(--op-yellow)] sm:text-6xl">{item.value}</div><div class="mt-4 text-sm leading-relaxed text-white sm:text-base">{item.label}</div></div>)}</div>
  <figcaption class="mt-3 text-center text-xs leading-relaxed text-[var(--op-muted)]">{source}</figcaption>
</figure>
