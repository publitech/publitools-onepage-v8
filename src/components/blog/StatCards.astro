---
interface Props { items: { value: string; label: string }[]; source: string }
const { items, source } = Astro.props;
---
<figure class="my-8">
  <div class="grid min-w-0 grid-cols-2 gap-3">{items.map(item => <div class="min-w-0 rounded-xl border border-slate-200 bg-slate-50 px-3 py-5 text-center"><div class="text-3xl font-bold leading-tight text-[var(--op-ink)]">{item.value}</div><div class="mt-3 text-sm leading-relaxed text-slate-600">{item.label}</div></div>)}</div>
  <figcaption class="mt-3 text-center text-xs leading-relaxed text-[var(--op-muted)]">{source}</figcaption>
</figure>
