---
interface Props { label: string; sublabel: string; href: string; dark?: boolean }
const { label, sublabel, href, dark = false } = Astro.props;
const safeHref = /^https?:\/\//i.test(href) || /^\/(?!\/)/.test(href) ? href : '#';
---
<div class:list={['w-full min-w-0', dark ? 'mb-0 mt-8' : 'my-12']}>
  <a href={safeHref} class:list={[
    'flex min-h-16 w-full items-center justify-center gap-3 rounded-xl bg-[var(--op-orange)] px-5 py-5 text-center text-lg font-extrabold leading-snug text-white! no-underline shadow-md transition-colors hover:bg-[var(--op-orange-hover)] hover:text-white! focus-visible:text-white! focus-visible:outline-2 focus-visible:outline-offset-4 sm:px-6',
    dark ? 'focus-visible:outline-white' : 'focus-visible:outline-[var(--op-blue)]',
  ]}>
    <span class="min-w-0">{label}</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden shrink-0 sm:block" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
  </a>
  <div class:list={['mt-3 text-center text-sm leading-relaxed', dark ? 'text-slate-300' : 'text-[var(--op-muted)]']}>{sublabel}</div>
</div>
