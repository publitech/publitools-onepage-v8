---
interface Props { slowLabel: string; slowValue: string; fastLabel: string; fastValue: string }
const { slowLabel, slowValue, fastLabel, fastValue } = Astro.props;
---
<div class="my-8 grid min-w-0 grid-cols-2 gap-3">
  <div class="min-w-0 rounded-xl bg-red-50 px-3 py-6 text-center"><div class="text-sm font-bold text-red-900">{slowLabel}</div><div class="mt-3 text-4xl font-black leading-tight text-red-700 sm:text-6xl">{slowValue}</div></div>
  <div class="min-w-0 rounded-xl bg-emerald-50 px-3 py-6 text-center"><div class="text-sm font-bold text-emerald-900">{fastLabel}</div><div class="mt-3 text-4xl font-black leading-tight text-emerald-700 sm:text-6xl">{fastValue}</div></div>
</div>
