---
interface Props { slowLabel: string; slowValue: string; fastLabel: string; fastValue: string }
const { slowLabel, slowValue, fastLabel, fastValue } = Astro.props;
---
<div class="my-8 grid min-w-0 grid-cols-2 divide-x divide-slate-200 rounded-xl border border-slate-200 bg-slate-50">
  <div class="min-w-0 px-3 py-5 text-center"><div class="text-sm font-medium text-slate-600">{slowLabel}</div><div class="mt-2 text-3xl font-bold leading-tight text-slate-500">{slowValue}</div></div>
  <div class="min-w-0 px-3 py-5 text-center"><div class="text-sm font-medium text-slate-600">{fastLabel}</div><div class="mt-2 text-3xl font-bold leading-tight text-[var(--op-ink)]">{fastValue}</div></div>
</div>
