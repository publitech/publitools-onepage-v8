---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { blogCopy, postUrl } from '../../lib/blog';
interface Props { post: CollectionEntry<'blog'>; featured?: boolean }
const { post, featured = false } = Astro.props;
const t = blogCopy[post.data.locale];
---
<article class:list={['group overflow-hidden rounded-2xl border border-slate-200 bg-white transition-shadow hover:shadow-lg', featured && 'md:col-span-2']}>
  <a href={postUrl(post)} class:list={['block h-full', featured && 'md:grid md:grid-cols-2']}>
    <Image src={post.data.cover} alt={post.data.coverAlt} widths={[400, 700, 1000]} sizes="(max-width: 768px) 100vw, 50vw" width={800} format="webp" quality={78} class="aspect-[16/10] h-full max-h-96 w-full object-cover" loading="lazy" />
    <div class="flex flex-col items-start p-7">
      <span class="rounded-full bg-[#f6f2ea] px-3 py-1 text-xs font-bold text-[#00518f]">{t.subjects[post.data.category]}</span>
      <h3 class="mt-5 text-2xl font-extrabold leading-snug group-hover:text-[#00518f]">{post.data.title}</h3>
      <p class="mt-3 text-sm leading-7 text-slate-600">{post.data.description}</p>
      <time class="mt-5 text-xs text-slate-500" datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString(post.data.locale, { dateStyle: 'long', timeZone: 'UTC' })}</time>
      <span class="mt-6 text-sm font-bold">{t.read} <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
