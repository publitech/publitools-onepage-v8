---
interface FaqItem {
  question: string;
  answer: string;
}

interface FaqGroup {
  title?: string;
  items: FaqItem[];
}

interface Props {
  groups?: FaqGroup[];
  items?: FaqItem[];
}

const { groups, items } = Astro.props;
const faqGroups = groups ?? [{ items: items ?? [] }];
const slugify = (value = '') => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<div class="v31-faq-accordion">
  {faqGroups.map((group) => (
    <section class="faq-group" id={group.title ? slugify(group.title) : undefined}>
      {group.title && <h2>{group.title}</h2>}
      <div class="faq-list">
        {group.items.map((item, index) => (
          <details class="faq-item" open={index === 0 && faqGroups.length === 1}>
            <summary>
              <span>{item.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .v31-faq-accordion {
    display: grid;
    gap: 22px;
  }

  .faq-group {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
    scroll-margin-top: 120px;
  }

  .faq-group h2 {
    grid-column: 1 / 4;
    position: sticky;
    top: 96px;
    margin: 0;
    color: #0b1f3a;
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .faq-list {
    grid-column: 4 / 13;
    display: grid;
    gap: 12px;
  }

  .faq-group:not(:has(h2)) .faq-list {
    grid-column: 1 / -1;
  }

  .faq-item {
    border: 1px solid #e8edf3;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 12px 34px rgba(11, 31, 58, 0.06);
  }

  summary {
    display: flex;
    min-height: 72px;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 20px 22px;
    color: #0b1f3a;
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    font-weight: 900;
    line-height: 1.35;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    display: inline-grid;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 999px;
    background: #fff1e6;
    color: #ff7a1a;
    font-size: 20px;
    font-weight: 900;
    transition: transform 160ms ease;
  }

  details[open] .faq-icon {
    transform: rotate(45deg);
  }

  p {
    margin: -6px 0 0;
    padding: 0 22px 22px;
    color: #536174;
    font-size: 15px;
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .faq-group {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 14px;
    }

    .faq-group h2,
    .faq-list,
    .faq-group:not(:has(h2)) .faq-list {
      grid-column: 1 / -1;
    }

    .faq-group h2 {
      position: static;
      margin-bottom: 8px;
    }

    summary {
      min-height: 64px;
      padding: 18px;
      font-size: 16px;
    }

    p {
      padding: 0 18px 18px;
    }
  }
</style>
