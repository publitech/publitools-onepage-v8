---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  schema?: Record<string, unknown>[];
  footerNetworkText?: string;
}

const { title, description, canonical, image, schema = [], footerNetworkText } = Astro.props;
---

<Layout title={title} description={description} canonical={canonical} image={image} schema={schema} footerNetworkText={footerNetworkText}>
  <SiteHeader />
  <main class="v31-page-shell v31-page-surface">
    <slot />
  </main>
</Layout>
