---
import { Image } from 'astro:assets';
import MobileMenu from './MobileMenu.astro';
import LanguageSwitcher from './v31/LanguageSwitcher.astro';
import logo from '../assets/publi/logo.jpg';
import { dict, getLocaleFromPath, type Locale } from '../i18n';

const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const t = dict[locale];
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isFeaturesActive = currentPath.startsWith(`/${locale}/fonctionnalites/`);
const isPricingActive = currentPath === `/${locale}/tarif/`;
const isFaqActive = currentPath === `/${locale}/faq/`;
const isBlogActive = currentPath.startsWith(`/${locale}/blog/`);
---
<header class="site-header">
  <div class="site-header__inner">
    <a href={`/${locale}/`} class="site-header__brand" aria-label={t.common.siteName}>
      <Image src={logo} alt={t.common.siteName} width={243} height={50} class="site-header__logo" />
    </a>

    <nav class="site-nav" aria-label={t.common.footer.heading}>
      <div class="site-nav__item group">
        <a
          class:list={['site-nav__link site-nav__link--with-icon', isFeaturesActive && 'is-active']}
          href={t.common.nav.featuresHref}
          aria-current={isFeaturesActive ? 'page' : undefined}
        >
          {t.common.nav.features}
          <svg class="site-nav__chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </a>
        <div class="site-nav__dropdown">
          <div class="site-nav__dropdown-card">
            <a class="site-nav__dropdown-link" href="/fr/fonctionnalites/automatisation-reseaux-sociaux/">Automatisation des réseaux sociaux</a>
            <a class="site-nav__dropdown-link" href="/fr/fonctionnalites/obtenir-plus-d-avis/">Obtenir plus d’avis</a>
            <a class="site-nav__dropdown-link" href="/fr/fonctionnalites/booster-google-business/">Booster votre compte Google Business</a>
          </div>
        </div>
      </div>
      <a class:list={['site-nav__link', isPricingActive && 'is-active']} href={t.common.nav.pricingHref} aria-current={isPricingActive ? 'page' : undefined}>{t.common.nav.pricing}</a>
      <a class:list={['site-nav__link', isFaqActive && 'is-active']} href={t.common.nav.faqHref} aria-current={isFaqActive ? 'page' : undefined}>{t.common.nav.faq}</a>
      <a class:list={['site-nav__link', isBlogActive && 'is-active']} href={t.common.nav.blogHref} aria-current={isBlogActive ? 'page' : undefined}>{t.common.nav.blog}</a>
      <LanguageSwitcher locale={locale} pathname={Astro.url.pathname} />
    </nav>

    <div class="site-header__actions">
      <a class="site-header__login" href={t.common.nav.loginHref}>{t.common.nav.login}</a>
      <a class="site-header__cta" href={t.common.nav.ctaHref}>{t.common.nav.cta}</a>
    </div>

    <MobileMenu currentPath={currentPath} locale={locale} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(227, 232, 239, 0.92);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: flex;
    width: min(1184px, calc(100% - 64px));
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-inline: auto;
  }

  .site-header__brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    text-decoration: none;
  }

  .site-header__logo {
    width: 216px;
    height: auto;
    object-fit: contain;
  }

  .site-nav {
    display: none;
    align-items: center;
    gap: 6px;
  }

  .site-nav__item {
    position: relative;
    padding-block: 18px;
  }

  .site-nav__link {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    border-radius: 999px;
    padding: 0 14px;
    color: #536174;
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    text-decoration: none;
    transition: color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible,
  .site-nav__link.is-active {
    background: #f4f6f8;
    color: #0b1f3a;
  }

  .site-nav__link.is-active {
    box-shadow: inset 0 0 0 1px rgba(11, 31, 58, 0.08);
  }

  .site-nav__link--with-icon {
    gap: 6px;
  }

  .site-nav__chevron {
    width: 15px;
    height: 15px;
    color: #ff7a1a;
    transition: transform 180ms ease;
  }

  .site-nav__item:hover .site-nav__chevron,
  .site-nav__item:focus-within .site-nav__chevron {
    transform: rotate(180deg);
  }

  .site-nav__dropdown {
    position: absolute;
    left: 0;
    top: 100%;
    z-index: 50;
    width: 384px;
    padding-top: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms ease;
  }

  .site-nav__item:hover .site-nav__dropdown,
  .site-nav__item:focus-within .site-nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-nav__dropdown-card {
    border: 1px solid #e3e8ef;
    border-radius: 20px;
    background: #ffffff;
    padding: 8px;
    box-shadow: 0 20px 54px rgba(11, 31, 58, 0.1);
  }

  .site-nav__dropdown-link {
    display: block;
    border-radius: 14px;
    padding: 12px 14px;
    color: #0b1f3a;
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 800;
    line-height: 20px;
    text-decoration: none;
    transition: color 180ms ease, background 180ms ease;
  }

  .site-nav__dropdown-link:hover,
  .site-nav__dropdown-link:focus-visible {
    background: #fff1e6;
    color: #e86a0a;
  }

  .site-header__actions {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
  }

  .site-header__login,
  .site-header__cta {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    padding: 0 18px;
    font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 800;
    line-height: 20px;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .site-header__login:hover,
  .site-header__cta:hover {
    transform: translateY(-1px);
  }

  .site-header__login {
    border: 1px solid #e3e8ef;
    background: #ffffff;
    color: #0b1f3a;
  }

  .site-header__login:hover,
  .site-header__login:focus-visible {
    border-color: rgba(11, 31, 58, 0.22);
    background: #f4f6f8;
  }

  .site-header__cta {
    border: 1px solid #ff7a1a;
    background: #ff7a1a;
    color: #ffffff;
    box-shadow: 0 16px 30px rgba(255, 122, 26, 0.22);
  }

  .site-header__cta:hover,
  .site-header__cta:focus-visible {
    background: #e86a0a;
    box-shadow: 0 20px 36px rgba(255, 122, 26, 0.3);
  }

  @media (min-width: 1024px) {
    .site-nav,
    .site-header__actions {
      display: flex;
    }
  }

  @media (max-width: 1020px) {
    .site-header__inner {
      width: min(1184px, calc(100% - 48px));
      min-height: 72px;
    }

    .site-header__logo {
      width: 198px;
    }
  }

  @media (max-width: 680px) {
    .site-header__inner {
      width: min(1184px, calc(100% - 32px));
      min-height: 68px;
      gap: 16px;
    }

    .site-header__logo {
      width: 176px;
    }
  }
</style>