---
const socialLogos = [
  { label: 'Facebook', src: '/social/facebook-official.svg' },
  { label: 'Instagram', src: '/social/instagram-official.svg' },
  { label: 'LinkedIn', src: '/social/linkedin-official.svg' },
  { label: 'Google Business', src: '/social/google-official.svg' },
  { label: 'TikTok', src: '/social/tiktok-official.svg' },
  { label: 'YouTube', src: '/social/youtube-official.svg' },
];
const stats = [['+600 %','vues publications'],['2 min','vs 30 min'],['+35 %','avis collectés'],['+40 %','demandes de devis']];
const assetPath = (name) => `/homepage/fr/v26/gpt-image-2-low/${name}.png`;
const sections = [
  {id:'hero',eyebrow:'1 — Hero section',title:'Hero',lead:'3 directions visuelles pour le même hero validé par Le Sage.',baseTitle:"L'outil IA n°1 du BTP pour faire grossir votre entreprise du bâtiment sur internet",baseSubtitle:'Réseaux sociaux, avis clients, Google Business en moins de 2 min / jour.',variants:[{name:'Mockup outil puissant',img:'hero-tool-mockup',micro:'Photo + vocal → post prêt sur 6 réseaux',type:'phone-orbit'},{name:'Transformation avant/après',img:'hero-before-after',micro:'Avant : photo brute. Après : publication pro.',type:'before-after'},{name:'Hub complet PubliTools',img:'hero-hub',micro:'Réseaux. Avis. Google Business. Dans un seul outil.',type:'hub'}]},
  {id:'results',eyebrow:'2 — Résultats',title:'50+ artisans. 3 mois. Des chiffres concrets.',lead:'Un outil IA qui a fait ses preuves en apportant des résultats concrets.',note:'Résultats observés chez des artisans utilisateurs après 3 mois. Pas de résultat individuel promis.',variants:[{name:'Stat strip ultra lisible',img:'results-stat-strip',micro:'4 chiffres. 3 mois. 50+ artisans.',type:'stats'},{name:'Avant / après PubliTools',img:'results-before-after',micro:'Avant PubliTools / Avec PubliTools',type:'result-before-after'},{name:'Timeline 3 mois',img:'results-timeline',micro:'Mois 1 : on publie. Mois 2 : on collecte. Mois 3 : on mesure.',type:'timeline'}]},
  {id:'social',eyebrow:'3 — Réseaux sociaux',title:'Alimentez 6 réseaux sociaux en même temps sans y passer vos soirées',lead:'Publiez sur 6 réseaux de manière professionnelle, en moins de 2 min, en 1 clic.',variants:[{name:'1 contenu → 6 réseaux',img:'social-flow',micro:'1 chantier → 6 réseaux',type:'flow'},{name:'Grille de 6 previews',img:'social-grid',micro:'Le même contenu, adapté à chaque plateforme',type:'preview-grid'},{name:'Vocal → caption → publication',img:'social-vocal',micro:'Dictez. Validez. Publiez.',type:'vocal'}]},
  {id:'reviews',eyebrow:'4 — Avis clients',title:"Le moyen le plus rapide de demander et d'obtenir des avis vérifiés de vos chantiers",lead:'Un process ultra simple pour les artisans débordés : demandez des avis sans y passer des heures.',variants:[{name:'Timeline SMS',img:'reviews-sms',micro:'Chantier terminé → SMS prêt → avis reçu',type:'sms-timeline'},{name:'Deux téléphones',img:'reviews-two-phones',micro:'Vous envoyez. Le client clique. L’avis arrive.',type:'two-phones'},{name:'Avis reçu → publication',img:'reviews-to-post',micro:'Un avis reçu peut devenir une publication',type:'review-post'}]},
  {id:'google',eyebrow:'5 — Google Business',title:'Optimisez votre présence sur Google sans dépenser 1 € en référencement',lead:'Publiez photos, posts et avis sur votre fiche Google Business depuis PubliTools.',variants:[{name:'Fiche Google vivante',img:'gmb-live',micro:'Une fiche Google vivante',type:'gmb-live'},{name:'Avant / après fiche Google',img:'gmb-before-after',micro:'Inactive → alimentée',type:'gmb-before-after'},{name:'Carte locale + fiche',img:'gmb-local',micro:'Plus de photos, posts et avis visibles localement',type:'map'}]},
  {id:'pricing',eyebrow:'6 — Tarifs',title:'Moins cher qu’un freelance. Plus efficace qu’une agence.',lead:'Deux offres simples, à partir de 19,90 € HT par mois.',variants:[{name:'Deux cartes simples',img:'pricing-cards',micro:'Deux offres. Pas de blabla.',type:'pricing-cards'},{name:'Comparatif valeur',img:'pricing-value',micro:'Prix clair. Valeur claire.',type:'pricing-value'},{name:'Essai Pro complet',img:'pricing-trial',micro:'Testez le Pro complet pendant 14 jours',type:'trial'}]},
  {id:'faq',eyebrow:'7 — FAQ',title:"Des questions sur l'application ?",lead:'Réseaux, avis, Google Business, essai 14 jours : les réponses simples avant de tester.',variants:[{name:'Accordéon premium ultra court',img:'faq-accordion',micro:'Les réponses simples avant de tester',type:'accordion'},{name:'Vrai / Faux',img:'faq-true-false',micro:'Vrai / Faux sur PubliTools',type:'true-false'},{name:'FAQ visuelle par pictos',img:'faq-picto',micro:'IA, réseaux, avis, Google, prix : l’essentiel',type:'pictos'}]},
];
---

<main class="v26-page">
  <div class="workbar">Page de travail V26 — 7 sections × 3 idées — noindex — route isolée</div>
  {sections.map((section) => (
    <section class={`v26-section v26-${section.id}`} id={section.id}>
      <div class="v26-container">
        <header class="section-head">
          <span class="eyebrow">{section.eyebrow}</span>
          <h2>{section.title}</h2>
          <p>{section.lead}</p>
        </header>
        <div class="variant-stack">
          {section.variants.map((variant, index) => (
            <article class={`variant-card ${index === 1 ? 'soft' : ''} ${index === 2 ? 'navy' : ''}`}>
              <div class="variant-label">
                <span>{section.eyebrow.replace(/^\d+ — /,'')} — Idée {index + 1}</span>
                <strong>{variant.name}</strong>
              </div>
              {section.id === 'hero' ? (
                <div class="hero-grid">
                  <div class="hero-copy">
                    <span class="audience-badge">Pour les Artisans, TPE et PME du Bâtiment</span>
                    <h1>{section.baseTitle}</h1>
                    <p class="hero-sub">{section.baseSubtitle}</p>
                    <div class="hero-badges"><span>Powered by IA</span><span>{variant.micro}</span></div>
                    <div class="avatars" aria-label="Utilisé par plus de 150 artisans"><i>A</i><i>B</i><i>C</i><i>D</i><strong>Utilisé par + de 150 artisans</strong></div>
                    <div class="available">Disponible pour</div>
                    <div class="social-row">{socialLogos.map((logo) => <img src={logo.src} alt={logo.label} loading="eager" />)}</div>
                  </div>
                  <div class="visual-frame">
                    <img class="static-asset" src={assetPath(variant.img)} alt="" loading="eager" />
                    {variant.type === 'phone-orbit' && (<><div class="phone"><div class="phone-screen"><div class="job-photo"></div><div class="mini-item">Vocal transcrit</div><div class="orange-btn">Publier</div></div></div><div class="orbit">{socialLogos.map((logo) => <img src={logo.src} alt="" loading="eager" />)}</div></>)}
                    {variant.type === 'before-after' && (<div class="before-after-box"><div class="panel before"><strong>Photo chantier</strong><span>brute</span></div><div class="arrow">→</div><div class="panel after"><strong>Publication pro</strong><span>prête</span></div></div>)}
                    {variant.type === 'hub' && (<div class="hub-box"><div class="hub-center">PubliTools</div><div class="hub-poles"><span>Réseaux</span><span>Avis</span><span>Google Business</span></div></div>)}
                  </div>
                </div>
              ) : (
                <div class="content-grid">
                  <div class="copy-column">
                    <span class="micro">{variant.micro}</span>
                    {section.id === 'results' && (<div class="stat-grid">{stats.map(([n,l]) => <div class="stat-card"><strong>{n}</strong><span>{l}</span></div>)}</div>)}
                    {section.id === 'social' && (<div class="logo-grid">{socialLogos.map((logo) => <div class="logo-tile"><img src={logo.src} alt={logo.label} /></div>)}</div>)}
                    {section.id === 'reviews' && (<div class="steps"><span>Chantier terminé</span><span>SMS prêt</span><span>Avis reçu</span></div>)}
                    {section.id === 'google' && (<div class="mini-list"><div class="mini-item">Posts Google</div><div class="mini-item">Photos chantier</div><div class="mini-item">Avis clients</div></div>)}
                    {section.id === 'pricing' && (<div class="price-grid"><div class="price-card"><strong>Starter</strong><div class="price">19,90 €</div><span>HT/mois</span></div><div class="price-card pro"><strong>Pro</strong><div class="price">39,90 €</div><span>HT/mois</span></div></div>)}
                    {section.id === 'faq' && variant.type === 'true-false' && (<div class="truefalse"><div class="tf true">VRAI · vous validez</div><div class="tf false">FAUX · pas de promesse Google</div></div>)}
                    {section.id === 'faq' && variant.type === 'pictos' && (<div class="picto-grid"><span>IA</span><span>Réseaux</span><span>Avis</span><span>Google</span><span>Prix</span><span>Essai</span></div>)}
                    {section.id === 'faq' && variant.type === 'accordion' && (<div class="faq-grid"><details open><summary>Quels réseaux ?</summary><p>Facebook, Instagram, LinkedIn, Google Business, TikTok et YouTube.</p></details><details><summary>Puis-je relire ?</summary><p>Oui, l’utilisateur relit et valide avant publication.</p></details><details><summary>Les résultats sont-ils assurés ?</summary><p>Non. Ce sont des résultats observés chez des artisans utilisateurs.</p></details></div>)}
                    {section.note && <p class="claim-note">{section.note}</p>}
                  </div>
                  <div class="visual-frame"><img class="static-asset" src={assetPath(variant.img)} alt="" loading="eager" /><img class="asset-card" src={assetPath(variant.img)} alt={variant.name} loading="eager" /></div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</main>

<style is:global>
.v26-page{background:#fff;color:#0B1F3A;font-family:Inter,system-ui,sans-serif}.workbar{position:sticky;top:0;z-index:30;background:#fff7ed;border-bottom:1px solid #fed7aa;color:#0B1F3A;text-align:center;padding:10px 16px;font-weight:800;font-size:14px}.v26-container{width:min(1120px,calc(100% - 32px));margin:0 auto}.v26-section{padding:72px 0}.v26-section:nth-child(odd){background:#F6F7F9}.section-head{max-width:850px;margin:0 auto 34px;text-align:center}.eyebrow,.audience-badge{display:inline-flex;border:1px solid #fed7aa;background:#fff7ed;color:#FF7A1A;border-radius:999px;padding:9px 14px;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.section-head h2{margin:18px 0 10px;font-family:Montserrat,Inter,sans-serif;font-size:clamp(34px,5vw,64px);line-height:.95;letter-spacing:-.06em}.section-head p{margin:0 auto;color:#596273;font-size:clamp(17px,2vw,21px);line-height:1.45}.variant-stack{display:grid;gap:28px}.variant-card{border:1px solid #e5e7eb;background:#fff;border-radius:34px;padding:clamp(20px,3vw,34px);box-shadow:0 24px 80px rgba(11,31,58,.1)}.variant-card.soft{background:#fffaf5;border-color:#fed7aa}.variant-card.navy{background:#0B1F3A;color:#fff;border-color:rgba(255,255,255,.14)}.variant-label{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:22px;border-bottom:1px solid rgba(148,163,184,.24);padding-bottom:16px}.variant-label span{font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:#FF7A1A}.variant-label strong{font-family:Montserrat,Inter,sans-serif;font-size:20px}.hero-grid,.content-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:34px;align-items:center}.hero-copy h1{font-family:Montserrat,Inter,sans-serif;font-size:clamp(42px,6vw,78px);line-height:.9;letter-spacing:-.07em;margin:20px 0}.hero-sub{font-size:clamp(19px,2vw,24px);line-height:1.35;color:#596273;max-width:620px}.navy .hero-sub{color:#dbeafe}.hero-badges{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0}.hero-badges span,.micro{display:inline-flex;border-radius:999px;background:#0B1F3A;color:#fff;padding:10px 14px;font-weight:900}.navy .hero-badges span,.navy .micro{background:#fff;color:#0B1F3A}.avatars{display:flex;align-items:center;gap:0;margin:18px 0}.avatars i{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#FF7A1A,#0B1F3A);color:#fff;border:3px solid #fff;font-style:normal;font-weight:900;margin-right:-10px}.avatars strong{margin-left:18px;font-weight:900}.available{font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:900;color:#64748B;margin:20px 0 10px}.social-row{display:flex;gap:10px;flex-wrap:wrap}.social-row img{width:38px;height:38px;object-fit:contain;background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:8px}.visual-frame{position:relative;border-radius:30px;overflow:hidden;background:linear-gradient(135deg,#eef3f8,#fff);min-height:390px;border:1px solid rgba(148,163,184,.28);box-shadow:0 28px 80px rgba(11,31,58,.16);display:grid;place-items:center}.navy .visual-frame{border-color:rgba(255,255,255,.18);background:linear-gradient(135deg,#0f2b4d,#071524)}.visual-frame img.static-asset{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.22}.asset-card{position:relative;z-index:1;width:92%;border-radius:24px;box-shadow:0 20px 50px rgba(11,31,58,.16)}.phone{position:relative;width:min(280px,70%);aspect-ratio:9/16;border:10px solid #0B1F3A;border-radius:38px;background:#fff;box-shadow:0 30px 70px rgba(11,31,58,.25);padding:14px}.phone-screen{height:100%;border-radius:24px;background:#f8fafc;padding:16px;display:grid;gap:12px}.job-photo{border-radius:18px;background:linear-gradient(135deg,#cbd5e1,#94a3b8);min-height:110px}.orange-btn{border-radius:16px;background:#FF7A1A;color:#fff;text-align:center;padding:12px;font-weight:900}.orbit{position:absolute;inset:24px;pointer-events:none}.orbit img{position:absolute;width:36px;height:36px;background:#fff;border-radius:13px;padding:7px;box-shadow:0 12px 26px rgba(11,31,58,.16)}.orbit img:nth-child(1){left:4%;top:12%}.orbit img:nth-child(2){right:6%;top:10%}.orbit img:nth-child(3){left:1%;bottom:22%}.orbit img:nth-child(4){right:3%;bottom:18%}.orbit img:nth-child(5){left:42%;top:0}.orbit img:nth-child(6){left:45%;bottom:0}.before-after-box{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:center;width:92%;z-index:1}.panel{min-height:255px;border-radius:26px;padding:22px;background:#fff;border:1px solid #e5e7eb;display:grid;align-content:end;color:#0B1F3A}.panel.before{filter:saturate(.55);background:#e2e8f0}.panel.after{background:linear-gradient(135deg,#fff,#fff7ed);border-color:#fdba74}.arrow{font-size:38px;color:#FF7A1A;font-weight:900}.hub-box{display:grid;place-items:center;gap:18px;z-index:1}.hub-center{border-radius:28px;background:#FF7A1A;color:#fff;padding:28px 34px;font-weight:1000;font-size:24px}.hub-poles{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.hub-poles span{border-radius:20px;background:#fff;color:#0B1F3A;padding:18px;font-weight:900;text-align:center}.copy-column{display:grid;gap:18px;align-content:start}.stat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.stat-card{border-radius:24px;background:#0B1F3A;color:#fff;padding:20px}.stat-card strong{display:block;color:#FF7A1A;font-family:Montserrat;font-size:38px;line-height:1}.claim-note{font-size:13px;color:#64748B;line-height:1.45}.navy .claim-note{color:#cbd5e1}.mini-list{display:grid;gap:10px}.mini-item{border-radius:18px;background:#F4F6F8;padding:14px 16px;font-weight:850;color:#0B1F3A}.navy .mini-item{background:rgba(255,255,255,.1);color:#fff}.logo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.logo-tile{border-radius:18px;background:#fff;border:1px solid #e5e7eb;padding:14px;display:grid;place-items:center;min-height:74px}.logo-tile img{width:34px;height:34px}.steps{display:flex;gap:10px;flex-wrap:wrap}.steps span{border-radius:999px;background:#fff7ed;color:#9a3412;padding:10px 14px;font-weight:900}.price-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.price-card{border-radius:24px;border:1px solid #e5e7eb;background:#fff;padding:20px;color:#0B1F3A}.price-card.pro{border:2px solid #FF7A1A}.price{font-family:Montserrat;font-size:34px;font-weight:1000;color:#FF7A1A}.faq-grid{display:grid;gap:10px}.faq-grid details{border:1px solid #e5e7eb;border-radius:18px;padding:14px 16px;background:#fff;color:#0B1F3A}.faq-grid summary{font-weight:900;cursor:pointer}.faq-grid p{margin:8px 0 0;color:#596273}.truefalse{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.tf{border-radius:18px;padding:14px 16px;font-weight:900}.tf.true{background:#dcfce7;color:#14532d}.tf.false{background:#fee2e2;color:#7f1d1d}.picto-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.picto-grid span{border-radius:20px;background:#fff;color:#0B1F3A;border:1px solid #e5e7eb;padding:18px;text-align:center;font-weight:900}@media(max-width:860px){.hero-grid,.content-grid{grid-template-columns:1fr}.section-head{text-align:left}.variant-label{align-items:flex-start;flex-direction:column}.before-after-box{grid-template-columns:1fr}.arrow{transform:rotate(90deg);text-align:center}.hub-poles,.price-grid,.truefalse{grid-template-columns:1fr}.v26-section{padding:54px 0}.visual-frame{min-height:330px}.hero-copy h1{font-size:44px}.logo-grid,.picto-grid{grid-template-columns:repeat(2,1fr)}}
</style>
