---
const { pricing, ctaClass } = Astro.props;
---
<section class="v12-section v12-section--white" id={pricing.id}>
  <div class="v12-container">
    <div class="v12-section-head"><p class="v12-eyebrow">{pricing.eyebrow}</p><h2>{pricing.title}</h2><p>{pricing.description}</p></div>
    <div class="v12-pricing-grid">{pricing.plans.map((plan: any) => <article class:list={['v12-price-card', plan.featured && 'is-featured']}>{plan.featured && <span class="v12-plan-tag">{plan.featuredLabel}</span>}<h3>{plan.name}</h3><p>{plan.subtitle}</p><strong>{plan.price}</strong><ul>{plan.features.map((feature: string) => <li>{feature}</li>)}</ul><a class={ctaClass} href={plan.href}>{plan.ctaLabel}</a></article>)}</div>
    <p class="v12-pricing-note">{pricing.note}</p>
  </div>
</section>
