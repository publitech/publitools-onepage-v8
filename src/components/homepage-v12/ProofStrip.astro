---
const { proof, icons } = Astro.props;
---
<section class="v12-proof" id={proof.id} aria-label="Résultats observés">
  <div class="v12-container v12-proof__grid">
    {proof.metrics.map((metric: any) => (
      <article class="v12-proof-card" data-v12-reveal>
        <img src={icons[metric.icon]} alt="" width="34" height="34" loading="eager" decoding="async" aria-hidden="true" />
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </article>
    ))}
  </div>
  <p class="v12-proof-note">{proof.note}</p>
</section>
