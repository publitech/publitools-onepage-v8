---
import Layout from '../../layouts/Layout.astro';
import type { CopyVariant } from '../../content/homepage-copy-variants';

interface Props {
  variant: CopyVariant;
}

const { variant } = Astro.props;
---

<Layout title={variant.title} description={variant.description} canonical={`https://publitools.ai/fr/homepage-copy-variants/${variant.slug}/`}>
  <main class="copy-page">
    <nav class="topbar" aria-label="Navigation variantes">
      <a href="/fr/homepage-copy-variants/index.html">← Comparer les 3 variantes</a>
      <span>{variant.label}</span>
    </nav>

    <section class="hero-copy">
      <div class="hero-copy__text">
        <p class="eyebrow">{variant.eyebrow}</p>
        <h1>{variant.h1}</h1>
        <p class="subheadline">{variant.subheadline}</p>
        <div class="cta-row">
          <a class="primary" href="#pricing">{variant.primaryCta}</a>
          <a class="secondary" href="#sections">{variant.secondaryCta}</a>
        </div>
        <p class="proof-line">{variant.proofLine}</p>
      </div>
      <aside class="asset-slot" aria-label="Emplacement futur visuel">
        <p class="asset-label">Image / animation future</p>
        <p>{variant.visualNote}</p>
      </aside>
    </section>

    <section class="angle-note">
      <strong>Angle testé :</strong> {variant.angle}
    </section>

    <section id="sections" class="sections-list">
      {variant.sections.map((section, index) => (
        <article class="copy-section">
          <div class="section-number">{String(index + 1).padStart(2, '0')}</div>
          <div>
            {section.kicker && <p class="kicker">{section.kicker}</p>}
            <h2>{section.title}</h2>
            {section.text && <p>{section.text}</p>}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </div>
        </article>
      ))}
    </section>

    <section id="pricing" class="pricing-copy">
      <p class="kicker">Prix</p>
      <h2>Une offre lisible, selon votre rythme de publication.</h2>
      <p>{variant.pricing.intro}</p>
      <div class="pricing-grid">
        {variant.pricing.plans.map((plan) => (
          <article>
            <h3>{plan.name}</h3>
            <p class="price">{plan.price}</p>
            <p>{plan.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="final-copy">
      <h2>{variant.finalCta}</h2>
      <a class="primary" href="/fr/contact/">Demander l’accès</a>
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    background: #f6f7f8;
    color: #101820;
  }

  .copy-page {
    min-height: 100vh;
  }

  .topbar,
  .hero-copy,
  .angle-note,
  .sections-list,
  .pricing-copy,
  .final-copy {
    width: min(1120px, calc(100% - 32px));
    margin-inline: auto;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    font-size: 14px;
    font-weight: 800;
  }

  .topbar a {
    color: #0b1f3a;
    text-decoration: none;
  }

  .topbar span {
    color: #ff7a1a;
  }

  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 32px;
    align-items: stretch;
    padding: 56px 0 36px;
  }

  .hero-copy__text,
  .asset-slot,
  .angle-note,
  .copy-section,
  .pricing-copy,
  .final-copy {
    border: 1px solid #e5e7eb;
    background: #fff;
    border-radius: 28px;
    box-shadow: 0 20px 50px rgba(16, 24, 32, 0.06);
  }

  .hero-copy__text {
    padding: clamp(28px, 5vw, 56px);
  }

  .eyebrow,
  .kicker,
  .asset-label {
    margin: 0 0 12px;
    color: #ff7a1a;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(44px, 7vw, 82px);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .subheadline {
    max-width: 760px;
    margin: 24px 0 0;
    color: #334155;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.45;
    font-weight: 650;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
  }

  .primary {
    background: #ff7a1a;
    color: #fff;
  }

  .secondary {
    border: 1px solid #d6dae0;
    color: #101820;
  }

  .proof-line {
    margin: 28px 0 0;
    max-width: 720px;
    color: #64748b;
    font-size: 15px;
    line-height: 1.6;
  }

  .asset-slot {
    display: flex;
    min-height: 360px;
    flex-direction: column;
    justify-content: center;
    padding: 28px;
    color: #334155;
    line-height: 1.65;
    background: repeating-linear-gradient(135deg, #fff 0 18px, #f8fafc 18px 36px);
  }

  .angle-note {
    padding: 18px 22px;
    color: #334155;
    line-height: 1.55;
  }

  .sections-list {
    display: grid;
    gap: 18px;
    padding: 28px 0;
  }

  .copy-section {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 18px;
    padding: 28px;
  }

  .section-number {
    color: #cbd5e1;
    font-size: 28px;
    font-weight: 950;
  }

  h2 {
    margin: 0;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .copy-section p,
  .pricing-copy p,
  .final-copy p {
    max-width: 820px;
    color: #475569;
    font-size: 17px;
    line-height: 1.65;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 24px;
    color: #475569;
    font-size: 17px;
    line-height: 1.55;
  }

  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: #ff7a1a;
  }

  .pricing-copy,
  .final-copy {
    padding: clamp(28px, 5vw, 48px);
    margin-bottom: 28px;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 24px;
  }

  .pricing-grid article {
    border: 1px solid #e5e7eb;
    border-radius: 22px;
    padding: 20px;
    background: #f8fafc;
  }

  h3 {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .price {
    margin: 0 0 10px !important;
    color: #101820 !important;
    font-size: 30px !important;
    font-weight: 950;
    letter-spacing: -0.04em;
  }

  .final-copy {
    text-align: center;
  }

  .final-copy .primary {
    margin-top: 22px;
  }

  @media (max-width: 860px) {
    .hero-copy,
    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .copy-section {
      grid-template-columns: 1fr;
    }

    .asset-slot {
      min-height: 220px;
    }
  }
</style>
