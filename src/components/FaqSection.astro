---
interface Props {
  title?: string;
  description?: string;
  items: readonly (readonly [string, string])[];
}
const { title = 'Questions fréquentes', description = 'Les réponses aux questions les plus fréquentes.', items } = Astro.props;
---
<section class="section-pad">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-4xl font-semibold tracking-[-0.03em] text-[#262832] md:text-5xl">{title}</h2>
      <p class="mt-4 text-lg text-[#5b6170]">{description}</p>
    </div>
    <div class="mx-auto mt-12 max-w-4xl space-y-4">
      {items.map(([question, answer], index) => (
        <details class="rounded-[14px] border border-[#e8e9ea] bg-white shadow-soft" open={index === 0}>
          <summary class="cursor-pointer list-none px-6 py-5 text-base font-semibold text-[#262832] md:text-lg">{question}</summary>
          <p class="px-6 pb-6 text-[#5b6170]">{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
