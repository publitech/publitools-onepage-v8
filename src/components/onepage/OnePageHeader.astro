---
import OnePageButton from './OnePageButton.astro';

const signupUrl = 'https://app.publichantier.fr/?signup=yes';
const loginUrl = 'https://app.publichantier.fr/';
---

<header class="op-header" data-onepage-header>
  <div class="op-header__inner op-container">
    <a class="op-header__brand" href="#top" aria-label="Retour en haut de la page PubliTools">
      <img src="/brand/publitools-logo-official.svg" alt="PubliTools" width="500" height="100" />
    </a>

    <nav class="op-header__desktop-nav" aria-label="Navigation principale">
      <a href="#tarifs">Tarifs</a>
      <a href="#faq">FAQ</a>
      <OnePageButton href={signupUrl} class="op-header__cta">Démarrer gratuitement</OnePageButton>
      <a href={loginUrl}>Se connecter</a>
    </nav>

    <details class="op-header__mobile" data-mobile-menu>
      <summary aria-controls="onepage-mobile-menu" aria-label="Ouvrir le menu" data-menu-toggle>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <div class="op-mobile-menu" id="onepage-mobile-menu">
        <div class="op-mobile-menu__top">
          <span>Menu</span>
          <button type="button" aria-label="Fermer le menu" data-menu-close>×</button>
        </div>
        <nav aria-label="Navigation mobile">
          <a href="#tarifs" data-menu-link>Tarifs</a>
          <a href="#faq" data-menu-link>FAQ</a>
          <OnePageButton href={signupUrl} class="op-mobile-menu__cta">Démarrer gratuitement</OnePageButton>
          <a href={loginUrl} data-menu-link>Se connecter</a>
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  const toggle = menu?.querySelector<HTMLElement>('[data-menu-toggle]');
  const closeButton = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  const links = menu?.querySelectorAll<HTMLAnchorElement>('[data-menu-link], .op-mobile-menu__cta');

  const setMenuOpen = (open: boolean, restoreFocus = false) => {
    if (!menu || !toggle) return;
    menu.open = open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    if (open) closeButton?.focus();
    if (!open && restoreFocus) toggle.focus();
  };

  menu?.addEventListener('toggle', () => {
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(menu.open));
    toggle.setAttribute('aria-label', menu.open ? 'Fermer le menu' : 'Ouvrir le menu');
  });
  closeButton?.addEventListener('click', () => setMenuOpen(false, true));
  links?.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) setMenuOpen(false, true);
  });
</script>
