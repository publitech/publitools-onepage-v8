---
import OnePageButton from './OnePageButton.astro';
import LanguageSwitcher from '../v31/LanguageSwitcher.astro';
import { dict, type Locale, getLocaleFromPath } from '../../i18n';

const signupUrl = 'https://app.publichantier.fr/?signup=yes';
const loginUrl = 'https://app.publichantier.fr/';
const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const t = dict[locale];
const pricingHref = locale === 'fr' ? '#tarifs' : '#pricing';
const faqHref = locale === 'fr' ? '/fr/#faq' : '/en/#faq';
---

<header class="op-header" data-onepage-header>
  <div class="op-header__inner op-container">
    <a class="op-header__brand" href="#top" aria-label={t.common.siteName}>
      <img src="/brand/publitools-logo-official.svg" alt={t.common.siteName} width="500" height="100" />
    </a>

    <nav class="op-header__desktop-nav" aria-label={t.common.footer.heading}>
      <a href={pricingHref}>{t.common.nav.pricing}</a>
      <a href={faqHref}>{t.common.nav.faq}</a>
      <LanguageSwitcher locale={locale} pathname={Astro.url.pathname} />
      <OnePageButton href={signupUrl} class="op-header__cta">{t.common.nav.cta}</OnePageButton>
      <a href={loginUrl}>{t.common.nav.login}</a>
    </nav>

    <details class="op-header__mobile" data-mobile-menu>
      <summary aria-controls="onepage-mobile-menu" aria-label={t.common.language.label} data-menu-toggle>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <div class="op-mobile-menu" id="onepage-mobile-menu">
        <div class="op-mobile-menu__top">
          <span>Menu</span>
          <button type="button" aria-label={t.common.language.label} data-menu-close>×</button>
        </div>
        <nav aria-label={t.common.footer.heading}>
          <a href={pricingHref} data-menu-link>{t.common.nav.pricing}</a>
          <a href={faqHref} data-menu-link>{t.common.nav.faq}</a>
          <LanguageSwitcher locale={locale} pathname={Astro.url.pathname} />
          <OnePageButton href={signupUrl} class="op-mobile-menu__cta">{t.common.nav.cta}</OnePageButton>
          <a href={loginUrl} data-menu-link>{t.common.nav.login}</a>
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    const toggle = menu.querySelector<HTMLElement>('[data-menu-toggle]');
    const closeButton = menu.querySelector<HTMLButtonElement>('[data-menu-close]');
    const links = menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link], .op-mobile-menu__cta, .v31-lang');

    const setMenuOpen = (open: boolean, restoreFocus = false) => {
      menu.open = open;
      if (toggle) {
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      }
      if (open) closeButton?.focus();
      if (!open && restoreFocus && toggle) toggle.focus();
    };

    menu.addEventListener('toggle', () => {
      if (!toggle) return;
      toggle.setAttribute('aria-expanded', String(menu.open));
      toggle.setAttribute('aria-label', menu.open ? 'Fermer le menu' : 'Ouvrir le menu');
    });
    closeButton?.addEventListener('click', () => setMenuOpen(false, true));
    links.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) setMenuOpen(false, true);
    });
  }
</script>