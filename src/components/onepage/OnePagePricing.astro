---
import OnePageButton from './OnePageButton.astro';
import OnePageSocialLogos from './OnePageSocialLogos.astro';
import { dict, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = dict[locale];
const op = t.home.onepage;
const signupUrl = 'https://app.publichantier.fr/?signup=yes';
---

<section class="op-pricing" id="tarifs" aria-labelledby="op-pricing-title">
  <div class="op-container">
    <div class="op-section-head op-pricing__head">
      <p class="op-kicker">{op.pricing.kicker}</p>
      <h2 id="op-pricing-title">{op.pricing.title}</h2>
      <p>{op.pricing.text}</p>
    </div>
    <div class="op-pricing__grid">
      <article class="op-price-card op-price-card--starter">
        <div class="op-price-card__head">
          <p class="op-price-card__label">{op.pricing.starterName}</p>
          <h3>{op.pricing.starterDesc}</h3>
        </div>
        <ul class="op-price-card__features">
          {op.pricing.starterFeatures.map((item) => (
            <li>
              <span class="op-price-card__bullet" aria-hidden="true"></span>
              <span class="op-price-card__label-text">{item}</span>
            </li>
          ))}
        </ul>
        <OnePageSocialLogos label={locale === 'fr' ? 'Réseaux disponibles' : 'Available networks'} caption={op.pricing.starterCaption} compact pricing />
        <p class="op-price-card__price">
          <span class="op-price-card__price-kicker">{locale === 'fr' ? 'Seulement' : 'Only'}</span>
          <strong>{op.pricing.starterPrice}</strong>
          <span class="op-price-card__price-unit">{op.pricing.starterUnit}</span>
        </p>
        <OnePageButton href={signupUrl}>{op.pricing.cta}</OnePageButton>
      </article>
      <article class="op-price-card op-price-card--pro">
        <div class="op-price-card__head">
          <p class="op-price-card__label">{op.pricing.proName} <span>{op.pricing.proBadge}</span></p>
          <h3>{op.pricing.proDesc}</h3>
        </div>
        <ul class="op-price-card__features">
          {op.pricing.proFeatures.map((item) => (
            <li>
              <span class="op-price-card__bullet" aria-hidden="true"></span>
              <span class="op-price-card__label-text">{item}</span>
            </li>
          ))}
        </ul>
        <OnePageSocialLogos label={locale === 'fr' ? 'Réseaux disponibles' : 'Available networks'} caption={op.pricing.proCaption} compact pricing />
        <p class="op-price-card__price">
          <span class="op-price-card__price-kicker">{locale === 'fr' ? 'Seulement' : 'Only'}</span>
          <strong>{op.pricing.proPrice}</strong>
          <span class="op-price-card__price-unit">{op.pricing.proUnit}</span>
        </p>
        <OnePageButton href={signupUrl}>{op.pricing.cta}</OnePageButton>
      </article>
    </div>
    <p class="op-pricing__microcopy">{op.pricing.trialNote}</p>
  </div>
</section>