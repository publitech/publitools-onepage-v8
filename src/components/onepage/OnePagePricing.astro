---

<section class="op-pricing" id="tarifs" aria-labelledby="op-pricing-title">
  <div class="op-container">
    <div class="op-section-head op-pricing__head">
      <p class="op-kicker">{copy.kicker}</p>
      <h2 id="op-pricing-title"><HighlightedTitle parts={copy.titleParts} /></h2>
      <p>{copy.lead}</p>
    </div>
    <div class="op-pricing__grid">
      <article class="op-price-card op-price-card--starter">
        <div class="op-price-card__head">
          <p class="op-price-card__label">{copy.starter.label}</p>
          <h3>{copy.starter.subtitle}</h3>
        </div>
        <ul class="op-price-card__features">
          {copy.starter.features.map((item) => (
            <li>
              <span class="op-price-card__bullet" aria-hidden="true"></span>
              <span class="op-price-card__label-text">{item}</span>
            </li>
          ))}
        </ul>
        <OnePageSocialLogos label={copy.socialLabel} caption={copy.starter.socialCaption} compact pricing />
        <p class="op-price-card__price">
          <span class="op-price-card__price-kicker">{copy.onlyLabel}</span>
          <strong>{copy.starter.price}</strong>
          <span class="op-price-card__price-unit">{copy.starter.unit}</span>
        </p>
        <OnePageButton href={signupUrl}>{copy.starter.cta}</OnePageButton>
      </article>
      <article class="op-price-card op-price-card--pro">
        <div class="op-price-card__head">
          <p class="op-price-card__label">{copy.pro.label} <span>{copy.pro.badge}</span></p>
          <h3>{copy.pro.subtitle}</h3>
        </div>
        <ul class="op-price-card__features">
          {copy.pro.features.map((item) => (
            <li>
              <span class="op-price-card__bullet" aria-hidden="true"></span>
              <span class="op-price-card__label-text">{item}</span>
            </li>
          ))}
        </ul>
        <OnePageSocialLogos label={copy.socialLabel} caption={copy.pro.socialCaption} compact pricing />
        <p class="op-price-card__price">
          <span class="op-price-card__price-kicker">{copy.onlyLabel}</span>
          <strong>{copy.pro.price}</strong>
          <span class="op-price-card__price-unit">{copy.pro.unit}</span>
        </p>
        <OnePageButton href={signupUrl}>{copy.pro.cta}</OnePageButton>
      </article>
    </div>
    <p class="op-pricing__microcopy">{copy.trialNote}</p>
  </div>
</section>