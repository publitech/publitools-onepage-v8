---
import { Image } from 'astro:assets';
import chantierFini from '../../assets/onepage/backgrounds/personalize-chantier-v1.png';
import identityVisuelle from '../../assets/onepage/personalize/identity-visuelle.png';
import styleTexte from '../../assets/onepage/personalize/style-texte.png';
import HighlightedTitle, { type TitlePart } from './HighlightedTitle.astro';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;

const copy = {
  fr: {
    kicker: '01 — Personnaliser',
    titleParts: [
      { text: 'Personnalisez', style: 'orange' },
      { text: ' votre ' },
      { text: 'IA', style: 'underline' },
      { text: ' aux couleurs de votre ' },
      { text: 'entreprise', style: 'underline' },
    ] as TitlePart[],
    lead: "Ajoutez votre logo, vos couleurs, le ton que vous souhaitez utiliser et plein d'autres personnalisations, simple à mettre en place.",
    configuredName: 'Structor',
    configuredStatus: 'Entreprise configurée',
  },
  en: {
    kicker: '01 — Personalize',
    titleParts: [
      { text: 'Customize', style: 'orange' },
      { text: ' your ' },
      { text: 'AI', style: 'underline' },
      { text: ' with your ' },
      { text: "company's colors", style: 'underline' },
    ] as TitlePart[],
    lead: 'Add your logo, your colors, the tone you want to use, and plenty of other customizations — simple to set up.',
    configuredName: 'Structor',
    configuredStatus: 'Company configured',
  },
  es: {
    kicker: '01 — Personalizar',
    titleParts: [
      { text: 'Personaliza', style: 'orange' },
      { text: ' tu ' },
      { text: 'IA', style: 'underline' },
      { text: ' con los colores de tu ' },
      { text: 'empresa', style: 'underline' },
    ] as TitlePart[],
    lead: 'Añade tu logo, tus colores, el tono que quieras utilizar y muchas otras personalizaciones, fáciles de configurar.',
    configuredName: 'Structor',
    configuredStatus: 'Empresa configurada',
  },
  de: {
    kicker: '01 — Personalisieren',
    titleParts: [
      { text: 'Personalisieren Sie', style: 'orange' },
      { text: ' Ihre ' },
      { text: 'KI', style: 'underline' },
      { text: ' in den Farben Ihres ' },
      { text: 'Unternehmens', style: 'underline' },
    ] as TitlePart[],
    lead: 'Fügen Sie Ihr Logo, Ihre Farben, den gewünschten Ton und viele weitere Anpassungen hinzu – ganz einfach einzurichten.',
    configuredName: 'Structor',
    configuredStatus: 'Unternehmen konfiguriert',
  },
}[locale];
---

<section class="op-personalize" aria-labelledby="op-personalize-title">
  <div class="op-grid op-container op-personalize__grid">
    <div class="op-personalize__copy">
      <p class="op-kicker">{copy.kicker}</p>
      <h2 id="op-personalize-title"><HighlightedTitle parts={copy.titleParts} /></h2>
      <p>{copy.lead}</p>
    </div>

    <div class="op-personalize__visual">
      <figure class="op-personalize__chantier">
        <Image src={chantierFini} alt="Artisan configurant son IA depuis son téléphone sur un chantier" loading="lazy" decoding="async" />
      </figure>
      <p class="op-personalize__configured">
        <img
          src="/assets/onepage/structor-logo.png"
          alt=""
          aria-hidden="true"
          width="1024"
          height="1024"
          loading="lazy"
          decoding="async"
        />
        <span class="op-personalize__configured-text">
          <span class="op-personalize__configured-name">{copy.configuredName}</span>
          <span class="op-personalize__configured-status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {copy.configuredStatus}
          </span>
        </span>
      </p>
      <img
        class="op-personalize__structor"
        src="/brand/structor-icon.svg"
        alt="Structor"
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
      />
      <figure class="op-personalize__card op-personalize__card--identity">
        <Image src={identityVisuelle} alt="Écran réel : identité visuelle (logo et couleur principale)" loading="lazy" decoding="async" />
      </figure>
      <figure class="op-personalize__card op-personalize__card--style">
        <Image src={styleTexte} alt="Écran réel : style de texte (ton de rédaction)" loading="lazy" decoding="async" />
      </figure>
    </div>
  </div>
</section>