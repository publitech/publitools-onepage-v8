const deQuestions = [
  [
    'Ist die Testphase wirklich kostenlos?',
    'Ja. Sie erhalten 14 Tage kostenlosen Test mit vollem Zugriff auf den Pro-Plan. Es fallen keine Einrichtungsgebühren an.',
  ],
  [
    'Was, wenn ich nicht technisch versiert bin?',
    'Sie müssen kein Digitalprofi sein. Sie laden Ihre Baustellenfotos/-videos hoch und beschreiben Ihre Arbeiten per Sprachnachricht oder Text: Die KI schreibt den Beitrag, bearbeitet Ihre Fotos und fügt Ihr Logo und Ihre Farben hinzu.',
  ],
  [
    'Wie lange dauert es, einen Beitrag vorzubereiten?',
    'Weniger als 2 Minuten für einen einfachen, validierungsbereiten Beitrag. Sie machen alles direkt von der Baustelle aus mit Ihrem Smartphone.',
  ],
  [
    'Entsprechen die Beiträge dem Image meines Unternehmens?',
    'Ja. Die KI bearbeitet Ihre Fotos, fügt Logo und Farben hinzu und respektiert dabei den Ton Ihres Unternehmens, der bei der Kontoeröffnung konfiguriert wurde. Bei Videos wird eine leichte Bearbeitung angewendet.',
  ],
  [
    'Behalte ich die Kontrolle darüber, was veröffentlicht wird?',
    'Sie sehen alles, bevor es veröffentlicht wird. Die App zeigt Ihnen eine vollständige Vorschau, die Sie vor der Validierung prüfen und ändern können.',
  ],
  [
    'Ist es wirklich nützlich für meinen Baubetrieb?',
    'Ihre zukünftigen Kunden suchen nach Beweisen für Ihre Arbeit, bevor sie ein Angebot annehmen. PubliTools pflegt regelmäßig Ihre Konten und Ihr Google-Business-Profil, um Ihre Baustellen zu präsentieren und Interessenten zu überzeugen.',
  ],
  [
    'Welche Ergebnisse wurden bei Handwerksbetrieben beobachtet?',
    'Beobachtete Ergebnisse bei mehr als 50 Betrieben nach 3 Monaten zeigen bis zu 40 % mehr Angebotsanfragen und bis zu 600 % mehr Aufrufe bei Baustellenbeiträgen. Die Ergebnisse variieren je nach Betrieb, Tätigkeit und Region.',
  ],
  [
    'Wie wird die Vertraulichkeit meiner Baustellen geschützt?',
    'Sie wählen selbst aus, welche Fotos/Videos Sie in die App aufnehmen. Nichts wird ohne Ihre vorherige Prüfung veröffentlicht.',
  ],
  [
    'Ist es schwierig, meine sozialen Netzwerke zu verbinden?',
    'Die Verbindung wird einmalig bei der Einrichtung Ihres Kontos hergestellt. PubliTools verwaltet 6 Netzwerke inklusive Google: Facebook, Instagram, LinkedIn, Google Business, TikTok und YouTube.',
  ],
  [
    'Wie funktioniert die Kundenbewertungsanfrage?',
    'PubliTools erstellt eine vorformulierte SMS mit dem Link zu Ihrem Google-Business-Profil. Die Nachrichten-App Ihres Smartphones öffnet sich automatisch und Sie senden die Nachricht selbst an Ihren Kunden.',
  ],
  [
    'Was passiert nach den 14 Tagen kostenloser Testphase?',
    'Am Ende der 14-tägigen kostenlosen Testphase wechselt Ihr Abonnement auf den Plan, den Sie bei der Aktivierung gewählt haben.',
  ],
];

const copy = {
  fr: {
    kicker: 'FAQ',
    title: 'Les réponses avant de commencer.',
    lead: "Des explications simples sur l'essai, les photos, les vidéos et les deux formules.",
    questions: frQuestions,
  },
  en: {
    kicker: 'FAQ',
    title: 'The answers before you start.',
    lead: 'Simple explanations about the trial, photos, videos and the two plans.',
    questions: enQuestions,
  },
  es: {
    kicker: 'FAQ',
    title: 'Las respuestas antes de empezar.',
    lead: 'Explicaciones sencillas sobre la prueba, las fotos, los vídeos y los dos planes.',
    questions: esQuestions,
  },
  de: {
    kicker: 'FAQ',
    title: 'Die Antworten vor dem Start.',
    lead: 'Einfache Erklärungen zur Testphase, zu Fotos, Videos und den beiden Plänen.',
    questions: deQuestions,
  },
}[locale];
---

<section class="op-faq" id="faq" aria-labelledby="op-faq-title">
  <div class="op-container op-faq__grid">
    <div class="op-section-head op-faq__head">
      <p class="op-kicker">{copy.kicker}</p>
      <h2 id="op-faq-title">{copy.title}</h2>
      <p>{copy.lead}</p>
    </div>
    <div class="op-faq__list">
      {copy.questions.map(([question, answer], index) => (
        <details open={index === 0}>
          <summary>{question}<span aria-hidden="true">+</span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>