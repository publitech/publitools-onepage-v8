---
import OnePageButton from './OnePageButton.astro';
import OnePageSocialLogos from './OnePageSocialLogos.astro';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const signupUrl = `https://app.publitools.ai/${locale}/signup`;

const copy = {
  fr: {
    eyebrow: 'Powered by IA',
    h1: "L'outil N°1 du BTP pour automatiser vos réseaux sociaux",
    lead: '1 photo. 1 vocal. Et vos photos chantiers sont partout.',
    primaryCta: "Démarrer mes 14 jours d'essai gratuit",
    secondaryCta: 'Voir les tarifs',
    socialLabel: 'Publiez là où vos clients vous cherchent',
  },
  en: {
    eyebrow: 'Powered by AI',
    h1: 'The #1 AI Social Media Tool Built for Contractors & Trade Businesses',
    lead: '1 jobsite photo + a 20-second voice note. PubliTools writes, edits, and posts across 6 networks in under 2 minutes.',
    primaryCta: 'Start my free 14-day trial',
    secondaryCta: 'See pricing',
    socialLabel: 'Publish where your customers look for you',
  },
  es: {
    eyebrow: 'Impulsado por IA',
    h1: 'La herramienta n.º 1 de la construcción para automatizar tus redes sociales',
    lead: '1 foto. 1 nota de voz. Y tus fotos de obra están en todas partes.',
    primaryCta: 'Empieza mi prueba gratuita de 14 días',
    secondaryCta: 'Ver tarifas',
    socialLabel: 'Publica donde tus clientes te buscan',
  },
  de: {
    eyebrow: 'Powered by KI',
    h1: 'Das KI-Tool Nr. 1 fürs Bauhandwerk, um Ihre sozialen Netzwerke zu automatisieren',
    lead: '1 Foto. 1 Sprachnachricht. Und Ihre Baustellenfotos sind überall.',
    primaryCta: 'Jetzt 14 Tage kostenlos testen',
    secondaryCta: 'Preise ansehen',
    socialLabel: 'Veröffentlichen Sie dort, wo Ihre Kunden Sie suchen',
  },
}[locale];
---

<section class="op-hero op-hero-v4" id="top" aria-labelledby="op-hero-title">
  <div class="op-hero__grid op-grid op-container">
    <div class="op-hero__copy">
      <p class="op-eyebrow"><span aria-hidden="true"></span>{copy.eyebrow}</p>
      <h1 id="op-hero-title">{copy.h1}</h1>
      <p class="op-hero__lead">{copy.lead}</p>
      <OnePageSocialLogos label={copy.socialLabel} />
      <div class="op-actions">
        <OnePageButton href={signupUrl}>{copy.primaryCta}</OnePageButton>
        <OnePageButton href="#tarifs" variant="secondary">{copy.secondaryCta}</OnePageButton>
      </div>
    </div>

    <div class="op-hero-v4__visual">
      <figure class="op-hero-v4__artisan">
        <img
          src="/assets/onepage/hero-parquet-peintre.png"
          alt="Artisan prenant en photo un chantier de rénovation avec parquet en point de hongrie"
          width="1024"
          height="1280"
          loading="eager"
          decoding="async"
        />
      </figure>
      <figure class="op-hero-v4__fragment op-hero-v4__fragment--dashboard">
        <img
          src="/assets/onepage/hero-app-dashboard.png"
          alt="Tableau de bord de l'application Structor"
          width="390"
          height="844"
          loading="eager"
          decoding="async"
        />
      </figure>
      <figure class="op-hero-v4__fragment op-hero-v4__fragment--config">
        <img
          src="/assets/onepage/hero-app-config-ia.png"
          alt="Configuration de l'IA en cours dans l'application Structor"
          width="339"
          height="325"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="op-hero-v4__fragment op-hero-v4__fragment--banner">
        <img
          src="/assets/onepage/hero-app-banner.jpeg"
          alt="Capture d'écran complémentaire de l'application PubliTools"
          width="640"
          height="233"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>