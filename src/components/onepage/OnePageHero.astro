---
import { Image } from 'astro:assets';
import publicationPreview from '../../assets/onepage/ui/publication-preview.png';
import recordVocal from '../../assets/onepage/ui/record-vocal.png';
import OnePageButton from './OnePageButton.astro';
import OnePageSocialLogos from './OnePageSocialLogos.astro';

const signupUrl = 'https://app.publichantier.fr/?signup=yes';
---

<section class="op-hero op-hero-v4" id="top" aria-labelledby="op-hero-title">
  <div class="op-hero__grid op-grid op-container">
    <div class="op-hero__copy">
      <p class="op-eyebrow"><span aria-hidden="true"></span>Powered by IA</p>
      <h1 id="op-hero-title">L'outil N°1 du BTP pour automatiser vos réseaux sociaux</h1>
      <p class="op-hero__lead">1 photo. 1 vocal. Et vos photos chantiers sont partout.</p>
      <OnePageSocialLogos />
      <div class="op-actions">
        <OnePageButton href={signupUrl}>Démarrer mes 14 jours d'essai gratuit</OnePageButton>
        <OnePageButton href="#tarifs" variant="secondary">Voir les tarifs</OnePageButton>
      </div>
    </div>

    <div class="op-hero-v4__visual">
      <figure class="op-hero-v4__artisan">
        <img
          src="/assets/onepage/hero-artisan-v4.webp"
          alt="Artisan dans un chantier de rénovation"
          width="960"
          height="1200"
          loading="eager"
          decoding="async"
        />
      </figure>
      <figure class="op-hero-v4__fragment op-hero-v4__fragment--vocal">
        <Image src={recordVocal} alt="Enregistrement vocal dans PubliTools" loading="eager" decoding="async" />
      </figure>
      <figure class="op-hero-v4__fragment op-hero-v4__fragment--preview">
        <Image src={publicationPreview} alt="Aperçu d'une publication dans PubliTools" loading="eager" decoding="async" />
      </figure>
    </div>
  </div>
</section>
