---
import OnePageButton from './OnePageButton.astro';
import { dict, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = dict[locale];
const op = t.home.onepage;
const signupUrl = t.common.nav.ctaHref;
---

<section class="op-final-cta" aria-labelledby="op-final-cta-title">
  <div class="op-container op-final-cta__inner">
    <div>
      <p class="op-kicker op-kicker--light">{op.finalCta.kicker}</p>
      <h2 id="op-final-cta-title">{op.finalCta.title}</h2>
      <p>{op.finalCta.text}</p>
    </div>
    <OnePageButton href={signupUrl}>{op.finalCta.cta}</OnePageButton>
  </div>
</section>