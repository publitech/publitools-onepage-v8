---
import OnePageButton from './OnePageButton.astro';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const signupUrl = 'https://app.publichantier.fr/?signup=yes';

const copy = {
  fr: {
    kicker: 'Votre prochain chantier suffit pour commencer',
    title: 'Testez PubliTools pendant 14 jours.',
    lead: "Accédez au plan Pro complet pendant l'essai, puis continuez avec le plan choisi.",
    cta: "Démarrer mes 14 jours d'essai gratuit",
  },
  en: {
    kicker: 'Your next job is enough to get started',
    title: 'Test PubliTools for 14 days.',
    lead: 'Get full access to the Pro plan during the trial, then continue with the plan you chose.',
    cta: 'Start my free 14-day trial',
  },
  es: {
    kicker: 'Tu próxima obra basta para empezar',
    title: 'Prueba PubliTools durante 14 días.',
    lead: 'Accede al plan Pro completo durante la prueba y continúa con el plan elegido.',
    cta: 'Empieza mi prueba gratuita de 14 días',
  },
  de: {
    kicker: 'Ihre nächste Baustelle reicht zum Start',
    title: 'Testen Sie PubliTools 14 Tage lang.',
    lead: 'Voller Zugriff auf den Pro-Plan während des Tests, danach weiter mit dem gewählten Plan.',
    cta: 'Jetzt 14 Tage kostenlos testen',
  },
}[locale];
---

<section class="op-final-cta" aria-labelledby="op-final-cta-title">
  <div class="op-container op-final-cta__inner">
    <div>
      <p class="op-kicker op-kicker--light">{copy.kicker}</p>
      <h2 id="op-final-cta-title">{copy.title}</h2>
      <p>{copy.lead}</p>
    </div>
    <OnePageButton href={signupUrl}>{copy.cta}</OnePageButton>
  </div>
</section>