---
import OnePageButton from './OnePageButton.astro';
const signupUrl = 'https://app.publichantier.fr/?signup=yes';
---

<section class="op-final-cta" aria-labelledby="op-final-cta-title">
  <div class="op-container op-final-cta__inner">
    <div>
      <p class="op-kicker op-kicker--light">Votre prochain chantier suffit pour commencer</p>
      <h2 id="op-final-cta-title">Testez PubliTools pendant 14 jours.</h2>
      <p>Accédez au plan Pro complet pendant l’essai, puis continuez avec le plan choisi.</p>
    </div>
    <OnePageButton href={signupUrl}>Démarrer mes 14 jours d'essai gratuit</OnePageButton>
  </div>
</section>
