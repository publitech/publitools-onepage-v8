---
import { dict, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = dict[locale];
const op = t.home.onepage;

const cases = [
  { id: 'renovation', label: locale === 'fr' ? 'Rénovation' : 'Renovation', title: locale === 'fr' ? "Rénovation d'appartement" : 'Apartment renovation' },
  { id: 'maconnerie', label: locale === 'fr' ? 'Maçonnerie' : 'Masonry', title: locale === 'fr' ? "Construction d'un mur en parpaings" : 'Building a cinder block wall' },
  { id: 'plomberie', label: locale === 'fr' ? 'Plomberie' : 'Plumbing', title: locale === 'fr' ? "Installation de plomberie en salle de bain" : 'Bathroom plumbing installation' },
  { id: 'electricien', label: locale === 'fr' ? 'Électricien' : 'Electrician', title: locale === 'fr' ? "Travaux d'installation électrique" : 'Electrical installation work' },
  { id: 'couvreur', label: locale === 'fr' ? 'Couvreur' : 'Roofer', title: locale === 'fr' ? "Rénovation de toiture" : 'Roof renovation' },
  { id: 'menuiserie', label: locale === 'fr' ? 'Menuiserie' : 'Carpentry', title: locale === 'fr' ? "Pose de menuiserie" : 'Joinery installation' },
  { id: 'peinture', label: locale === 'fr' ? 'Peinture' : 'Painting', title: locale === 'fr' ? "Peinture intérieure" : 'Interior painting' },
  { id: 'carrelage', label: locale === 'fr' ? 'Carrelage' : 'Tiling', title: locale === 'fr' ? "Pose de carrelage" : 'Tile laying' },
  { id: 'plaquiste', label: locale === 'fr' ? 'Plaquiste' : 'Drywall', title: locale === 'fr' ? "Pose de cloisons en plaques de plâtre" : 'Drywall partition installation' },
  { id: 'chauffagiste', label: locale === 'fr' ? 'Chauffagiste' : 'Heating', title: locale === 'fr' ? "Installation de chauffage" : 'Heating installation' },
].map((item) => ({
  ...item,
  before: `/assets/onepage/smartai-v6/${item.id}-before.jpg`,
  after: `/assets/onepage/smartai-v6/${item.id}-after.jpg`,
}));
---

<section class="op-smartai op-smartai-v4" aria-labelledby="op-smartai-title" data-smartai-lab>
  <div class="op-container op-smartai-v4__layout">
    <div class="op-smartai-v4__side">
      <header class="op-smartai__head">
        <p class="op-kicker">{op.smartai.kicker}</p>
        <h2 id="op-smartai-title">{op.smartai.title}</h2>
        <p>{op.smartai.text}</p>
      </header>

      <div class="op-smartai__tabs" role="tablist" aria-label={locale === 'fr' ? 'Choisir un métier' : 'Choose a trade'}>
        {cases.map((item, index) => (
          <button
            type="button"
            role="tab"
            id={`op-smartai-tab-${item.id}`}
            aria-controls={`op-smartai-panel-${item.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-case={item.id}
          >
            {item.label}
          </button>
        ))}
      </div>
    </div>

    <div class="op-smartai-v4__stage">
      {cases.map((item, index) => (
        <article
          class="op-smartai__panel"
          id={`op-smartai-panel-${item.id}`}
          role="tabpanel"
          aria-labelledby={`op-smartai-tab-${item.id}`}
          data-panel={item.id}
          data-view="before"
        >
          <h3>{item.title}</h3>
          <div class="op-smartai-v4__toggle" role="group" aria-label={locale === 'fr' ? `Afficher la photo avant ou après pour ${item.label}` : `Show before or after photo for ${item.label}`}>
            <button type="button" aria-pressed="true" data-view-button="before">{locale === 'fr' ? 'Avant' : 'Before'}</button>
            <button type="button" aria-pressed="false" data-view-button="after">{locale === 'fr' ? 'Après' : 'After'}</button>
          </div>
          <div class="op-smartai__compare">
            <figure class="op-smartai__figure op-smartai__figure--before">
              <img src={item.before} alt={`${item.title} ${locale === 'fr' ? 'avant amélioration photographique' : 'before photo enhancement'}`} width="1200" height="900" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              <figcaption>{locale === 'fr' ? 'Avant' : 'Before'}</figcaption>
            </figure>
            <figure class="op-smartai__figure op-smartai__figure--after">
              <img src={item.after} alt={`${item.title} ${locale === 'fr' ? 'après amélioration photographique' : 'after photo enhancement'}`} width="1200" height="900" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              <figcaption>{locale === 'fr' ? 'Après' : 'After'}</figcaption>
            </figure>
          </div>
        </article>
      ))}
    </div>

    <p class="op-smartai__notice">{op.smartai.notice}</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-smartai-lab]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const setView = (panel: HTMLElement, view: 'before' | 'after') => {
      panel.dataset.view = view;
      panel.querySelectorAll<HTMLButtonElement>('[data-view-button]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.viewButton === view));
      });
    };

    const activateCase = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.case === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
    };

    root.classList.add('is-enhanced');
    panels.forEach((panel) => setView(panel, 'before'));
    activateCase(tabs[0]?.dataset.case || 'renovation');

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateCase(tab.dataset.case || 'renovation'));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
        activateCase(tabs[nextIndex].dataset.case || 'renovation', true);
      });
    });

    panels.forEach((panel) => {
      panel.querySelectorAll<HTMLButtonElement>('[data-view-button]').forEach((button) => {
        button.addEventListener('click', () => setView(panel, button.dataset.viewButton === 'before' ? 'before' : 'after'));
      });
    });
  });
</script>