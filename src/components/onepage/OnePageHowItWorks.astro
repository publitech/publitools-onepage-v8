---
import { Image } from 'astro:assets';
import uploadMedia from '../../assets/onepage/ui/upload-media.png';
import recordVocal from '../../assets/onepage/ui/record-vocal-v7.png';
import publishNetworks from '../../assets/onepage/ui/publish-networks-v7.jpeg';
import publishTiming from '../../assets/onepage/ui/publish-timing-v7.jpeg';
import electricienVocal from '../../assets/onepage/backgrounds/electricien-vocal.png';
import OnePageSocialLogos from './OnePageSocialLogos.astro';
import OnePageSmartAiLab from './OnePageSmartAiLab.astro';
import OnePageButton from './OnePageButton.astro';
import HighlightedTitle, { type TitlePart } from './HighlightedTitle.astro';
import { type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const signupUrl = 'https://app.publichantier.fr/?signup=yes';

const copy = {
  fr: {
    inputs: {
      kicker: '02 — Vos chantiers',
      titleParts: [
        { text: 'Ajoutez vos ' },
        { text: 'photos / vidéos', style: 'blue' },
        { text: ' + ' },
        { text: '1 vocal', style: 'underline' },
        { text: ' (30sec)' },
      ] as TitlePart[],
      lead: 'Depuis votre chantier ou chez vous, importez vos réalisations puis décrivez rapidement à voix haute ce que vous avez fait .',
      photoCaption: 'Photo',
      vocalCaption: 'Vocal · 10 secondes',
      ctaMobile: 'Voir les tarifs',
    },
    publish: {
      kicker: '04 — Validation & publication',
      titleParts: [
        { text: 'Publiez en ' },
        { text: '1 clic', style: 'orange' },
        { text: ' sur tous vos réseaux.' },
      ] as TitlePart[],
      lead: 'Choisissez vos comptes connectés, vérifiez la publication puis publiez tout depuis le même endroit.',
      socialLabel: '6 plateformes disponibles',
      cta: 'Lancer mes 14 jours gratuits',
    },
  },
  en: {
    inputs: {
      kicker: '02 — Your jobs',
      titleParts: [
        { text: 'Add your ' },
        { text: 'photos / videos', style: 'blue' },
        { text: ' + ' },
        { text: '1 voice note', style: 'underline' },
        { text: ' (30sec)' },
      ] as TitlePart[],
      lead: 'From the job, import your recent work, then describe what you did, out loud.',
      photoCaption: 'Photo',
      vocalCaption: 'Voice note · 10 seconds',
      ctaMobile: 'See pricing',
    },
    publish: {
      kicker: '04 — Validation & publishing',
      titleParts: [
        { text: 'Publish in ' },
        { text: '1 click', style: 'orange' },
        { text: ' to your 6 networks, including Google Business.' },
      ] as TitlePart[],
      lead: 'Your social media post is sent at once to Facebook, Instagram, LinkedIn, Google Business, TikTok and YouTube.',
      socialLabel: '6 platforms available',
      cta: 'Start my free 14-day trial',
    },
  },
}[locale];
---

<section class="op-step op-step--inputs" aria-labelledby="op-inputs-title">
  <div class="op-container op-inputs-v3">
    <div class="op-step__copy">
      <p class="op-kicker">{copy.inputs.kicker}</p>
      <h2 id="op-inputs-title"><HighlightedTitle parts={copy.inputs.titleParts} /></h2>
      <p>{copy.inputs.lead}</p>
      <a class="op-button op-button--ghost-light op-inputs-v3__cta-mobile" href="#tarifs">{copy.inputs.ctaMobile}</a>
    </div>
    <div class="op-inputs-v3__proof" style={`--op-proof-background: url("${electricienVocal.src}")`}>
      <figure class="op-inputs-v3__shot op-inputs-v3__shot--upload">
        <Image src={uploadMedia} alt="Zone réelle pour ajouter des photos et vidéos" loading="lazy" decoding="async" />
        <figcaption>{copy.inputs.photoCaption}</figcaption>
      </figure>
      <figure class="op-inputs-v3__shot op-inputs-v3__shot--vocal">
        <Image src={recordVocal} alt="Bouton réel pour enregistrer un vocal" loading="lazy" decoding="async" />
        <figcaption>{copy.inputs.vocalCaption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<OnePageSmartAiLab locale={locale} />

<section class="op-step op-step--publish" aria-labelledby="op-publish-title">
  <div class="op-grid op-container op-step__grid">
    <div class="op-step__copy op-step__copy--left">
      <p class="op-kicker op-kicker--light">{copy.publish.kicker}</p>
      <h2 id="op-publish-title"><HighlightedTitle parts={copy.publish.titleParts} /></h2>
      <p>{copy.publish.lead}</p>
      <OnePageSocialLogos label={copy.publish.socialLabel} onDark={true} compact={true} />
    </div>
    <div class="op-publish-composition">
      <div class="op-publish-composition__networks">
        <Image src={publishNetworks} alt="Écran réel On publie où ? avec les comptes sélectionnables" loading="lazy" decoding="async" />
      </div>
      <div class="op-publish-composition__timing">
        <Image src={publishTiming} alt="Écran réel de publication immédiate ou planifiée" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
  <div class="op-publish__cta">
    <OnePageButton href={signupUrl}>{copy.publish.cta}</OnePageButton>
  </div>
</section>