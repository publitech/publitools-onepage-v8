---
import OnePageButton from '../OnePageButton.astro';
const signupUrl = 'https://app.publichantier.fr/?signup=yes';
---

<section class="op-final-cta" aria-labelledby="op-final-cta-title">
  <div class="op-container op-final-cta__inner">
    <div>
      <p class="op-kicker op-kicker--light">Your next jobsite is enough to get started</p>
      <h2 id="op-final-cta-title">Try PubliTools for 14 days.</h2>
      <p>Get full Pro plan access during your trial, then keep the plan you chose.</p>
    </div>
    <OnePageButton href={signupUrl}>Start my free 14-day trial</OnePageButton>
  </div>
</section>