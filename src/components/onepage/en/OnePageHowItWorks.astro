---
import { Image } from 'astro:assets';
import uploadMedia from '../../../assets/onepage/ui/upload-media.png';
import recordVocal from '../../../assets/onepage/ui/record-vocal-v7.png';
import publishNetworks from '../../../assets/onepage/ui/publish-networks-v7.jpeg';
import publishTiming from '../../../assets/onepage/ui/publish-timing-v7.jpeg';
import electricienVocal from '../../../assets/onepage/backgrounds/electricien-vocal.png';
import OnePageSocialLogos from '../OnePageSocialLogos.astro';
import OnePageSmartAiLab from './OnePageSmartAiLab.astro';
import OnePageButton from '../OnePageButton.astro';

const signupUrl = 'https://app.publichantier.fr/?signup=yes';
---

<section class="op-step op-step--inputs" aria-labelledby="op-inputs-title">
  <div class="op-container op-inputs-v3">
    <div class="op-step__copy">
      <p class="op-kicker">02 — Your jobsites</p>
      <h2 id="op-inputs-title">Add your <span class="box-decoration-clone rounded-lg bg-[#00518f] px-2 py-0 text-white">photos / videos</span> + <span class="underline">1 voice note</span> (30 sec)</h2>
      <p>From the job, import your recent work, then describe what you did — out loud.</p>
      <a class="op-button op-button--ghost-light op-inputs-v3__cta-mobile" href="#pricing">See pricing</a>
    </div>
    <div class="op-inputs-v3__proof" style={`--op-proof-background: url("${electricienVocal.src}")`}>
      <figure class="op-inputs-v3__shot op-inputs-v3__shot--upload">
        <Image src={uploadMedia} alt="Real area to add photos and videos" loading="lazy" decoding="async" />
        <figcaption>Photo</figcaption>
      </figure>
      <figure class="op-inputs-v3__shot op-inputs-v3__shot--vocal">
        <Image src={recordVocal} alt="Real button to record a voice note" loading="lazy" decoding="async" />
        <figcaption>Voice note · 10 seconds</figcaption>
      </figure>
    </div>
  </div>
</section>

<OnePageSmartAiLab />

<section class="op-step op-step--publish" aria-labelledby="op-publish-title">
  <div class="op-grid op-container op-step__grid">
    <div class="op-step__copy op-step__copy--left">
      <p class="op-kicker op-kicker--light">04 — Review & publish</p>
      <h2 id="op-publish-title">Publish in <span class="box-decoration-clone rounded-lg bg-[#f4862d] px-2 py-0 text-white">1 click</span> to all your networks.</h2>
      <p>Choose your connected accounts, review the post, then publish everything from one place.</p>
      <OnePageSocialLogos label="6 platforms available" onDark={true} compact={true} />
    </div>
    <div class="op-publish-composition">
      <div class="op-publish-composition__networks">
        <Image src={publishNetworks} alt="Real screen showing selectable accounts to publish to" loading="lazy" decoding="async" />
      </div>
      <div class="op-publish-composition__timing">
        <Image src={publishTiming} alt="Real screen for immediate or scheduled publishing" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
  <div class="op-publish__cta">
    <OnePageButton href={signupUrl}>Start my free 14-day trial</OnePageButton>
  </div>
</section>