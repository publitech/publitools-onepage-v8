---
import OnePageButton from '../OnePageButton.astro';

const signupUrl = 'https://app.publichantier.fr/?signup=yes';
const loginUrl = 'https://app.publichantier.fr/';
---

<header class="op-header" data-onepage-header>
  <div class="op-header__inner op-container">
    <a class="op-header__brand" href="#top" aria-label="Back to the top of the PubliTools page">
      <img src="/brand/publitools-logo-official.svg" alt="PubliTools" width="500" height="100" />
    </a>

    <nav class="op-header__desktop-nav" aria-label="Main navigation">
      <a href="#pricing">Pricing</a>
      <a href="#faq">FAQ</a>
      <OnePageButton href={signupUrl} class="op-header__cta">Start for free</OnePageButton>
      <a href={loginUrl}>Sign in</a>
      <a class="op-lang-switch" href="/fr/" hreflang="fr" lang="fr" aria-label="Passer en français">
        <svg viewBox="0 0 60 40" aria-hidden="true" focusable="false"><rect width="20" height="40" fill="#0055A4"/><rect x="20" width="20" height="40" fill="#fff"/><rect x="40" width="20" height="40" fill="#EF4135"/></svg>
        <span>FR</span>
      </a>
    </nav>

    <details class="op-header__mobile" data-mobile-menu>
      <summary aria-controls="onepage-mobile-menu" aria-label="Open the menu" data-menu-toggle>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <div class="op-mobile-menu" id="onepage-mobile-menu">
        <div class="op-mobile-menu__top">
          <span>Menu</span>
          <button type="button" aria-label="Close the menu" data-menu-close>×</button>
        </div>
        <nav aria-label="Mobile navigation">
          <a href="#pricing" data-menu-link>Pricing</a>
          <a href="#faq" data-menu-link>FAQ</a>
          <OnePageButton href={signupUrl} class="op-mobile-menu__cta">Start for free</OnePageButton>
          <a href={loginUrl} data-menu-link>Sign in</a>
          <a class="op-lang-switch" href="/fr/" hreflang="fr" lang="fr" data-menu-link aria-label="Passer en français">
            <svg viewBox="0 0 60 40" aria-hidden="true" focusable="false"><rect width="20" height="40" fill="#0055A4"/><rect x="20" width="20" height="40" fill="#fff"/><rect x="40" width="20" height="40" fill="#EF4135"/></svg>
            <span>FR — Version française</span>
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .op-lang-switch {
    gap: 8px;
  }

  .op-lang-switch svg {
    width: 22px;
    height: 15px;
    flex: 0 0 auto;
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(38, 40, 50, 0.14);
  }

  .op-mobile-menu .op-lang-switch {
    gap: 10px;
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  const toggle = menu?.querySelector<HTMLElement>('[data-menu-toggle]');
  const closeButton = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  const links = menu?.querySelectorAll<HTMLAnchorElement>('[data-menu-link], .op-mobile-menu__cta');

  const setMenuOpen = (open: boolean, restoreFocus = false) => {
    if (!menu || !toggle) return;
    menu.open = open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu');
    if (open) closeButton?.focus();
    if (!open && restoreFocus) toggle.focus();
  };

  menu?.addEventListener('toggle', () => {
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(menu.open));
    toggle.setAttribute('aria-label', menu.open ? 'Close the menu' : 'Open the menu');
  });
  closeButton?.addEventListener('click', () => setMenuOpen(false, true));
  links?.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) setMenuOpen(false, true);
  });
</script>