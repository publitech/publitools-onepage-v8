---
const socialOutputs = [
  { network: 'Instagram', key: 'instagram', icon: '/social/instagram-official.svg', src: '/assets/onepage/mockups-v8/mockup-instagram.jpg' },
  { network: 'Facebook', key: 'facebook', icon: '/social/facebook-official.svg', src: '/assets/onepage/mockups-v8/mockup-facebook.jpg' },
  { network: 'TikTok', key: 'tiktok', icon: '/social/tiktok-official.svg', src: '/assets/onepage/mockups-v8/mockup-tiktok.jpg' },
  { network: 'LinkedIn', key: 'linkedin', icon: '/social/linkedin-official.svg', src: '/assets/onepage/mockups-v8/mockup-linkedin.jpg' },
  { network: 'Google Business', key: 'google', icon: '/social/google-official.svg', src: '/assets/onepage/mockups-v8/mockup-google.jpg' },
  { network: 'YouTube', key: 'youtube', icon: '/social/youtube-official.svg', src: '/assets/onepage/mockups-v8/mockup-youtube.jpg' },
];

type ResultTone = 'orange' | 'navy' | 'yellow';

const resultCards: Array<{
  image: string;
  alt: string;
  title: string;
  tone: ResultTone;
}> = [
  {
    image: '/assets/onepage/results/tableau-de-bord-instagram.jpg',
    alt: 'Professional Instagram dashboard with views and reach statistics',
    title: 'Up to +600% views on social media',
    tone: 'orange',
  },
  {
    image: '/assets/onepage/results/google-positions-publitools.jpg',
    alt: 'Google Business ranking progress curve over 6 months',
    title: '+12 positions on Google',
    tone: 'navy',
  },
  {
    image: '/assets/onepage/results/gmail-reception-devis.jpg',
    alt: 'Gmail inbox with new quote requests received',
    title: 'Up to +40% quote requests',
    tone: 'yellow',
  },
];
---

<section class="op-results" aria-labelledby="op-results-title">
  <div class="op-container">
    <div class="op-results__head">
      <p class="op-kicker">05 — Observed results</p>
      <h2 id="op-results-title">The <span class="box-decoration-clone rounded-lg bg-[#262832] px-2 py-0 text-white">result</span>?</h2>
      <p>Results observed on more than 50 trade professionals after 3 months of use.</p>
    </div>
    <div class="op-social-wall" aria-labelledby="op-social-wall-title">
      <header class="op-social-wall__head">
        <p class="op-kicker">1 photo, 6 posts...</p>
        <h3 id="op-social-wall-title">1 photo, <span class="box-decoration-clone rounded-lg bg-[#fac43e] px-2 py-0 text-white">6 posts</span>...</h3>
        <p class="op-social-wall__support">...and maximum visibility, free, on all these networks!</p>
      </header>
      <div class="op-social-wall__viewport">
        <div class="op-social-wall__rail" data-social-output-wall>
          {socialOutputs.map((output) => (
            <figure class="op-social-output" data-network={output.key}>
              <figcaption>
                <img src={output.icon} alt="" width="24" height="24" loading="lazy" decoding="async" />
                <span>{output.network}</span>
              </figcaption>
              <img class="op-social-output__asset" src={output.src} alt={`Example of an ${output.network} post created from the jobsite`} loading="lazy" decoding="async" />
            </figure>
          ))}
          {socialOutputs.map((output) => (
            <figure class="op-social-output" data-network={output.key} aria-hidden="true">
              <figcaption>
                <img src={output.icon} alt="" width="24" height="24" loading="lazy" decoding="async" />
                <span>{output.network}</span>
              </figcaption>
              <img class="op-social-output__asset" src={output.src} alt="" loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    </div>

    <div class="op-results__cards-wall">
      <header class="op-results__cards-head">
        <p class="op-kicker">Results</p>
        <h3 class="op-results__cards-title">Results <span class="box-decoration-clone rounded-lg bg-[#f4862d] px-2 py-0 text-white">that pay the bills</span></h3>
        <p class="op-results__cards-support">Before / after usage (observed on 50+ pros over 3 months)</p>
      </header>
      <div class="op-results__cards">
        {resultCards.map((card) => (
          <article class={`op-result-card op-result-card--${card.tone}`}>
            <figure class="op-result-card__media">
              <img src={card.image} alt={card.alt} loading="lazy" decoding="async" />
            </figure>
            <h3 class="op-result-card__title">{card.title}</h3>
          </article>
        ))}
      </div>
    </div>
    <p class="op-results__note">Results vary by activity, area, consistency and existing presence.</p>
  </div>
</section>