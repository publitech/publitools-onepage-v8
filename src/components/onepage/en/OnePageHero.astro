---
import OnePageButton from '../OnePageButton.astro';
import OnePageSocialLogos from '../OnePageSocialLogos.astro';

const signupUrl = 'https://app.publichantier.fr/?signup=yes';
---

<section class="op-hero op-hero-v4" id="top" aria-labelledby="op-hero-title">
  <div class="op-hero__grid op-grid op-container">
    <div class="op-hero__copy">
      <p class="op-eyebrow"><span aria-hidden="true"></span>Powered by AI</p>
      <h1 id="op-hero-title">The #1 AI social media tool built for contractors & trade businesses</h1>
      <p class="op-hero__lead">1 photo. 1 voice note. Your jobsite posts, everywhere.</p>
      <OnePageSocialLogos label="Publish where your customers are looking" />
      <div class="op-actions">
        <OnePageButton href={signupUrl}>Start my free 14-day trial</OnePageButton>
        <OnePageButton href="#pricing" variant="secondary">See pricing</OnePageButton>
      </div>
    </div>

    <div class="op-hero-v4__visual">
      <figure class="op-hero-v4__artisan">
        <img
          src="/assets/onepage/hero-parquet-peintre.png"
          alt="Contractor taking a photo of a renovation jobsite with herringbone parquet flooring"
          width="1024"
          height="1280"
          loading="eager"
          decoding="async"
        />
      </figure>
      <figure class="op-hero-v4__fragment op-hero-v4__fragment--dashboard">
        <img
          src="/assets/onepage/hero-app-dashboard.png"
          alt="Structor app dashboard"
          width="390"
          height="844"
          loading="eager"
          decoding="async"
        />
      </figure>
      <figure class="op-hero-v4__fragment op-hero-v4__fragment--config">
        <img
          src="/assets/onepage/hero-app-config-ia.png"
          alt="AI setup in progress in the Structor app"
          width="339"
          height="325"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="op-hero-v4__fragment op-hero-v4__fragment--banner">
        <img
          src="/assets/onepage/hero-app-banner.jpeg"
          alt="Additional PubliTools app screenshot"
          width="640"
          height="233"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>