---
import { Image } from 'astro:assets';
import chantierFini from '../../../assets/onepage/backgrounds/personalize-chantier-v1.png';
import identityVisuelle from '../../../assets/onepage/personalize/identity-visuelle.png';
import styleTexte from '../../../assets/onepage/personalize/style-texte.png';
---

<section class="op-personalize" aria-labelledby="op-personalize-title">
  <div class="op-grid op-container op-personalize__grid">
    <div class="op-personalize__copy">
      <p class="op-kicker">01 — Customize</p>
      <h2 id="op-personalize-title"><span class="box-decoration-clone rounded-lg bg-[#f4862d] px-2 py-0 text-white">Customize</span> your <span class="underline">AI</span> to match your company's <span class="underline">branding</span></h2>
      <p>Add your logo, your colors, the tone you want to use, and many more customizations — simple to set up.</p>
    </div>

    <div class="op-personalize__visual">
      <figure class="op-personalize__chantier">
        <Image src={chantierFini} alt="Contractor setting up his AI from his phone on a jobsite" loading="lazy" decoding="async" />
      </figure>
      <p class="op-personalize__configured">
        <img
          src="/assets/onepage/structor-logo.png"
          alt=""
          aria-hidden="true"
          width="1024"
          height="1024"
          loading="lazy"
          decoding="async"
        />
        <span class="op-personalize__configured-text">
          <span class="op-personalize__configured-name">Structor</span>
          <span class="op-personalize__configured-status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            Business configured
          </span>
        </span>
      </p>
      <img
        class="op-personalize__structor"
        src="/brand/structor-icon.svg"
        alt="Structor"
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
      />
      <figure class="op-personalize__card op-personalize__card--identity">
        <Image src={identityVisuelle} alt="Real screen: visual identity (logo and primary color)" loading="lazy" decoding="async" />
      </figure>
      <figure class="op-personalize__card op-personalize__card--style">
        <Image src={styleTexte} alt="Real screen: text style (writing tone)" loading="lazy" decoding="async" />
      </figure>
    </div>
  </div>
</section>