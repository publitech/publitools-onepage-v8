---
interface Props {
  items: Array<[string, string]>;
}

const { items } = Astro.props;
---

<section class="op-faq" id="faq" aria-labelledby="op-faq-title">
  <div class="op-container op-faq__grid">
    <div class="op-section-head op-faq__head">
      <p class="op-kicker">FAQ</p>
      <h2 id="op-faq-title">Answers before you start.</h2>
      <p>Simple explanations about the trial, photos, videos and the two plans.</p>
    </div>
    <div class="op-faq__list">
      {items.map(([question, answer], index) => (
        <details open={index === 0}>
          <summary>{question}<span aria-hidden="true">+</span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>