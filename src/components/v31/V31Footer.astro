---
import V31Button from './V31Button.astro';
import { dict, type Locale } from '../../i18n';

interface Props {
  networkText?: string;
  ctaHref?: string;
  ctaLabel?: string;
  locale?: Locale;
}

const {
  networkText,
  ctaHref,
  ctaLabel,
  locale = 'fr',
} = Astro.props;

const t = dict[locale];
const finalCtaHref = ctaHref ?? t.common.nav.ctaHref;
const finalCtaLabel = ctaLabel ?? t.common.footer.cta;
const fallbackNetworkText = t.common.footer.about;
const finalNetworkText = networkText ?? fallbackNetworkText;
---

<footer class="v31-footer">
  <div class="v31-wrap footer-inner">
    <div class="footer-top">
      <div>
        <p class="footer-brand">{t.common.siteName}</p>
        <p class="footer-text">
          {t.common.footer.about}
        </p>
        <nav class="footer-nav" aria-label={t.common.footer.heading}>
          <a href={`/${locale}/#tarifs`}>{t.common.nav.pricing}</a>
          <a href={`/${locale}/#faq`}>{t.common.nav.faq}</a>
          <a href="/fr/blog/">Blog</a>
        </nav>
      </div>
      <nav aria-label={t.common.footer.legal}>
        <p class="footer-heading">{t.common.footer.legal}</p>
        <ul>
          <li><a href={t.common.footer.legalLinks.legal.href}>{t.common.footer.legalLinks.legal.label}</a></li>
          <li><a href={t.common.footer.legalLinks.cgv.href}>{t.common.footer.legalLinks.cgv.label}</a></li>
          <li><a href={t.common.footer.legalLinks.cgu.href}>{t.common.footer.legalLinks.cgu.label}</a></li>
          <li><a href={t.common.footer.legalLinks.privacy.href}>{t.common.footer.legalLinks.privacy.label}</a></li>
          <li><a href={t.common.footer.legalLinks.cookies.href}>{t.common.footer.legalLinks.cookies.label}</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <div>
        <p>{t.common.footer.copyright}</p>
        {finalNetworkText && <p class="network-text">{finalNetworkText}</p>}
      </div>
      <V31Button href={finalCtaHref} label={finalCtaLabel} fullWidthMobile={false} />
    </div>
  </div>
</footer>

<style>
  .v31-footer {
    background: var(--v31-soft);
    color: var(--v31-navy);
  }

  .footer-inner {
    padding-block: 56px 64px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr);
    gap: 40px;
  }

  .footer-brand {
    margin: 0;
    color: var(--v31-navy);
    font-family: var(--v31-font-display);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .footer-text {
    max-width: 720px;
    margin: 16px 0 0;
    color: #6b7280;
    font-size: 16px;
    line-height: 1.7;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 20px;
  }

  .footer-heading {
    margin: 0;
    color: var(--v31-navy);
    font-family: var(--v31-font-display);
    font-weight: 800;
  }

  ul {
    display: grid;
    gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: #6b7280;
    font-family: var(--v31-font-display);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  a:hover {
    color: var(--v31-orange);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 40px;
    border-top: 1px solid #e5e7eb;
    padding-top: 28px;
  }

  .footer-bottom p {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.55;
  }

  .network-text {
    margin-top: 8px !important;
  }

  @media (max-width: 760px) {
    .footer-inner {
      padding-block: 48px 56px;
    }

    .footer-top,
    .footer-bottom {
      grid-template-columns: 1fr;
    }

    .footer-top {
      display: grid;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>