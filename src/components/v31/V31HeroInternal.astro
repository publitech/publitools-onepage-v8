---
import V31Button from './V31Button.astro';
import V31Container from './V31Container.astro';
import V31Eyebrow from './V31Eyebrow.astro';

interface Cta {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary';
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  proof?: string;
  ctas?: Cta[];
  microcopy?: string;
  visualSrc?: string;
  visualAlt?: string;
  visualLabel?: string;
  stats?: Stat[];
}

const {
  eyebrow,
  title,
  lead,
  proof,
  ctas = [],
  microcopy,
  visualSrc,
  visualAlt = '',
  visualLabel,
  stats = [],
} = Astro.props;
---

<section class="v31-hero-internal">
  <V31Container grid class="hero-grid">
    <div class="hero-copy">
      {eyebrow && <V31Eyebrow text={eyebrow} />}
      <h1>{title}</h1>
      <p class="hero-lead">{lead}</p>
      {proof && <p class="hero-proof">{proof}</p>}
      {ctas.length > 0 && (
        <div class="v31-cta-row hero-actions">
          {ctas.map((cta) => (
            <V31Button href={cta.href} label={cta.label} variant={cta.variant || 'primary'} />
          ))}
        </div>
      )}
      {microcopy && <p class="hero-microcopy">{microcopy}</p>}
    </div>

    <aside class="hero-visual" aria-label={visualLabel || undefined}>
      {visualSrc ? (
        <div class="visual-card">
          <img src={visualSrc} alt={visualAlt} width="1024" height="1536" loading="eager" decoding="async" />
          <div class="visual-caption">
            <span>Cas BTP Renov</span>
            <strong>{visualLabel || 'Exemple produit'}</strong>
          </div>
        </div>
      ) : (
        <slot name="visual" />
      )}
      {stats.length > 0 && (
        <div class="hero-stats">
          {stats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      )}
    </aside>
  </V31Container>
</section>

<style>
  .v31-hero-internal {
    position: relative;
    padding-block: 64px 96px;
    background: linear-gradient(180deg, var(--v31-soft) 0%, #ffffff 100%);
  }

  .hero-grid {
    align-items: center;
    min-height: min(680px, calc(100svh - 96px));
    row-gap: 48px;
  }

  .hero-copy {
    grid-column: 1 / 8;
  }

  h1 {
    max-width: 760px;
    margin: 24px 0 0;
    color: var(--v31-navy);
    font-family: var(--v31-font-display);
    font-size: clamp(40px, 5vw, 62px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .hero-lead {
    margin: 28px 0 0;
    max-width: 680px;
    color: #40506a;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.45;
  }

  .hero-proof {
    margin: 24px 0 0;
    max-width: 620px;
    border-left: 4px solid var(--v31-orange);
    padding-left: 18px;
    color: var(--v31-navy);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.55;
  }

  .hero-actions {
    margin-top: 28px;
  }

  .hero-microcopy {
    margin: 14px 0 0;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
  }

  .hero-visual {
    grid-column: 9 / 13;
    position: relative;
  }

  .visual-card {
    position: relative;
    display: grid;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(11, 31, 58, 0.08);
    border-radius: var(--v31-radius-lg);
    background: #ffffff;
    box-shadow: var(--v31-shadow-hover);
  }

  .visual-card::before {
    content: '';
    display: block;
    grid-area: 1 / 1;
    aspect-ratio: 1;
  }

  .visual-card img {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: center;
    width: min(100%, 520px);
    height: min(100%, 520px);
    padding: 20px;
    object-fit: contain;
    object-position: center;
  }

  .visual-caption {
    position: absolute;
    inset-inline: 18px;
    bottom: 18px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: var(--v31-radius-md);
    background: rgba(11, 31, 58, 0.9);
    padding: 12px 14px;
    color: #ffffff;
    backdrop-filter: blur(12px);
  }

  .visual-caption span,
  .visual-caption strong {
    display: block;
  }

  .visual-caption span {
    color: rgba(255, 255, 255, 0.68);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .visual-caption strong {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.35;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 14px;
  }

  .hero-stats div {
    border: 1px solid #e8edf3;
    border-radius: var(--v31-radius-md);
    background: #ffffff;
    padding: 16px;
    box-shadow: 0 12px 30px rgba(11, 31, 58, 0.06);
  }

  .hero-stats strong,
  .hero-stats span {
    display: block;
  }

  .hero-stats strong {
    color: var(--v31-orange);
    font-family: var(--v31-font-display);
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .hero-stats span {
    margin-top: 3px;
    color: var(--v31-muted);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.35;
  }

  @media (max-width: 1020px) {
    .v31-hero-internal {
      padding-block: 48px 64px;
    }

    .hero-copy,
    .hero-visual {
      grid-column: 1 / -1;
    }

    h1 {
      font-size: clamp(38px, 10.4vw, 48px);
      line-height: 1.02;
    }

    .hero-lead {
      font-size: 17px;
      line-height: 1.6;
    }

    .hero-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
