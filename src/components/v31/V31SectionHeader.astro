---
import V31Eyebrow from './V31Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  align?: 'center' | 'left';
  tone?: 'light' | 'dark';
  titleId?: string;
  class?: string;
}

const { eyebrow, title, lead, align = 'center', tone = 'light', titleId } = Astro.props;
const className = Astro.props.class;
---

<header class:list={['v31-section-header', `align-${align}`, `tone-${tone}`, className]}>
  {eyebrow && <V31Eyebrow text={eyebrow} tone={tone === 'dark' ? 'dark' : 'light'} />}
  {title && <h2 id={titleId}>{title}</h2>}
  {lead && <p>{lead}</p>}
</header>

<style>
  .v31-section-header {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--v31-gutter);
    margin-bottom: 56px;
  }

  .v31-section-header > :global(.v31-eyebrow),
  .v31-section-header h2,
  .v31-section-header > p {
    grid-column: 3 / 11;
  }

  .align-center {
    text-align: center;
  }

  .align-center > :global(.v31-eyebrow),
  .align-center h2,
  .align-center > p {
    justify-self: center;
  }

  .align-left > :global(.v31-eyebrow),
  .align-left h2,
  .align-left > p {
    grid-column: 1 / 8;
    justify-self: start;
  }

  h2 {
    margin: 24px 0 0;
    color: var(--v31-navy);
    font-family: var(--v31-font-display);
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.08;
    text-wrap: balance;
  }

  p {
    max-width: 720px;
    margin: 20px 0 0;
    color: var(--v31-muted);
    font-size: 17px;
    line-height: 1.62;
  }

  .tone-dark h2,
  .tone-dark p {
    color: #ffffff;
  }

  .tone-dark p {
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 1020px) {
    .v31-section-header {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .v31-section-header > :global(.v31-eyebrow),
    .v31-section-header h2,
    .v31-section-header > p,
    .align-left > :global(.v31-eyebrow),
    .align-left h2,
    .align-left > p {
      grid-column: 2 / 8;
    }
  }

  @media (max-width: 680px) {
    .v31-section-header {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-bottom: 32px;
      text-align: center;
    }

    .v31-section-header > :global(.v31-eyebrow),
    .v31-section-header h2,
    .v31-section-header > p,
    .align-left > :global(.v31-eyebrow),
    .align-left h2,
    .align-left > p {
      grid-column: 1 / -1;
      justify-self: center;
    }

    h2 {
      font-size: clamp(32px, 8.8vw, 40px);
      line-height: 1.06;
    }

    p {
      margin-top: 16px;
      font-size: 16px;
    }
  }
</style>
