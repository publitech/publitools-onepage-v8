---
interface Props {
  title: string;
  text?: string;
  eyebrow?: string;
  href?: string;
  cta?: string;
  image?: string;
  imageAlt?: string;
  icon?: string;
  iconAlt?: string;
  items?: string[];
  number?: string;
  imagePriority?: 'eager' | 'lazy';
  mediaRatio?: '16:11' | '16:10' | '1:1';
}

const {
  title,
  text,
  eyebrow,
  href,
  cta,
  image,
  imageAlt = '',
  icon,
  iconAlt = '',
  items,
  number,
  imagePriority = 'eager',
  mediaRatio = '16:11',
} = Astro.props;
const isLinked = Boolean(href);
---

<article class:list={['v31-card', isLinked && 'is-linked']}>
  {image && (
    <img
      class:list={['card-media', `ratio-${mediaRatio.replace(':', '-')}`]}
      src={image}
      alt={imageAlt}
      width="1536"
      height="1024"
      loading={imagePriority}
      decoding="async"
      fetchpriority={imagePriority === 'eager' ? 'high' : undefined}
    />
  )}
  <div class="card-body">
    {icon && <img class="card-icon" src={icon} alt={iconAlt} width="42" height="42" loading="lazy" decoding="async" />}
    {number && <span class="card-number">{number}</span>}
    {eyebrow && <p class="card-eyebrow">{eyebrow}</p>}
    <h3>{title}</h3>
    {text && <p>{text}</p>}
    {items && (
      <ul>
        {items.map((item) => <li>{item}</li>)}
      </ul>
    )}
    {href && <a href={href}>{cta || 'Voir le détail'}<span aria-hidden="true"> →</span></a>}
  </div>
</article>

<style>
  .v31-card {
    overflow: hidden;
    border: 1px solid var(--v31-border);
    border-radius: var(--v31-radius-card);
    background: #ffffff;
    box-shadow: var(--v31-shadow-card);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .is-linked:hover {
    transform: translateY(-2px);
    border-color: rgba(11, 31, 58, 0.14);
    box-shadow: var(--v31-shadow-hover);
  }

  .card-media {
    width: 100%;
    background: var(--v31-soft);
    object-fit: cover;
  }

  .ratio-16-11 {
    aspect-ratio: 16 / 11;
  }

  .ratio-16-10 {
    aspect-ratio: 16 / 10;
  }

  .ratio-1-1 {
    aspect-ratio: 1;
  }

  .card-body {
    padding: 26px;
  }

  .card-icon {
    display: block;
    width: 42px;
    height: 42px;
    margin-bottom: 16px;
    border-radius: 14px;
    background: #fff7ef;
    padding: 9px;
    object-fit: contain;
  }

  .card-number,
  .card-eyebrow {
    display: inline-flex;
    margin: 0 0 14px;
    color: var(--v31-orange);
    font-family: var(--v31-font-display);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 16px;
    text-transform: uppercase;
  }

  .card-number {
    min-width: 36px;
    min-height: 28px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 122, 26, 0.18);
    border-radius: 999px;
    background: #fff7ef;
  }

  h3 {
    margin: 0;
    color: var(--v31-navy);
    font-family: var(--v31-font-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.16;
    text-wrap: balance;
  }

  p {
    margin: 12px 0 0;
    color: var(--v31-muted);
    font-size: 15px;
    line-height: 1.62;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 9px;
    color: var(--v31-navy);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.45;
  }

  li::before {
    content: '✓';
    color: var(--v31-orange);
    font-weight: 900;
  }

  a {
    display: inline-flex;
    margin-top: 20px;
    color: var(--v31-orange);
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .card-body {
      padding: 22px;
    }
  }
</style>
