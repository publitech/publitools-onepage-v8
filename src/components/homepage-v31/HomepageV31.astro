  height: clamp(96px, 10vw, 136px);
}

.flow-connector-out {
  margin: -6px auto -2px;
  height: clamp(112px, 11vw, 152px);
}

.flow-connector svg {
  width: min(320px, 48vw);
  height: 100%;
  overflow: visible;
}
.flow-connector-out svg {
  width: min(460px, 58vw);
}

.flow-path,
.flow-arrow {
  stroke: #FF7A1A;
  stroke-width: 3.4;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
  filter: none;
}
.flow-path {
  opacity: 0.78;
  stroke-dasharray: 10 13;
  animation: flowDash 1.55s linear infinite;
}
.flow-path-left,
.flow-path-right {
  opacity: 0.58;
}
.flow-arrow {
  stroke-width: 4.2;
  opacity: 0.95;
}
.flow-arrow.side {
  opacity: 0.62;
  stroke-width: 3.2;
}

@keyframes flowDash {
  to { stroke-dashoffset: -46; }
}

@media (prefers-reduced-motion: reduce) {
  .flow-path,
  .engine-orbit i {
    animation: none !important;
  }
}

/* --- Niveau 2 : moteur PubliTools magique --- */
.engine-level {
  display: flex;
  align-items: center;
  justify-content: center;
}

.engine-box {
  flex: 0 1 560px;
  width: min(560px, 100%);
  position: relative;
}

.engine-box::before {
  content: none;
}

.engine-card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: transparent;
  border: 0;
  border-radius: 34px;
  padding: 0;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  transition: box-shadow 300ms ease, transform 300ms ease;
}

.engine-card:hover {
  box-shadow: none;
  transform: translateY(-3px);
}

.engine-card::before {
  content: none;
}

.engine-orbit {
  display: none;
}
.engine-orbit i {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #FF9A4A;
  box-shadow: 0 0 28px rgba(255, 122, 26, 0.82);
  opacity: 0.72;
}
.engine-orbit i:nth-child(1) { top: 18%; left: 12%; animation: sparkleFloat 4.4s ease-in-out infinite; }
.engine-orbit i:nth-child(2) { top: 28%; right: 14%; animation: sparkleFloat 5s ease-in-out 0.7s infinite; }
.engine-orbit i:nth-child(3) { bottom: 18%; left: 48%; animation: sparkleFloat 4.7s ease-in-out 1.2s infinite; }

.engine-logo-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 100%;
  gap: 0;
}

.engine-brand-logo {
  display: block;
  width: min(560px, 86vw);
  height: auto;
  object-fit: contain;
  border-radius: 34px;
  background: transparent;
  padding: 0;
  box-shadow: 0 30px 80px rgba(11,31,58,0.18);
}

@keyframes sparkleFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.48; }
  50% { transform: translateY(-12px) scale(1.35); opacity: 0.95; }
}


/* --- Carousels wrapper --- */
.carousels-level {
  --card-w: clamp(196px, 19.2vw, 276px);
  margin-top: -4px;
  display: grid;
  gap: 34px;
  padding: 22px 0 12px;
  width: 100vw;
  margin-left: 50%;
  transform: translateX(-50%);
  overflow: hidden;
  mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
}

/* --- Carousel rows --- */
.carousel-row {
  overflow: hidden;
  width: 100%;
}
.carousel-track {
  display: flex;
  gap: clamp(44px, 4.2vw, 70px);
  width: max-content;
  padding: 3px 0;
  will-change: transform;
}
.carousel-row.right .carousel-track {
  animation: scrollRight var(--row-speed, 62s) linear infinite;
}
.carousel-row.left .carousel-track {
  animation: scrollLeft var(--row-speed, 62s) linear infinite;
}
.carousel-row:hover .carousel-track {
  animation-play-state: paused;
}
/* --- Mockup card container --- */
.carousel-card {
  position: relative;
  flex-shrink: 0;
  width: var(--card-w);
  aspect-ratio: 241 / 320;
  background: #fff;
  border: 1px solid rgba(11, 31, 58, 0.08);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 18px 48px rgba(11, 31, 58, 0.13);
  transition: transform 300ms ease, box-shadow 300ms ease;
}
.carousel-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 24px 60px rgba(11, 31, 58, 0.2);
}
.showcase-card.network-facebook { --network-strip: #1877F2; }
.showcase-card.network-instagram { --network-strip: #E4405F; }
