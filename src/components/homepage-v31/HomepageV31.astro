/* ============================
   SECTION AVIS CLIENTS
   ============================ */
.three-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.three-steps article {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 28px;
  box-shadow: var(--shadow-card);
  transition: box-shadow 300ms ease, transform 300ms ease;
}
.three-steps article:hover {
  box-shadow: var(--shadow-hover);
  transform: translateY(-2px);
}
.three-steps b {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 12px;
  background: var(--orange);
  color: #fff;
}
.three-steps article > img {
  width: 100%;
  margin: 0 0 18px;
  aspect-ratio: 3 / 4;
  object-fit: contain;
  object-position: center;
  display: block;
  border-radius: 16px;
  box-shadow: var(--shadow-image);
  background: #fff;
}
.reviews-steps article {
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}
.reviews-steps article > strong {
  min-height: 96px;
  display: flex;
  align-items: flex-start;
  padding: 24px 24px 16px;
}
.reviews-steps article > img {
  margin: 0;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  object-position: center;
  border-radius: 0;
  box-shadow: none;
  background: #F4F6F8;
}
.reviews-steps .review-copy {
  color: var(--muted);
  margin: 8px 0 0;
  line-height: 1.45;
}
.three-steps strong {
  display: block;
  color: var(--navy);
  font-size: 20px;
  font-weight: 900;
}
.three-steps span {
  display: block;
  color: var(--muted);
  margin-top: 8px;
  line-height: 1.4;
}
.review-destinations,
.review-feature-icons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: auto;
  padding: 16px 24px 24px;
}
.review-destinations span,
.review-feature-icons span {
  width: 34px;
  height: 34px;
  margin: 0;
  border-radius: 10px;
  background: #fff;
  border: 1px solid rgba(11, 31, 58, 0.10);
  box-shadow: 0 6px 16px rgba(11, 31, 58, 0.07);
  display: grid;
