const stats = [
  { eyebrow: 'VISIBILITÉ', value: 600, suffix: '%', prefix: '+', label: 'de vues sur les posts chantier', icon: '<svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M5 21h18" stroke="#E8EEF6" stroke-width="2.4" stroke-linecap="round"/><path d="M6 18.5l4.7-4.8 4.1 3.6 6.7-8" stroke="#4285F4" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 17.2l6.5-7.9" stroke="#34A853" stroke-width="2.8" stroke-linecap="round"/><path d="M18.1 8.7h3.8v3.8" stroke="#FBBC05" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10.7" cy="13.7" r="1.8" fill="#EA4335"/><circle cx="14.8" cy="17.3" r="1.8" fill="#FF7A1A"/></svg>' },
  { eyebrow: 'GOOGLE LOCAL', value: 12, suffix: '', prefix: '+', label: 'places gagnées en moyenne', icon: '<img src="/social/google-official.svg" alt="" loading="lazy" />' },
  { eyebrow: 'DEMANDES', value: 40, suffix: '%', prefix: '+', label: 'de demandes de devis', icon: '<svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M4.5 8.2c0-1.1.9-2 2-2h15c1.1 0 2 .9 2 2v11.6c0 1.1-.9 2-2 2h-15c-1.1 0-2-.9-2-2V8.2z" fill="#fff"/><path d="M5.7 7.7l8.3 6.4 8.3-6.4" stroke="#EA4335" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.8 20.2V8.4" stroke="#4285F4" stroke-width="2.3" stroke-linecap="round"/><path d="M22.2 20.2V8.4" stroke="#34A853" stroke-width="2.3" stroke-linecap="round"/><path d="M6.7 21.1h14.6" stroke="#FBBC05" stroke-width="2.3" stroke-linecap="round"/></svg>' },
  { eyebrow: 'AVIS', value: 35, suffix: '%', prefix: '+', label: 'avis Google collectés', icon: '<svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M7 6.5h14a3 3 0 013 3v7.2a3 3 0 01-3 3h-7.3L8 23v-3.3H7a3 3 0 01-3-3V9.5a3 3 0 013-3z" fill="#FFFFFF" stroke="#4285F4" stroke-width="2.1" stroke-linejoin="round"/><path d="M8.3 18.5h4.2" stroke="#34A853" stroke-width="2.2" stroke-linecap="round"/><path d="M19.7 9.1l.66 1.35 1.48.21-1.07 1.04.25 1.47-1.32-.7-1.32.7.25-1.47-1.07-1.04 1.48-.21.66-1.35z" fill="#FBBC05" stroke="#FBBC05" stroke-width="1.2" stroke-linejoin="round"/><path d="M9.2 10.7h6.2" stroke="#EA4335" stroke-width="2.2" stroke-linecap="round"/><path d="M9.2 14.4h9.4" stroke="#FF7A1A" stroke-width="2.2" stroke-linecap="round"/></svg>' },
