---

<main id="top" class="homepage-v31">
  <section class="hero-v31" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-badges">
          <span class="eyebrow pill">Pour les Artisans, TPE et PME du Bâtiment</span>
          <span class="ia-badge">⚡ Powered by IA</span>
        </div>
        <h1 id="hero-title">L’IA qui transforme vos chantiers en publicité sur internet</h1>
        <p class="lead">Réseaux sociaux, avis clients, Google Business en moins de 2 min/jour.</p>
        <div class="actions">
          <a class="button primary" href="https://app.publichantier.fr/?signup=yes">Essayer PubliTools 14 jours</a>
          <a class="button ghost" href="#tarifs">Voir le tarif</a>
        </div>
        <div class="hero-visibility">
          <span>Publiez vos chantiers sur</span>
          <div class="visibility-logos">{destinations.map((item) => <span title={item.label}><img src={item.src} alt={item.label} /></span>)}</div>
        </div>
      </div>

      <div class="hero-demo" aria-label="Démonstration animée PubliTools : photo chantier vers visibilité internet">
        <HeroGsapVisibilityStory />
      </div>
    </div>
  </section>

  <section class="section proof-section" id="preuves" aria-labelledby="proof-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow pill">Preuves observées</span>
        <h2 id="proof-title" class="proof-h2">50+ artisans. 3 mois. Des résultats concrets</h2>
        <p class="proof-intro">Un outil IA qui a fait ses preuves en apportant des résultats concrets.</p>
      </div>
      <div class="proof-stage" aria-label="Résultats observés PubliTools">
        <div class="proof-stage-line" aria-hidden="true"></div>
        <div class="stats-grid proof-stats">{stats.map((stat) => <article class="stat-card"><div class="stat-icon">{/* @ts-ignore */}<Fragment set:html={stat.icon} /></div><span class="stat-label">{stat.eyebrow}</span><strong class="stat-value" data-target={String(stat.value)} data-prefix={stat.prefix} data-suffix={stat.suffix}>{stat.prefix}{stat.value}{stat.suffix}</strong><p>{stat.label}</p></article>)}</div>
      </div>
      <p class="caution caution-centered"><em>Résultats observés chez des artisans utilisateurs après 3 mois. Les résultats varient selon l’activité, la zone et la régularité.</em></p>
    </div>
  </section>

  <section class="section networks-section" id="reseaux" aria-labelledby="reseaux-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow pill">Réseaux sociaux</span>
        <h2 id="reseaux-title">Publiez sur 6 réseaux en 2 min, sans y passer vos soirées</h2>
        <p>Une photo, une vidéo ou un vocal suffit. PubliTools prépare le contenu, vous validez, puis vous publiez.</p>
      </div>
      <!-- NIVEAU 1 : sources produit réelles -->
      <div class="sources-level">
        <div class="sources-combo" aria-label="Photo ou vidéo plus vocal dans PubliTools">
          <article class="source-screen-card source-screen-card-media">
            <span class="source-label">Photo / Vidéo</span>
            <img src="/assets/homepage-v31/user-sources/photo-video-upload-sage-20260612.webp" alt="Écran PubliTools pour ajouter des photos ou vidéos de chantier" loading="eager" />
          </article>
          <div class="source-plus" aria-hidden="true">+</div>
          <article class="source-screen-card source-screen-card-vocal">
            <span class="source-label">Vocal</span>
            <img src="/assets/homepage-v31/user-sources/vocal-description-sage-20260612.webp" alt="Écran PubliTools pour décrire son chantier en vocal" loading="eager" />
          </article>
        </div>
      </div>
      <!-- Flèche N1→N2 -->
      <div class="flow-connector flow-connector-in" aria-hidden="true">
        <svg viewBox="0 0 160 138" fill="none">
          <path class="flow-path flow-path-left" d="M28 8 C28 54 80 58 80 118" />
          <path class="flow-path flow-path-right" d="M132 8 C132 54 80 58 80 118" />
          <path class="flow-arrow" d="M70 108 L80 122 L90 108" />
        </svg>
      </div>
      <!-- NIVEAU 2 : Moteur PubliTools -->
      <div class="engine-level">
        <div class="engine-box">
          <div class="engine-card">
            <div class="engine-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="engine-logo-row">
              <img class="engine-brand-logo" src="/brand/publitools-logo.jpg" alt="PubliTools" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
      <!-- Flèche N2→N3 -->
      <div class="flow-connector flow-connector-out" aria-hidden="true">
        <svg viewBox="0 0 220 148" fill="none">
          <path class="flow-path flow-path-center" d="M110 8 C110 48 110 74 110 126" />
          <path class="flow-path flow-path-left" d="M110 70 C74 82 50 98 32 126" />
          <path class="flow-path flow-path-right" d="M110 70 C146 82 170 98 188 126" />
          <path class="flow-arrow" d="M100 116 L110 132 L120 116" />
          <path class="flow-arrow side" d="M24 112 L31 130 L45 117" />
          <path class="flow-arrow side" d="M196 112 L189 130 L175 117" />
        </svg>
      </div>
                  <!-- NIVEAU 3 : carrousels avec mockups fournis -->
                  <div class="carousels-level" aria-label="Exemples de publications générées sur les réseaux">
                    {socialShowcaseRows.map((row) => (
                      <div class={`carousel-row ${row.direction}`} style={`--row-speed:${row.speed}`}>
                        <div class="carousel-track">
                          {row.items.concat(row.items).map((item) => (
                            <article class={`carousel-card showcase-card network-${item.network}`}>
                              <div class="card-label net-label showcase-label">
                                <img src={networkLogo[item.network]} alt="" class="net-logo" loading="lazy" />
                                <span>{item.label}</span>
                                <small>{item.format}</small>
                              </div>
                              <div class="showcase-frame">
                                <img class="showcase-image" src={item.image} alt={item.alt} loading="eager" />
                              </div>
                            </article>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                    </div>
                  </div>
    </div>
  </section>

  <section class="section reviews-section" id="avis" aria-labelledby="avis-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow pill">Avis clients</span>
        <h2 id="avis-title">Demandez des avis au bon moment, sans courir après le lien Google</h2>
        <p>PubliTools prépare le SMS, vous l’envoyez, l’avis reçu peut devenir une publication prête.</p>
      </div>
      <div class="three-steps reviews-steps">
        <article>
          <strong>SMS d’avis préparé avec votre lien Google</strong>
          <img src="/assets/homepage-v31/reviews/review-sms-request.webp" alt="SMS automatisé PubliTools pour demander un avis Google" loading="eager" />
          <div class="review-feature-icons" aria-label="IA, automatisation et rédaction">
            <span title="Cerveau" aria-label="Cerveau"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4.5A3.5 3.5 0 0 0 5.7 9 3.5 3.5 0 0 0 7 15.7V18a2.5 2.5 0 0 0 5 0V6.5A2.5 2.5 0 0 0 9 4.5Z"/><path d="M15 4.5A3.5 3.5 0 0 1 18.3 9 3.5 3.5 0 0 1 17 15.7V18a2.5 2.5 0 0 1-5 0V6.5a2.5 2.5 0 0 1 3-2Z"/><path d="M8.2 10.2h3.8M12 13.8H8.4M15.8 10.2H12M12 13.8h3.6"/></svg></span>
            <span title="Robot" aria-label="Robot"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v3"/><path d="M8 7h8a4 4 0 0 1 4 4v5a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-5a4 4 0 0 1 4-4Z"/><path d="M9 13h.01M15 13h.01"/><path d="M9 17h6"/><path d="M5 12H3M21 12h-2"/></svg></span>
            <span title="Stylo" aria-label="Stylo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg></span>
          </div>
        </article>
        <article>
          <strong>Avis reçu, prêt à être réutilisé proprement</strong>
          <img src="/assets/homepage-v31/reviews/review-google-received-user.webp" alt="Avis Google cinq étoiles reçu depuis un client de chantier" loading="eager" />
          <div class="review-feature-icons" aria-label="Notification, IA et réponse">
            <span title="Notification" aria-label="Notification"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z"/><path d="M10 21h4"/></svg></span>
            <span title="Cerveau" aria-label="Cerveau"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4.5A3.5 3.5 0 0 0 5.7 9 3.5 3.5 0 0 0 7 15.7V18a2.5 2.5 0 0 0 5 0V6.5A2.5 2.5 0 0 0 9 4.5Z"/><path d="M15 4.5A3.5 3.5 0 0 1 18.3 9 3.5 3.5 0 0 1 17 15.7V18a2.5 2.5 0 0 1-5 0V6.5a2.5 2.5 0 0 1 3-2Z"/><path d="M8.2 10.2h3.8M12 13.8H8.4M15.8 10.2H12M12 13.8h3.6"/></svg></span>
            <span title="Réponse" aria-label="Réponse"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h9a7 7 0 0 1 7 7v4"/></svg></span>
          </div>
        </article>
        <article>
          <strong>Publication prête à valider à partir d’un avis réel</strong>
          <img src="/assets/homepage-v31/reviews/review-social-post.webp" alt="Publication générée automatiquement à partir d’un avis client" loading="eager" />
          <div class="review-destinations" aria-label="Réseaux disponibles pour publier l’avis">
            {destinations.map((item) => <span title={item.label}><img src={item.src} alt={item.label} loading="lazy" /></span>)}
          </div>
        </article>
      </div>
      <div class="mobile-section-cta">
        <a class="button primary" href="https://app.publichantier.fr/?signup=yes">Essayer PubliTools 14 jours</a>
