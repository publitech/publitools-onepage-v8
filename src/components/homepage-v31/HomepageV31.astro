  const prefix = (el as HTMLElement).dataset.prefix || '+';
  const suffix = (el as HTMLElement).dataset.suffix || '';
  const state = { value: 0 };

  gsap.to(state, {
    value: target,
    duration: prefersReducedMotion ? 0.01 : DURATION,
    ease: 'power3.out',
    onUpdate: () => {
      el.textContent = `${prefix}${Math.round(state.value)}${suffix}`;
    },
    onComplete: () => {
      el.textContent = `${prefix}${target}${suffix}`;
    }
  });
}

const proofStage = document.querySelector('.proof-stage');
const proofCards = gsap.utils.toArray<HTMLElement>('.proof-section .stat-card');
const proofMeta = gsap.utils.toArray<HTMLElement>('.proof-meta span');

if (!prefersReducedMotion && proofStage) {
  gsap.set([proofStage, ...proofCards, ...proofMeta].filter(Boolean), { autoAlpha: 1 });
  gsap.from(proofStage, {
    y: 28,
    scale: 0.985,
    duration: 0.85,
    ease: 'power3.out',
    scrollTrigger: undefined
  });
}

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;

    const values = entry.target.querySelectorAll?.('.stat-value[data-target]') || [];
    values.forEach(animateCounter);

    if (!prefersReducedMotion) {
      if (proofMeta.length > 0) {
        gsap.from(proofMeta,
          { y: 10, duration: 0.55, stagger: 0.07, ease: 'power2.out' }
        );
      }
      if (proofCards.length > 0) {
        gsap.from(proofCards,
          { y: 24, scale: 0.97, duration: 0.72, stagger: 0.08, ease: 'power3.out', delay: 0.08 }
        );
      }
    }

    observer.unobserve(entry.target);
  });
}, { threshold: 0.24 });

if (proofStage) observer.observe(proofStage);
</script>
