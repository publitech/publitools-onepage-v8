      { network: 'tiktok', label: 'TikTok', format: 'vidéo verticale', image: '/assets/homepage-v31/SOC-10-tiktok-video.webp', alt: 'Mockup TikTok vidéo de chantier' },
      { network: 'linkedin', label: 'LinkedIn', format: 'vidéo pro', image: '/assets/homepage-v31/SOC-13-linkedin-video.webp', alt: 'Mockup LinkedIn avec vidéo de chantier' },
      { network: 'google', label: 'Google Business', format: 'photos toiture', image: '/assets/homepage-v31/social-showcase/11-google-toiture-charpente.webp', alt: 'Mockup Google Business toiture et charpente' },
      { network: 'instagram', label: 'Instagram', format: 'reel chantier', image: '/assets/homepage-v31/SOC-09-instagram-reel.webp', alt: 'Mockup Instagram Reel chantier' },
      { network: 'facebook', label: 'Facebook', format: 'terrasse', image: '/assets/homepage-v31/social-showcase/13-facebook-terrasse-renovee.webp', alt: 'Mockup Facebook terrasse rénovée' },
      { network: 'youtube', label: 'YouTube Shorts', format: 'short plomberie', image: '/assets/homepage-v31/social-showcase/26-shorts-plomberie-nantes-2.webp', alt: 'Mockup YouTube Shorts plomberie à Nantes' },
