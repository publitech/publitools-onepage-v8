---
const destinations = [
  { label: 'Google Business', src: '/social/google-official.svg' },
  { label: 'Instagram', src: '/social/instagram-official.svg' },
  { label: 'Facebook', src: '/social/facebook-official.svg' },
  { label: 'LinkedIn', src: '/social/linkedin-official.svg' },
  { label: 'TikTok', src: '/social/tiktok-official.svg' },
  { label: 'YouTube', src: '/social/youtube-official.svg' },
];

const stats = [
  ['+40 %', 'demandes de devis observées'],
  ['+600 %', 'vues sur les posts chantier'],
  ['+12', 'places Google observées en moyenne'],
  ['+35 %', 'avis Google collectés'],
];
---

<main id="top" class="homepage-v25">
  <section class="hero" aria-labelledby="v25-hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Pour artisans, TPE et PME du bâtiment</span>
        <h1 id="v25-hero-title">L'outil IA n°1 du BTP pour faire grossir votre entreprise sur internet</h1>
        <p class="lead">Ajoutez vos photos de chantier, dictez ce que vous avez fait, et PubliTools prépare vos posts, visuels, avis et publications pour vos réseaux.</p>
        <div class="chips" aria-label="Points clés PubliTools">
          <span>Photos + vocal → post prêt</span>
          <span>6 destinations connectées</span>
          <span>Essai Pro 14 jours</span>
          <span>Résultats observés sur 50+ artisans</span>
        </div>
        <div class="actions">
          <a class="button primary" href="https://app.publitools.ai/fr/signup">Essayer gratuitement 14 jours</a>
          <a class="button ghost" href="#comment-ca-marche">Voir comment ça marche</a>
        </div>
      </div>

      <div class="hero-product" aria-label="Démonstration PubliTools : chantier vers contenus publiables">
        <div class="product-shell">
          <div class="product-topbar"><strong>PubliTools</strong><span>Publication prête</span></div>
          <div class="product-grid">
            <div class="input-panel">
              <div class="job-photo"><span>Photo chantier</span></div>
              <div class="voice-wave" aria-label="Vocal chantier"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
              <small>“Rénovation terminée, isolation refaite, finitions propres.”</small>
            </div>
            <div class="product-arrow" aria-hidden="true">→</div>
            <div class="output-panel">
              <div class="caption-lines"><i></i><i></i><i></i><i class="orange"></i></div>
              <div class="mini-post"><span>Visuel chantier</span><b>Prêt à publier</b></div>
              <div class="logo-row compact">
                {destinations.map((item) => <img src={item.src} alt={item.label} title={item.label} />)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section intro-strip" id="comment-ca-marche">
    <div class="container narrow center">
      <span class="eyebrow">Big Idea</span>
      <h2>PubliTools transforme vos chantiers en visibilité internet régulière.</h2>
      <p>Vos chantiers existent déjà. PubliTools les transforme en contenus visibles sur les réseaux, Google Business et vos supports d’avis.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="flow-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Création de contenu</span>
        <h2 id="flow-title">Transformez une photo de chantier et un vocal en publication prête à poster</h2>
        <p>PubliTools retouche vos photos, transcrit votre vocal, rédige la caption, ajoute les hashtags et prépare le visuel.</p>
      </div>
      <div class="wide-flow" aria-label="Photo et vocal vers publication prête">
        <div class="flow-node input"><b>1</b><strong>Photo / vidéo chantier</strong><span>+ vocal ou texte court</span></div>
        <svg viewBox="0 0 120 24" aria-hidden="true"><path d="M6 12h104"/><path d="M98 4l14 8-14 8"/></svg>
        <div class="flow-node engine"><b>2</b><strong>PubliTools prépare</strong><span>retouche, caption, design, hashtags</span></div>
        <svg viewBox="0 0 120 24" aria-hidden="true"><path d="M6 12h104"/><path d="M98 4l14 8-14 8"/></svg>
        <div class="flow-node output"><b>3</b><strong>Post prêt</strong><span>adapté aux réseaux choisis</span></div>
      </div>
    </div>
  </section>

  <section class="section navy" aria-labelledby="networks-title">
    <div class="container networks-grid">
      <div>
        <span class="eyebrow light">Multi-réseaux</span>
        <h2 id="networks-title">Publiez vos chantiers sur tous vos réseaux sans tout refaire à la main</h2>
        <p>Facebook, Instagram, LinkedIn, Google Business, TikTok et YouTube : vos contenus sont adaptés aux formats sélectionnés.</p>
      </div>
      <div class="network-hub" aria-label="Six destinations PubliTools">
        <div class="hub-center">PubliTools</div>
        {destinations.map((item) => <div class="hub-logo"><img src={item.src} alt={item.label} /><span>{item.label}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="google-title">
    <div class="container split">
      <div class="section-copy">
        <span class="eyebrow">Google Business</span>
        <h2 id="google-title">Faites vivre votre fiche Google Business avec vos chantiers récents</h2>
        <p>Ajoutez plus facilement posts, photos et preuves récentes sur votre fiche locale, sans promettre une position Google.</p>
      </div>
      <div class="gmb-card" aria-label="Fiche Google Business alimentée">
        <div class="gmb-header"><img src="/social/google-official.svg" alt="Google Business" /><strong>Fiche entreprise</strong><span>mise à jour récente</span></div>
        <div class="gmb-photo"></div>
        <div class="gmb-post"><b>Post chantier publié</b><span>Rénovation terminée · photos ajoutées · preuve récente</span></div>
        <div class="gmb-review">★★★★★ Avis client visible</div>
      </div>
    </div>
  </section>

  <section class="section soft" aria-labelledby="reviews-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Avis clients</span>
        <h2 id="reviews-title">Demandez vos avis plus simplement, puis transformez-les en preuve visible</h2>
        <p>PubliTools prépare un SMS de demande d’avis avec lien Google, puis peut transformer un avis existant en post ou visuel.</p>
      </div>
      <div class="timeline" aria-label="Timeline avis clients">
        <article><b>1</b><strong>Chantier terminé</strong><span>Le bon moment pour demander un retour.</span></article>
        <article><b>2</b><strong>SMS prêt</strong><span>L’app SMS s’ouvre avec le message et le lien Google.</span></article>
        <article><b>3</b><strong>Avis reçu</strong><span>Un avis réel peut devenir une preuve visible.</span></article>
        <article><b>4</b><strong>Post Pro</strong><span>Visuel ou publication à partir de l’avis.</span></article>
      </div>
    </div>
  </section>

  <section class="section results" aria-labelledby="results-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow light">Résultats observés</span>
        <h2 id="results-title">Des résultats observés chez plus de 50 artisans après 3 mois</h2>
      </div>
      <div class="stat-strip">
        {stats.map(([value, label]) => <article><strong>{value}</strong><span>{label}</span></article>)}
      </div>
      <p class="caution">Les résultats varient selon l’activité, la zone, la régularité et la présence existante.</p>
    </div>
  </section>

  <section class="section" id="offre" aria-labelledby="offer-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Offre</span>
        <h2 id="offer-title">Essayez PubliTools pendant 14 jours avec l’accès Pro</h2>
        <p>Vous testez PubliTools avec l’accès Pro complet pendant 14 jours. Ensuite, vous continuez avec Starter ou Pro selon votre rythme.</p>
      </div>
      <div class="pricing-grid">
        <article class="price-card">
          <span class="plan">Starter</span>
          <h3>Pour publier régulièrement sans tout automatiser.</h3>
          <div class="price">19,90 € <small>HT/mois</small></div>
          <ul>
            <li>8 publications / mois</li>
            <li>3 réseaux maximum par publication</li>
            <li>6 réseaux disponibles</li>
            <li>Demandes d’avis SMS illimitées</li>
          </ul>
          <a class="button ghost dark" href="https://app.publitools.ai/fr/signup">Démarrer avec Starter</a>
        </article>
        <article class="price-card pro">
          <span class="plan">Pro</span>
          <h3>Pour tout publier, programmer et exploiter vos avis.</h3>
          <div class="price">39,90 € <small>HT/mois</small></div>
          <ul>
            <li>Publications illimitées</li>
            <li>Réseaux illimités par publication</li>
            <li>Programmation incluse</li>
            <li>SmartAI et designs illimités</li>
            <li>Avis → post ou visuel publiable</li>
          </ul>
          <a class="button primary" href="https://app.publitools.ai/fr/signup">Essayer Pro 14 jours</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">Les questions avant de se lancer</h2>
      </div>
      <details open><summary>Quels réseaux sont disponibles ?</summary><p>Facebook, Instagram, LinkedIn, Google Business, TikTok et YouTube sont les destinations confirmées au lancement.</p></details>
      <details><summary>Est-ce que je peux relire avant publication ?</summary><p>Oui. PubliTools prépare le contenu et l’utilisateur peut le relire ou le modifier avant de publier.</p></details>
      <details><summary>Comment fonctionnent les avis ?</summary><p>PubliTools prépare un SMS avec le lien Google. L’app SMS du téléphone s’ouvre, puis l’utilisateur envoie le message.</p></details>
      <details><summary>Est-ce que les résultats sont garantis ?</summary><p>Non. Les chiffres affichés sont des résultats observés sur une cohorte ; ils dépendent de l’activité, de la zone et de la régularité.</p></details>
      <details><summary>Que se passe-t-il après 14 jours ?</summary><p>L’essai donne accès au Pro complet pendant 14 jours, puis le compte continue sur le plan choisi.</p></details>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <div class="container center narrow">
      <h2 id="final-title">Vos prochains chantiers peuvent déjà travailler pour votre visibilité</h2>
      <p>Ajoutez une photo, dictez le contexte, voyez ce que PubliTools prépare.</p>
      <a class="button primary" href="https://app.publitools.ai/fr/signup">Essayer gratuitement 14 jours</a>
    </div>
  </section>
</main>

<style>
  :global(html){scroll-behavior:smooth}.homepage-v25{--navy:#0b1f3a;--ink:#111827;--muted:#596273;--orange:#ff7a1a;--soft:#f6f7f9;--line:#e6e9ee;background:#fff;color:var(--ink);font-family:Inter,system-ui,sans-serif}.container{width:min(1120px,calc(100% - 32px));margin:0 auto}.narrow{width:min(860px,calc(100% - 32px))}.center{text-align:center}.section{padding:86px 0}.hero{padding:74px 0 70px;background:linear-gradient(180deg,#fff 0%,#f8fafc 100%);overflow:hidden}.hero-grid{display:grid;grid-template-columns:minmax(0,0.95fr) minmax(420px,1.05fr);gap:44px;align-items:center}.eyebrow{display:inline-flex;margin-bottom:14px;color:var(--orange);font-family:Montserrat,Inter,sans-serif;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.eyebrow.light{color:#ffb36f}.hero h1,.section h2,.final-cta h2{font-family:Montserrat,Inter,sans-serif;color:var(--navy);letter-spacing:-.04em}.hero h1{margin:0;font-size:clamp(38px,5vw,58px);line-height:.96;font-weight:700;max-width:760px}.lead{font-size:20px;line-height:1.55;color:#3d4656;margin:22px 0 0;max-width:650px}.chips{display:flex;flex-wrap:wrap;gap:10px;margin:24px 0}.chips span{border:1px solid var(--line);background:#fff;border-radius:999px;padding:10px 13px;font-size:13px;font-weight:700;color:#293241}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.button{display:inline-flex;align-items:center;justify-content:center;border-radius:14px;min-height:50px;padding:0 22px;text-decoration:none;font-weight:800;font-family:Montserrat,Inter,sans-serif}.primary{background:var(--orange);color:#fff;box-shadow:0 16px 30px rgba(255,122,26,.24)}.ghost{background:#fff;color:var(--navy);border:1px solid var(--line)}.ghost.dark{background:#fff;color:var(--navy)}.hero-product{position:relative}.product-shell{border:1px solid rgba(11,31,58,.1);background:rgba(255,255,255,.9);border-radius:34px;padding:18px;box-shadow:0 34px 90px rgba(11,31,58,.14)}.product-topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:16px;color:var(--navy)}.product-topbar span{font-size:12px;font-weight:800;color:#118154;background:#e8f8ef;border-radius:999px;padding:8px 12px}.product-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:center}.input-panel,.output-panel{background:#f8fafc;border:1px solid var(--line);border-radius:24px;padding:14px}.job-photo,.gmb-photo{height:180px;border-radius:20px;background:linear-gradient(140deg,#cbd5e1,#f8fafc 48%,#f97316 49%,#0b1f3a);position:relative;overflow:hidden}.job-photo span{position:absolute;left:12px;bottom:12px;background:rgba(255,255,255,.92);border-radius:999px;padding:7px 10px;font-size:12px;font-weight:800}.voice-wave{display:flex;gap:4px;align-items:center;margin:14px 0}.voice-wave i{display:block;width:8px;height:22px;border-radius:999px;background:var(--orange)}.voice-wave i:nth-child(2n){height:34px}.voice-wave i:nth-child(3n){height:16px}.input-panel small{color:var(--muted);line-height:1.45}.product-arrow{font-size:30px;color:var(--orange);font-weight:900}.caption-lines{display:grid;gap:8px;margin-bottom:14px}.caption-lines i{display:block;height:9px;border-radius:999px;background:#cbd5e1}.caption-lines i:nth-child(2){width:82%}.caption-lines i:nth-child(3){width:66%}.caption-lines .orange{width:48%;background:var(--orange)}.mini-post{height:116px;border-radius:18px;background:linear-gradient(135deg,#fff,#f0f4f8);border:1px solid var(--line);display:grid;place-content:center;text-align:center;gap:7px;color:var(--navy);font-weight:800}.mini-post span{font-size:12px;color:var(--muted)}.logo-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.logo-row img,.hub-logo img,.gmb-header img{width:26px;height:26px;object-fit:contain}.logo-row.compact img{background:#fff;border:1px solid var(--line);border-radius:10px;padding:5px;box-sizing:content-box}.intro-strip{padding:62px 0;background:#fff}.intro-strip h2{font-size:clamp(30px,4vw,48px);line-height:1.04;margin:0 auto 14px}.intro-strip p,.section-head p,.section-copy p,.final-cta p{color:var(--muted);font-size:18px;line-height:1.6}.section-head{text-align:center;max-width:820px;margin:0 auto 34px}.section-head h2,.section-copy h2{font-size:clamp(30px,4vw,46px);line-height:1.08;margin:0 0 14px}.wide-flow{display:grid;grid-template-columns:1fr 90px 1fr 90px 1fr;gap:14px;align-items:center}.flow-node{border:1px solid var(--line);border-radius:26px;padding:24px;background:#fff;min-height:150px;display:flex;flex-direction:column;gap:10px;box-shadow:0 18px 48px rgba(11,31,58,.08)}.flow-node b{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:var(--orange);color:#fff}.flow-node strong{font-family:Montserrat,Inter,sans-serif;color:var(--navy);font-size:20px}.flow-node span{color:var(--muted)}.wide-flow svg{width:90px}.wide-flow path{stroke:var(--orange);stroke-width:4;fill:none;stroke-linecap:round;stroke-linejoin:round}.navy{background:var(--navy);color:#fff}.navy h2,.results h2{color:#fff}.navy p,.results .section-head p{color:#d7dee9}.networks-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:44px;align-items:center}.network-hub{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;position:relative}.hub-center{grid-column:1/-1;justify-self:center;background:var(--orange);color:#fff;border-radius:999px;padding:14px 22px;font-weight:900;font-family:Montserrat,Inter,sans-serif}.hub-logo{background:#fff;border-radius:18px;padding:15px 12px;display:flex;align-items:center;gap:10px;color:var(--navy);font-weight:800}.split{display:grid;grid-template-columns:.85fr 1.15fr;gap:44px;align-items:center}.gmb-card{border:1px solid var(--line);border-radius:32px;background:#fff;padding:18px;box-shadow:0 22px 70px rgba(11,31,58,.12)}.gmb-header{display:flex;align-items:center;gap:10px;margin-bottom:14px}.gmb-header span{margin-left:auto;font-size:12px;font-weight:800;color:#118154;background:#e8f8ef;border-radius:999px;padding:7px 10px}.gmb-photo{height:210px}.gmb-post,.gmb-review{margin-top:12px;border:1px solid var(--line);border-radius:18px;padding:14px;background:#f8fafc}.gmb-post{display:grid;gap:5px}.gmb-post span,.gmb-review{color:var(--muted)}.soft{background:var(--soft)}.timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.timeline article{background:#fff;border:1px solid var(--line);border-radius:24px;padding:20px;display:grid;gap:10px;box-shadow:0 15px 35px rgba(11,31,58,.06)}.timeline b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--orange);color:#fff}.timeline strong{font-family:Montserrat,Inter,sans-serif;color:var(--navy)}.timeline span{color:var(--muted);line-height:1.45}.results{background:linear-gradient(145deg,var(--navy),#122f56);color:#fff}.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.stat-strip article{border:1px solid rgba(255,255,255,.18);border-radius:24px;background:rgba(255,255,255,.08);padding:24px;text-align:center}.stat-strip strong{display:block;font-family:Montserrat,Inter,sans-serif;font-size:40px;line-height:1;color:#fff}.stat-strip span{display:block;margin-top:10px;color:#d7dee9}.caution{text-align:center;color:#d7dee9;margin:22px auto 0;max-width:820px}.pricing-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;align-items:stretch}.price-card{border:1px solid var(--line);border-radius:30px;padding:28px;background:#fff;box-shadow:0 20px 60px rgba(11,31,58,.08)}.price-card.pro{border:2px solid var(--orange);box-shadow:0 30px 80px rgba(255,122,26,.16)}.plan{display:inline-flex;border-radius:999px;background:#eef2f7;color:var(--navy);font-weight:900;padding:8px 12px}.price-card h3{font-family:Montserrat,Inter,sans-serif;color:var(--navy);font-size:23px;line-height:1.15}.price{font-family:Montserrat,Inter,sans-serif;font-size:38px;font-weight:900;color:var(--navy);margin:16px 0}.price small{font-size:14px;color:var(--muted)}.price-card ul{display:grid;gap:10px;margin:0 0 24px;padding:0;list-style:none;color:#334155}.price-card li::before{content:'✓';color:var(--orange);font-weight:900;margin-right:8px}.faq{background:#fff}.faq details{border:1px solid var(--line);border-radius:18px;padding:0 18px;margin:10px 0;background:#fff}.faq summary{cursor:pointer;font-family:Montserrat,Inter,sans-serif;font-weight:800;color:var(--navy);padding:18px 0}.faq p{color:var(--muted);line-height:1.55;margin:0 0 18px}.final-cta{padding:84px 0;background:linear-gradient(180deg,#fff,#f8fafc)}.final-cta h2{font-size:clamp(34px,5vw,52px);line-height:1.04;margin:0 0 14px}
  @media (max-width: 920px){.hero{padding-top:50px}.hero-grid,.networks-grid,.split,.pricing-grid{grid-template-columns:1fr}.hero h1{font-size:clamp(36px,10vw,48px)}.lead{font-size:18px}.product-grid{grid-template-columns:1fr}.product-arrow{transform:rotate(90deg);text-align:center}.wide-flow{grid-template-columns:1fr}.wide-flow svg{width:80px;transform:rotate(90deg);justify-self:center}.network-hub{grid-template-columns:1fr 1fr}.timeline,.stat-strip{grid-template-columns:1fr 1fr}.section{padding:66px 0}}
  @media (max-width: 520px){.container,.narrow{width:min(100% - 24px,1120px)}.hero{padding:38px 0 54px}.hero h1{font-size:35px;line-height:1.02}.chips span{font-size:12px}.actions{display:grid}.button{width:100%}.product-shell{border-radius:24px;padding:12px}.job-photo{height:145px}.section-head h2,.section-copy h2{font-size:29px}.timeline,.stat-strip,.network-hub{grid-template-columns:1fr}.stat-strip strong{font-size:34px}.price{font-size:34px}}
</style>
