---
const { proof } = Astro.props;
---

<section class="v13-proof" id={proof.id} aria-label="Résultats observés">
  <div class="v13-container">
    <div class="v13-proof__grid">
      {proof.metrics.map((metric: any) => (
        <article class="v13-proof-card">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </article>
      ))}
    </div>
    <p>{proof.note}</p>
  </div>
</section>
