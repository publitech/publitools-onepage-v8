---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  quality?: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'sync' | 'async' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  widths = [480, 768, 1200],
  sizes = '(max-width: 768px) 100vw, 1200px',
  quality = 78,
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  class: className,
} = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const assetKey = src.startsWith('/assets/')
  ? `/src/assets/${src.slice('/assets/'.length)}`
  : src.startsWith('../../assets/')
    ? `/src/assets/${src.slice('../../assets/'.length)}`
    : src;
const image = imageModules[assetKey]?.default;

if (!image) {
  throw new Error(`Image locale non trouvée dans src/assets : ${src}`);
}
---
<Image
  src={image}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={quality}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding={decoding}
  class={className}
/>
