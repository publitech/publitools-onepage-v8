---
type Props = {
  src?: string;
  alt: string;
  label?: string;
  loading?: 'eager' | 'lazy';
  ratio?: 'square' | 'wide' | 'phone' | 'dashboard';
  missing?: boolean;
};

const { src, alt, label, loading = 'lazy', ratio = 'wide', missing = !src } = Astro.props;
const ratioClass = {
  square: 'aspect-square',
  wide: 'aspect-[16/10]',
  phone: 'aspect-[9/16]',
  dashboard: 'aspect-[4/3]',
}[ratio];
---

<figure class="overflow-hidden rounded-[28px] border border-[#E8EDF3] bg-white shadow-soft" data-v11-asset-frame>
  <div class:list={['relative grid place-items-center overflow-hidden bg-[#F4F6F8]', ratioClass]}>
    {missing ? (
      <div class="max-w-xs px-6 text-center">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF7A1A]">Asset Léa attendu</p>
        {label && <p class="mt-3 text-lg font-bold text-[#0B1F3A]">{label}</p>}
      </div>
    ) : (
      <img src={src} alt={alt} loading={loading} decoding="async" class="h-full w-full object-cover" />
    )}
  </div>
  {label && <figcaption class="px-5 py-3 text-sm font-semibold text-[#536174]">{label}</figcaption>}
</figure>
