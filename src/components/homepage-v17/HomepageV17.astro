---
const { content } = Astro.props;
const ctaHref = content.signupUrl || content.hero.primaryCta.href;
const networks = ['Google', 'Instagram', 'LinkedIn', 'Facebook', 'TikTok', 'YouTube'];
const socialNetworks = [
  { name: 'Google', logo: '/social/google-official.svg' },
  { name: 'Instagram', logo: '/social/instagram-official.svg' },
  { name: 'LinkedIn', logo: '/social/linkedin-official.svg' },
  { name: 'Facebook', logo: '/social/facebook-official.svg' },
  { name: 'TikTok', logo: '/social/tiktok-official.svg' },
  { name: 'YouTube', logo: '/social/youtube-official.svg' },
];
const socialLogoByName: Record<string, string> = {
  Google: '/social/google-official.svg',
  'Google Business': '/social/google-official.svg',
  Instagram: '/social/instagram-official.svg',
  LinkedIn: '/social/linkedin-official.svg',
  Facebook: '/social/facebook-official.svg',
  TikTok: '/social/tiktok-official.svg',
  YouTube: '/social/youtube-official.svg',
};
const reviewCards = ['Travail propre', 'Équipe sérieuse', 'Délais tenus', 'Très pro', 'Je recommande'];
---

<main class="homepage-v17">
  <section class="v17-hero" id="top">
    <div class="v17-container v17-hero__grid">
      <div class="v17-hero__copy v17-reveal">
        <p class="v17-badge">{content.hero.eyebrow}</p>
        <h1>{content.hero.h1}</h1>
        <div class="v17-available-row v20-logo-row" aria-label="Disponible pour Google, Instagram, LinkedIn, Facebook, TikTok et YouTube">
          <span>{content.hero.subheadline}</span>
          {socialNetworks.map((n) => <b title={n.name}><img src={n.logo} alt={n.name} loading="eager" /><span>{n.name}</span></b>)}
        </div>
        <div class="v17-hero__actions">
          <a class="v17-btn v17-btn--primary" href={content.hero.primaryCta.href}>{content.hero.primaryCta.label}</a>
          <a class="v17-btn v17-btn--ghost" href={content.hero.secondaryCta.href}>{content.hero.secondaryCta.label}</a>
          <span class="v17-cta-note">14 jours d’essai — accès complet Pro</span>
        </div>
        <div class="v17-proof-faces" aria-hidden="true">
          {Array.from({length: 10}).map((_, i) => <span style={`--i:${i}`}></span>)}
        </div>
        <p class="v17-social-proof"><span></span>{content.hero.socialProof}</p>
      </div>

      <div class="v17-product-card v20-hero-visual v17-reveal" role="img" aria-label={content.hero.placeholder}>
        <img class="v20-hero-asset" src="/homepage/fr/v20/lea-gpt-image-2-premium-system/hero-chantier-contenu-validation-diffusion.png" alt="Artisan BTP utilisant PubliTools pour transformer ses chantiers en contenus validés" loading="eager" />
        <div class="v20-hero-glass v20-hero-glass--logo">
          <img src="/brand/publitools-logo.jpg" alt="PubliTools" />
          <span>Validation humaine</span>
        </div>
        <div class="v20-hero-social-stack" aria-label="Destinations de publication PubliTools">
          {socialNetworks.map((n) => <span><img src={n.logo} alt={n.name} loading="eager" /></span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="v17-section v17-section--soft" id={content.engine.id}>
    <div class="v17-container">
      <header class="v17-head v17-reveal"><h2>{content.engine.h2}</h2></header>
      <div class="v17-engine-grid">
        {content.engine.cards.map((card: any, i: number) => (
          <article class="v17-engine-card v17-reveal" style={`--delay:${i * 0.06}s`}>
            <img class="v17-card-image" src={card.image} alt={card.title} loading="lazy" />
            <h3>{card.title}</h3><p>{card.body}</p><em>{card.badge}</em>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v17-section" id={content.contentMachine.id}>
    <div class="v17-container">
      <header class="v17-head v17-reveal"><h2>{content.contentMachine.h2}</h2></header>
      <div class="v17-machine-layout v20-machine-layout">
        <div class="v20-machine-visual-wrap">
          <img class="v17-machine-image v20-machine-image" src={content.contentMachine.heroImage} alt="Machine de visibilité PubliTools : photo, vidéo, vocal et avis vers publications multicanales" loading="lazy" />
          <div class="v20-machine-logo"><img src="/brand/publitools-logo.jpg" alt="PubliTools" /></div>
          <div class="v20-machine-socials">{socialNetworks.map((n) => <span><img src={n.logo} alt={n.name} loading="lazy" /></span>)}</div>
        </div>
        <div class="v17-machine-cards">
          {content.contentMachine.cards.map((card: any, i: number) => (
            <article class="v17-machine-card v17-reveal" style={`--delay:${i * 0.06}s`}>
              <small>{card.raw}</small><strong>{card.tag}</strong><p>{card.result}</p>
            </article>
          ))}
          <a class="v17-btn v17-btn--primary" href={content.contentMachine.cta.href}>{content.contentMachine.cta.label}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="v17-section v17-section--soft" id={content.process.id}>
    <div class="v17-container">
      <header class="v17-head v17-reveal"><h2>{content.process.h2}</h2><p>{content.process.sub}</p></header>
      <div class="v17-process-track">
        {content.process.steps.map((step: any) => <article class="v17-process-step v17-reveal"><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}
      </div>
      {content.process.image && <img class="v17-process-image v17-reveal" src={content.process.image} alt="Validation humaine PubliTools avant publication" loading="eager" />}
      <p class="v17-validation-note">Rien ne part sans votre validation.</p>
    </div>
  </section>

  <section class="v17-section v21-google-section" id={content.localProof.id}>
    <div class="v17-container">
      <header class="v17-head v17-reveal"><h2>{content.localProof.h2}</h2>{content.localProof.sub && <p>{content.localProof.sub}</p>}</header>
      <div class="v21-google-grid">
        {content.localProof.cards.map((card: any, i: number) => (
          <article class="v21-google-card v17-reveal" style={`--delay:${i * 0.06}s`}>
            <img src={card.image} alt={card.title} loading="lazy" />
            <div>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="v17-center"><a class="v17-btn v17-btn--primary" href={content.localProof.cta.href}>{content.localProof.cta.label}</a></div>
    </div>
  </section>

  <section class="v17-section v17-section--dark" id={content.destinations.id}>
    <div class="v17-container">
      <header class="v17-head v17-head--dark v17-reveal"><h2>{content.destinations.h2}</h2><p>{content.destinations.sub}</p></header>
      <div class="v17-hub">
        <div class="v17-hub-center"><strong>PubliTools</strong><span>1 validation</span></div>
        {content.destinations.items.map((item: any, i: number) => <article class="v17-destination-card v17-reveal" style={`--delay:${i * 0.06}s`}><img src={socialLogoByName[item.name]} alt={item.name} loading="lazy" /><b>{item.name}</b><p>{item.body}</p></article>)}
      </div>
      <div class="v17-center"><a class="v17-btn v17-btn--primary" href={content.destinations.cta.href}>{content.destinations.cta.label}</a></div>
    </div>
  </section>

  <section class="v17-proof-strip" id={content.proof.id}>
    <div class="v17-container">
      <header><h2>{content.proof.h2}</h2><p>{content.proof.sub}</p></header>
      <div>{content.proof.stats.map((stat: any) => <article><strong>{stat.value}</strong><span>{stat.label}</span></article>)}</div>
    </div>
  </section>

  <section class="v17-section" id={content.pricing.id}>
    <div class="v17-container">
      <header class="v17-head v17-reveal"><p class="v17-badge">{content.pricing.eyebrow}</p><h2>{content.pricing.title}</h2><p>{content.pricing.description}</p></header>
      <div class="v17-pricing-grid">
        {content.pricing.plans.map((plan: any) => <article class:list={['v17-plan', plan.featured && 'is-featured', 'v17-reveal']}>
          {plan.featuredLabel && <span class="v17-plan-badge">{plan.featuredLabel}</span>}
          <div class="v17-pricing-visual">
            <div class="v17-calendar">{Array.from({length: plan.featured ? 12 : 8}).map((_, i) => <span style={`--delay:${i * .04}s`}></span>)}</div>
            <div class="v17-plan-networks">{networks.map((n) => <b>{n.slice(0,2)}</b>)}</div>
          </div>
          <h3>{plan.name}</h3><p class="v17-plan-subtitle">{plan.subtitle}</p><p class="v17-price"><strong>{plan.price}</strong></p>
          <ul>{plan.features.map((item: string) => <li>{item}</li>)}</ul>
          <a class:list={['v17-btn', plan.featured ? 'v17-btn--primary' : 'v17-btn--outline']} href={plan.href}>{plan.ctaLabel}</a>
        </article>)}
      </div>
      <p class="v17-pricing-note">{content.pricing.description}</p>
    </div>
  </section>

  <section class="v17-section v17-section--soft" id={content.faq.id}>
    <div class="v17-container v17-container--narrow">
      <header class="v17-head"><h2>{content.faq.title}</h2></header>
      <div class="v17-faq">{content.faq.items.map((item: any) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
    </div>
  </section>

  <section class="v17-final" style={content.final_cta.backgroundImage ? `--final-bg:url('${content.final_cta.backgroundImage}')` : undefined}>
    <div class="v17-container"><h2>{content.final_cta.heading}</h2><p>{content.final_cta.sub}</p><a class="v17-btn v17-btn--primary" href={content.final_cta.cta_primary.href || ctaHref}>{content.final_cta.cta_primary.label}</a></div>
  </section>
</main>

<script>
  const items = document.querySelectorAll('.v17-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('is-visible'); });
  }, { threshold: 0.12 });
  items.forEach((item) => observer.observe(item));
</script>

<style is:global>
.homepage-v17{--navy:#262832;--orange:#f4862d;--orange-hover:#e5751c;--white:#fff;--soft:#f7f7f5;--line:#e7e8ea;--muted:#5d6370;--dark:#1f222b;background:#fff;color:var(--navy);font-family:Montserrat,system-ui,sans-serif;overflow-x:hidden}.homepage-v17 *{box-sizing:border-box}.homepage-v17 h1,.homepage-v17 h2,.homepage-v17 h3,.homepage-v17 h4,.homepage-v17 a,.homepage-v17 button{font-family:Montserrat,system-ui,sans-serif}.v17-container{width:min(100% - 32px,1200px);margin-inline:auto}.v17-container--narrow{width:min(100% - 32px,760px)}.v17-hero{padding:20px 0 28px;background:#fff}.v17-hero__grid{display:grid;grid-template-columns:minmax(0,.96fr) minmax(420px,1.04fr);gap:clamp(28px,4vw,54px);align-items:center}.v17-badge{display:inline-flex;margin:0 0 10px;padding:5px 12px;border-radius:999px;background:var(--soft);color:var(--muted);font-size:12px;font-weight:550}.homepage-v17 h1{max-width:650px;margin:0;color:var(--navy);font-size:clamp(34px,3.6vw,48px);font-weight:600;line-height:1.12;letter-spacing:-.025em}.v17-lead{max-width:610px;margin:13px 0 0;color:var(--muted);font-size:clamp(15px,1.25vw,17px);line-height:1.48}.v17-hero__actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:20px}.v17-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;border-radius:10px;padding:12px 20px;font-size:15px;font-weight:650;text-decoration:none;transition:transform .16s ease,background .16s ease,box-shadow .16s ease}.v17-btn:hover{transform:translateY(-1px)}.v17-btn--primary{background:var(--orange);color:#fff;box-shadow:0 10px 26px rgba(244,134,45,.22)}.v17-btn--primary:hover{background:var(--orange-hover)}.v17-btn--outline,.v17-btn--ghost{border:1px solid var(--orange);color:var(--orange);background:#fff}.v17-btn--ghost{border-color:var(--line);color:var(--navy)}.v17-cta-note,.v17-social-proof{color:var(--muted);font-size:13px}.v17-social-proof{display:inline-flex;align-items:center;gap:8px;margin:11px 0 0;font-weight:550}.v17-social-proof span{width:8px;height:8px;border-radius:50%;background:#23b26b}.v17-product-card{border:1px solid var(--line);border-radius:24px;background:linear-gradient(180deg,#fff,#fbfbfa);box-shadow:0 30px 90px rgba(38,40,50,.13);padding:14px;max-height:calc(100vh - 130px);min-height:410px}.v17-product-card__top{height:26px;display:flex;align-items:center;gap:6px;color:var(--muted);font-size:12px}.v17-product-card__top span{width:8px;height:8px;border-radius:50%;background:#d7d9de}.v17-product-card__top b{margin-left:auto}.v17-product-card__body{display:grid;grid-template-columns:.88fr 1fr;gap:14px}.v17-photo-panel{min-height:250px;border-radius:18px;background:radial-gradient(circle at 28% 18%,#ffcf9d,transparent 28%),linear-gradient(145deg,#242832,#475160);color:#fff;padding:18px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden}.v17-photo-panel small,.v17-flow-panel span{opacity:.8;font-size:12px}.v17-photo-panel strong{font-size:23px;line-height:1.1}.v17-photo-panel em{font-style:normal;margin-top:8px;color:#ffd5b4}.v17-flow-panel{display:grid;gap:10px}.v17-flow-panel>div{border:1px solid var(--line);border-radius:16px;padding:13px;background:#fff}.v17-flow-panel p{margin:5px 0 0;color:var(--navy);font-size:13px;line-height:1.35}.v17-validation{background:#fff8f3!important}.v17-validation button{margin-top:8px;border:0;border-radius:10px;background:var(--orange);color:#fff;padding:8px 12px;font-weight:650}.v17-destination-row{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;margin-top:12px}.v17-destination-row span{border:1px solid var(--line);border-radius:999px;padding:7px 4px;text-align:center;font-size:11px;font-weight:650;color:var(--muted);background:#fff}.v17-section{padding:62px 0}.v17-section--soft{background:var(--soft)}.v17-section--dark{background:var(--dark);color:#fff}.v17-head{text-align:center;max-width:850px;margin:0 auto 30px}.v17-head h2{margin:0;color:inherit;font-size:clamp(28px,3vw,42px);font-weight:650;line-height:1.13;letter-spacing:-.025em}.v17-head p{margin:12px auto 0;max-width:760px;color:var(--muted);font-size:16px;line-height:1.55}.v17-head--dark p{color:rgba(255,255,255,.72)}.v17-engine-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.v17-engine-card{border:1px solid var(--line);border-radius:24px;background:#fff;padding:18px;box-shadow:0 24px 70px rgba(38,40,50,.08)}.v17-engine-card h3{margin:18px 0 7px;font-size:24px}.v17-engine-card p{margin:0;color:var(--muted);line-height:1.45}.v17-engine-card em{display:inline-flex;margin-top:14px;border-radius:999px;background:#fff2e8;color:var(--orange);padding:7px 10px;font-size:12px;font-style:normal;font-weight:700}.v17-mini-visual{height:190px;border-radius:20px;background:linear-gradient(140deg,#fff,#f4f5f6);position:relative;overflow:hidden;border:1px solid #eceef0}.v17-mini-phone{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:120px;height:128px;border-radius:18px;background:#262832;color:#fff;padding:16px;text-align:center;display:flex;flex-direction:column;justify-content:center;gap:8px;box-shadow:0 18px 35px rgba(38,40,50,.25)}.v17-mini-phone span{color:#ffcf9d;font-size:12px}.v17-orbit-logo{position:absolute;border-radius:999px;background:#fff;border:1px solid #e7e8ea;color:#262832;padding:7px 9px;font-size:11px;font-weight:750;box-shadow:0 12px 26px rgba(38,40,50,.1);animation:v17-pop-in .5s ease both,var(--floatName,v17-float) 4.5s ease-in-out infinite;animation-delay:var(--delay)}.v17-orbit-logo:nth-child(2){left:16px;top:28px}.v17-orbit-logo:nth-child(3){right:18px;top:24px}.v17-orbit-logo:nth-child(4){left:20px;bottom:24px}.v17-orbit-logo:nth-child(5){right:12px;bottom:34px}.v17-orbit-logo:nth-child(6){left:50%;top:12px}.v17-orbit-logo:nth-child(7){left:44%;bottom:14px}.v17-credible-demo{display:grid;grid-template-columns:1fr 84px 1fr;align-items:center;gap:10px;padding:14px}.v17-raw-note,.v17-clean-post{border-radius:16px;background:#fff;border:1px solid #e7e8