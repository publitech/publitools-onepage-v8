---
import '../styles/global.css';
import V31Footer from '../components/v31/V31Footer.astro';
import { dict, localeConfig, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  schema?: Record<string, unknown>[];
  footerNetworkText?: string;
  footer?: boolean;
  locale?: Locale;
  pathname?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
}

const SITE_URL = 'https://publitools.ai';

const {
  title,
  description,
  canonical,
  image = `${SITE_URL}/og-cover.png`,
  schema = [],
  footerNetworkText,
  footer = true,
  locale = 'fr',
  alternates = [],
} = Astro.props;

const cfg = localeConfig[locale];

// Canonical normalisée : URL absolue + trailing slash (toutes les routes Astro sont des dossiers).
const rawCanonical = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;
const parsedCanonical = new URL(rawCanonical);
const hasFileExtension = /\.[a-z0-9]+$/i.test(parsedCanonical.pathname);
const canonicalUrl =
  hasFileExtension || rawCanonical.endsWith('/') ? rawCanonical : `${rawCanonical}/`;

// Version des favicons : incrémenter à chaque changement pour forcer
// le navigateur à invalider son cache (sinon Chrome/Safari gardent l'ancien).
const FAVICON_VERSION = '2';
const fav = (path: string) => `${path}?v=${FAVICON_VERSION}`;
---

<!doctype html>
<html lang={cfg.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B1F3A" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href={fav('/logo-icon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={fav('/favicon-512.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={fav('/favicon-512.png')} />
    <link rel="shortcut icon" href={fav('/favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={fav('/favicon-180.png')} />
    <link rel="manifest" href={fav('/site.webmanifest')} />

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={cfg.ogLocale} />
    <meta property="og:site_name" content={cfg.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {schema.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <a href="#page-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-slate-900">
      {dict[locale].common.skip}
    </a>
    <div id="page-content">
      <slot />
    </div>
    {footer && <V31Footer networkText={footerNetworkText} locale={locale} />}
  </body>
</html>