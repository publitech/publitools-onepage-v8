{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "FR"
        }
      ],
      "destination": "/fr/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "ES"
        }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "DE"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/fr/tarif",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/tarif/",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/faq",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/faq/",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/contact",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/contact/",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/:path*",
      "destination": "/fr/",
      "permanent": true
    }
  ]
}