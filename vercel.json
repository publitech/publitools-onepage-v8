{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/fr/",
      "permanent": false
    },
    {
      "source": "/fr/tarif",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/tarif/",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/faq",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/faq/",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/contact",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/contact/",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/reseaux-sociaux",
      "destination": "/fr/fonctionnalites/automatisation-reseaux-sociaux/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/reseaux-sociaux/:path*",
      "destination": "/fr/fonctionnalites/automatisation-reseaux-sociaux/:path*",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/avis",
      "destination": "/fr/fonctionnalites/obtenir-plus-d-avis/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/avis/sollicitation-avis-sms",
      "destination": "/fr/fonctionnalites/obtenir-plus-d-avis/demande-avis-sms/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/avis/valorisation-des-avis",
      "destination": "/fr/fonctionnalites/obtenir-plus-d-avis/publication-avis-reseaux-sociaux/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/google-my-business",
      "destination": "/fr/fonctionnalites/booster-google-business/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/google-my-business/google-post-assiste",
      "destination": "/fr/fonctionnalites/booster-google-business/creation-posts-google/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/google-my-business/publication-photo-automatique",
      "destination": "/fr/fonctionnalites/booster-google-business/publication-photo-automatique/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/reseaux-sociaux/publication-multicanale",
      "destination": "/fr/fonctionnalites/automatisation-reseaux-sociaux/publication-multi-reseaux/",
      "permanent": true
    },
    {
      "source": "/fr/fonctionnalites/reseaux-sociaux/programmation-editoriale",
      "destination": "/fr/fonctionnalites/automatisation-reseaux-sociaux/programmation-publications/",
      "permanent": true
    }
  ]
}